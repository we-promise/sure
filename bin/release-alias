#!/usr/bin/env bash
# Never force or move an existing compatibility tag. Safe to retry after failure.
set -euo pipefail
alias_version="${1:?compatibility version required}"
[[ "$alias_version" =~ ^0\.[0-9]+\.[0-9]+$ ]] || exit 1
alias_tag="v${alias_version}"
expected_sha="$(git rev-parse HEAD)"

verify_existing() {
  git fetch --no-tags origin "refs/tags/${alias_tag}"
  actual_sha="$(git rev-parse 'FETCH_HEAD^{commit}')"
  if [[ "$actual_sha" != "$expected_sha" ]]; then
    echo "Compatibility tag ${alias_tag} points to another commit; refusing to move it." >&2
    exit 1
  fi
}

if git ls-remote --exit-code origin "refs/tags/${alias_tag}" >/dev/null; then
  verify_existing
else
  status=$?
  [[ "$status" == 2 ]] || exit "$status"
  if ! git push origin "HEAD:refs/tags/${alias_tag}"; then
    # Another attempt may have created the tag concurrently.
    verify_existing
  fi
fi
