<!-- Merged by Tauri into the app bundle's Info.plist. -->
<plist version="1.0">
<dict>
  <!-- macOS asks for Local Network access before the app can reach a
       self-hosted server on a LAN address; without this key it is refused. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Sure connects to your self-hosted Sure server on your local network.</string>
</dict>
</plist>
