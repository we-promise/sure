        "required": [
          "kind",
          "balance"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "balance_upsert"
            ]
          },
          "balance": {
            "$ref": "#/components/schemas/FinancekitBalanceEvent"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "transaction"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "transaction_upsert"
            ]
          },
          "transaction": {
            "$ref": "#/components/schemas/FinancekitTransactionEvent"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "tombstone"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "transaction_tombstone"
            ]
          },
          "tombstone": {
            "$ref": "#/components/schemas/FinancekitTombstoneEvent"
          }
        }
      }
    ]
  },
  "FinancekitBatch": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "protocol_version",
      "connection_id",
      "publisher_id",
      "generation",
      "stream_id",
      "batch_id",
      "sequence",
      "capture_id",
      "chunk_index",
      "chunk_count",
      "capture_mode",
      "snapshot_complete",
      "captured_at",
      "selected_source_account_ids",
      "events"
    ],
    "properties": {
      "protocol_version": {
        "type": "integer",
        "enum": [
          2
        ]
      },
      "connection_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "publisher_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "generation": {
        "type": "integer",
        "minimum": 1
      },
      "stream_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "batch_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "sequence": {
        "type": "integer",
        "minimum": 1
      },
      "predecessor_digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "capture_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "chunk_index": {
        "type": "integer",
        "minimum": 0
      },
      "chunk_count": {
        "type": "integer",
        "minimum": 1
      },
      "capture_mode": {
        "type": "string",
        "enum": [
          "snapshot",
          "delta"
        ]
      },
      "snapshot_complete": {
        "type": "boolean"
      },
      "captured_at": {
        "type": "string",
        "format": "date-time"
      },
      "selected_source_account_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
        }
      },
      "events": {
        "type": "array",
        "maxItems": 500,
        "items": {
          "$ref": "#/components/schemas/FinancekitEvent"
        }
      }
    },
    "description": "Immutable ordered publisher batch. sequence 1 omits predecessor_digest; later batches carry the SHA-256 digest of the preceding payload. Omission never deletes data."
  },
  "FinancekitBatchReceipt": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "connection_id",
      "publisher_id",
      "generation",
      "stream_id",
      "batch_id",
      "sequence",
      "payload_digest",
      "status",
      "accepted_at"
    ],
    "properties": {
      "connection_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "publisher_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "generation": {
        "type": "integer"
      },
      "stream_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "batch_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "sequence": {
        "type": "integer"
      },
      "payload_digest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "status": {
        "type": "string",
        "enum": [
          "accepted"
        ]
      },
      "accepted_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "FinancekitConflict": {
    "type": "object",
    "required": [
      "id",
      "kind",
      "status",
      "details",
      "created_at"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "kind": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "resolved"
        ]
      },
      "details": {
        "type": "object"
      },
      "resolution": {
        "type": "string",
        "nullable": true
      },
      "resolved_at": {
        "allOf": [
          {
            "type": "string",
            "format": "date-time"
          }
        ],
        "nullable": true
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "financekit_account_lineage_id": {
        "allOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
          }
        ],
        "nullable": true
      },
      "financekit_transaction_id": {
        "allOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
          }
        ],
        "nullable": true
      }
    }
  },
  "FinancekitConflictResolution": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "resolution"
    ],
    "properties": {
      "resolution": {
        "type": "string",
        "description": "`keep_sure` closes the conflict without mutating the publisher stream. `retry_after_repair` closes the conflict, moves the connection to repair_required, revokes queued work and credentials, and requires POST /repair before uploads resume.",
        "enum": [
          "keep_sure",
          "retry_after_repair"
        ]
      }
    }
  },
