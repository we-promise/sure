{
  "FinancekitMoney": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "amount",
      "currency",
      "direction"
    ],
    "properties": {
      "amount": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,4})?$"
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3,5}$"
      },
      "direction": {
        "type": "string",
        "enum": [
          "credit",
          "debit"
        ]
      }
    }
  },
  "FinancekitConsent": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "granted_at",
      "selected_source_account_ids",
      "upload_authorized",
      "family_visibility_acknowledged",
      "remote_processing_acknowledged"
    ],
    "properties": {
      "version": {
        "type": "integer",
        "enum": [
          1
        ]
      },
      "granted_at": {
        "type": "string",
        "format": "date-time"
      },
      "selected_source_account_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
        }
      },
      "upload_authorized": {
        "type": "boolean",
        "enum": [
          true
        ]
      },
      "family_visibility_acknowledged": {
        "type": "boolean",
        "enum": [
          true
        ]
      },
      "remote_processing_acknowledged": {
        "type": "boolean",
        "enum": [
          true
        ]
      }
    }
  },
  "FinancekitEnrollment": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "protocol_version",
      "enrollment_id",
      "consent"
    ],
    "properties": {
      "protocol_version": {
        "type": "integer",
        "enum": [
          2
        ]
      },
      "enrollment_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "replaces_connection_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "consent": {
        "$ref": "#/components/schemas/FinancekitConsent"
      }
    }
  },
  "FinancekitMappingRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "expected_version",
      "action",
      "name",
      "institution_name",
      "currency",
      "accountable_type",
      "subtype",
      "ledger_timezone"
    ],
    "properties": {
      "expected_version": {
        "type": "integer",
        "minimum": 0
      },
      "action": {
        "type": "string",
        "enum": [
          "create",
          "link"
        ]
      },
      "name": {
        "type": "string",
        "maxLength": 255
      },
      "institution_name": {
        "type": "string",
        "maxLength": 255
      },
      "currency": {
        "type": "string"
      },
      "accountable_type": {
        "type": "string",
        "enum": [
          "Depository",
          "CreditCard"
        ]
      },
      "subtype": {
        "type": "string"
      },
      "ledger_timezone": {
        "type": "string"
      },
      "account_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "lineage_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "booked_balance": {
        "$ref": "#/components/schemas/FinancekitMoney"
      },
      "observed_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "description": "create requires booked_balance and observed_at; link requires a writable same-family account_id and may carry a prior lineage_id"
  },
  "FinancekitAccountMapping": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_id",
      "lineage_id",
      "mapping_version",
      "name",
      "institution_name",
      "currency",
      "accountable_type",
      "subtype",
      "ledger_timezone",
      "account_id"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "lineage_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "mapping_version": {
        "type": "integer",
        "minimum": 1
      },
      "name": {
        "type": "string"
      },
      "institution_name": {
        "type": "string",
        "nullable": true
      },
      "currency": {
        "type": "string"
      },
      "accountable_type": {
        "type": "string"
      },
      "subtype": {
        "type": "string"
      },
      "ledger_timezone": {
        "type": "string"
      },
      "account_id": {
        "allOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
          }
        ],
        "nullable": true
      }
    }
  },
  "FinancekitAccountBinding": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_account_id",
      "lineage_id",
      "mapping_version"
    ],
    "properties": {
      "source_account_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "lineage_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "mapping_version": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "FinancekitConnection": {
    "type": "object",
    "required": [
      "id",
      "connection_id",
      "publisher_id",
      "status",
      "generation",
      "next_sequence",
      "open_conflicts"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "connection_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "publisher_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending_mapping",
          "active",
          "repair_required",
          "revoked"
        ]
      },
      "generation": {
        "type": "integer",
        "minimum": 1
      },
      "stream_id": {
        "allOf": [
          {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
          }
        ],
        "nullable": true
      },
      "next_sequence": {
        "type": "integer",
        "minimum": 1
      },
      "repair_reason": {
        "type": "string",
        "nullable": true
      },
      "last_device_contact_at": {
        "allOf": [
          {
            "type": "string",
            "format": "date-time"
          }
        ],
        "nullable": true
      },
      "last_accepted_at": {
        "allOf": [
          {
            "type": "string",
            "format": "date-time"
          }
        ],
        "nullable": true
      },
      "last_imported_at": {
        "allOf": [
          {
            "type": "string",
            "format": "date-time"
          }
        ],
        "nullable": true
      },
      "last_downstream_at": {
        "allOf": [
          {
            "type": "string",
            "format": "date-time"
          }
        ],
        "nullable": true
      },
      "last_captured_at": {
        "allOf": [
          {
            "type": "string",
            "format": "date-time"
          }
        ],
        "nullable": true
      },
      "open_conflicts": {
        "type": "integer",
        "minimum": 0
      },
      "accounts": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/FinancekitAccountMapping"
        }
      },
      "pagination": {
        "$ref": "#/components/schemas/Pagination"
      }
    }
  },
  "FinancekitPublisherConfiguration": {
    "allOf": [
      {
        "$ref": "#/components/schemas/FinancekitConnection"
      },
      {
        "type": "object",
        "required": [
          "protocol_version",
          "server_url",
          "upload_url",
          "consent",
          "account_bindings",
          "max_records_per_batch",
          "max_bytes_per_batch",
          "publisher_credential"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "enum": [
              2
            ]
          },
          "server_url": {
            "type": "string",
            "format": "uri"
          },
          "upload_url": {
            "type": "string",
            "format": "uri"
          },
          "consent": {
            "$ref": "#/components/schemas/FinancekitConsent"
          },
          "account_bindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FinancekitAccountBinding"
            }
          },
          "max_records_per_batch": {
            "type": "integer",
            "minimum": 1
          },
          "max_bytes_per_batch": {
            "type": "integer",
            "minimum": 1
          },
          "publisher_credential": {
            "type": "string",
            "writeOnly": true
          }
        }
      }
    ]
  },
  "FinancekitAccountEvent": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_id",
      "lineage_id",
      "mapping_version",
      "display_name",
      "institution_name",
      "currency",
      "kind"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "lineage_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "mapping_version": {
        "type": "integer",
        "minimum": 1
      },
      "display_name": {
        "type": "string",
        "maxLength": 255
      },
      "institution_name": {
        "type": "string",
        "maxLength": 255
      },
      "currency": {
        "type": "string"
      },
      "kind": {
        "type": "string",
        "enum": [
          "asset",
          "liability"
        ]
      },
      "account_description": {
        "type": "string",
        "maxLength": 1000
      },
      "opening_date": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "FinancekitBalanceEvent": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_id",
      "source_account_id",
      "lineage_id",
      "mapping_version",
      "kind",
      "observed_at",
      "money"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "source_account_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "lineage_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "mapping_version": {
        "type": "integer",
        "minimum": 1
      },
      "kind": {
        "type": "string",
        "enum": [
          "available",
          "booked"
        ]
      },
      "observed_at": {
        "type": "string",
        "format": "date-time"
      },
      "money": {
        "$ref": "#/components/schemas/FinancekitMoney"
      }
    }
  },
  "FinancekitTransactionEvent": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_id",
      "source_account_id",
      "lineage_id",
      "mapping_version",
      "amount",
      "transaction_description",
      "original_transaction_description",
      "transaction_type",
      "status",
      "transacted_at"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "source_account_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "lineage_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "mapping_version": {
        "type": "integer",
        "minimum": 1
      },
      "amount": {
        "$ref": "#/components/schemas/FinancekitMoney"
      },
      "foreign_amount": {
        "$ref": "#/components/schemas/FinancekitMoney"
      },
      "foreign_exchange_rate": {
        "type": "string"
      },
      "transaction_description": {
        "type": "string",
        "maxLength": 1000
      },
      "original_transaction_description": {
        "type": "string",
        "maxLength": 1000
      },
      "transaction_type": {
        "type": "string",
        "maxLength": 100
      },
      "status": {
        "type": "string",
        "enum": [
          "authorized",
          "pending",
          "booked",
          "rejected",
          "memo",
              "unknown"
        ]
      },
      "transacted_at": {
        "type": "string",
        "format": "date-time"
      },
      "posted_at": {
        "type": "string",
        "format": "date-time"
      },
      "merchant_name": {
        "type": "string",
        "maxLength": 255
      },
      "merchant_category_code": {
        "type": "integer",
        "minimum": -32768,
        "maximum": 32767
      }
    }
  },
  "FinancekitTombstoneEvent": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_id",
      "source_account_id",
      "lineage_id",
      "mapping_version"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "source_account_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
      },
      "lineage_id": {
        "type": "string",
        "format": "uuid",
