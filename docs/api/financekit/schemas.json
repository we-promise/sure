      },
      "mapping_version": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "FinancekitEvent": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "account"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "account_upsert"
            ]
          },
          "account": {
            "$ref": "#/components/schemas/FinancekitAccountEvent"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "source_account_id",
          "lineage_id",
          "mapping_version"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "account_unavailable"
            ]
          },
          "source_account_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
          },
          "lineage_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
