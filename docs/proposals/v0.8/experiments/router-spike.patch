diff --git a/test/rfc_experiments/ai_paths_agreement_test.rb b/test/rfc_experiments/ai_paths_agreement_test.rb
new file mode 100644
index 000000000..1cb3d5aa1
--- /dev/null
+++ b/test/rfc_experiments/ai_paths_agreement_test.rb
@@ -0,0 +1,171 @@
+require "test_helper"
+
+# Throwaway experiment for the v0.8 AI RFC. Not for merge.
+#
+# E2: ask every place that decides "which AI applies here?" the same question
+#     under one configuration, and report where the answers disagree. The
+#     Enhance button is measured end to end, by rendering the Merchants page.
+class RfcAiPathsAgreementTest < ActionDispatch::IntegrationTest
+  include BillsHelper
+  include InsightsHelper
+
+  SETUPS = {
+    "C1" => [ "nothing configured", {} ],
+    "C2" => [ "OpenAI key", { "OPENAI_ACCESS_TOKEN" => "sk-test" } ],
+    "C3" => [ "Anthropic key only, LLM_PROVIDER unset", { "ANTHROPIC_API_KEY" => "sk-ant-test" } ],
+    "C4" => [ "Anthropic key only, LLM_PROVIDER=anthropic", { "ANTHROPIC_API_KEY" => "sk-ant-test", "LLM_PROVIDER" => "anthropic" } ],
+    "C5" => [ "OpenAI-compatible URL + model (Ollama)", { "OPENAI_ACCESS_TOKEN" => "ollama", "OPENAI_URI_BASE" => "http://ollama:11434/v1", "OPENAI_MODEL" => "qwen3:8b" } ],
+    "C6" => [ "OpenAI-compatible URL, model left blank", { "OPENAI_ACCESS_TOKEN" => "ollama", "OPENAI_URI_BASE" => "http://ollama:11434/v1" } ],
+    "C7" => [ "both keys, LLM_PROVIDER=anthropic", { "OPENAI_ACCESS_TOKEN" => "sk-test", "ANTHROPIC_API_KEY" => "sk-ant-test", "LLM_PROVIDER" => "anthropic" } ],
+    "C8" => [ "OpenAI key, OPENAI_MODEL=o4-mini", { "OPENAI_ACCESS_TOKEN" => "sk-test", "OPENAI_MODEL" => "o4-mini" } ],
+    "C9" => [ "Jev only (CATEGORIZATION_PROVIDER=jev)", { "JEV_API_KEY" => "jev-test", "CATEGORIZATION_PROVIDER" => "jev" } ]
+  }.freeze
+
+  # Cleared in every setup so the host's environment can't leak in.
+  CONTROLLED = %w[
+    OPENAI_ACCESS_TOKEN OPENAI_URI_BASE OPENAI_MODEL ANTHROPIC_ACCESS_TOKEN ANTHROPIC_API_KEY
+    ANTHROPIC_BASE_URL ANTHROPIC_MODEL LLM_PROVIDER JEV_API_KEY JEV_ENDPOINT JEV_MODEL
+    CATEGORIZATION_PROVIDER VECTOR_STORE_PROVIDER ASSISTANT_TYPE EMBEDDING_URI_BASE EMBEDDING_ACCESS_TOKEN
+  ].freeze
+
+  PATHS = [
+    [ "batch / PDF / bills provider", "`Provider::Registry.preferred_llm_provider`" ],
+    [ "categorization provider", "`Family#resolved_categorization_provider`" ],
+    [ "chat model stamped on a message", "`Chat.default_model`" ],
+    [ "chat provider for that model", "`Assistant::Provided#get_model_provider`" ],
+    [ "chat entry point shown", "`User#ai_available?`" ],
+    [ "bill smart-fill shown", "`bills_one_shot_ai_available?`" ],
+    [ "\"Dig in with AI\" shown", "`insight_dig_in_available?`" ],
+    [ "AI categorize rule action offered", "`TransactionResource#offered?`" ],
+    [ "AI merchant rule action offered", "`TransactionResource#offered?`" ],
+    [ "Enhance merchants button rendered", "GET `/family_merchants`" ],
+    [ "vector store adapter", "`VectorStore::Registry.adapter_name`" ]
+  ].freeze
+
+  setup do
+    sign_in @user = users(:family_admin)
+    @family = @user.family
+
+    # The Enhance button needs a provider merchant without a website.
+    merchant = ProviderMerchant.create!(name: "RFC Experiment Shop", source: "plaid")
+    transactions(:one).update_columns(merchant_id: merchant.id)
+  end
+
+  test "E2 every path answers the same setup" do
+    results = SETUPS.transform_values do |(_label, env)|
+      with_self_hosting do
+        with_env_overrides(CONTROLLED.index_with { nil }.merge(env)) { answers }
+      end
+    end
+
+    lines = []
+    lines << "| Question | Code | #{SETUPS.keys.join(" | ")} |"
+    lines << "|---|---|#{"---|" * SETUPS.size}"
+    PATHS.each_with_index do |(question, code), i|
+      lines << "| #{question} | #{code} | #{results.values.map { |r| r[:cells][i] }.join(" | ")} |"
+    end
+    lines << ""
+    SETUPS.each { |id, (label, env)| lines << "- **#{id}** #{label}: `#{env.map { |k, v| "#{k}=#{v}" }.join(" ").presence || "(none)"}`" }
+    lines << ""
+    lines << "Disagreements:"
+    results.each { |id, r| r[:disagreements].each { |d| lines << "- #{id}: #{d}" } }
+    lines << "- none" if results.values.all? { |r| r[:disagreements].empty? }
+
+    report("e2-agreement.md", lines)
+    assert_equal SETUPS.size, results.size
+  end
+
+  private
+    def answers
+      Current.session = @user.sessions.order(:created_at).last
+
+      preferred = Provider::Registry.preferred_llm_provider
+      model = Chat.default_model
+      chat_provider = Class.new { include Assistant::Provided }.new.get_model_provider(model)
+      offered = Rule::Registry::TransactionResource.new(@family.rules.build(resource_type: "transaction")).action_executors.map(&:key)
+      chat_shown = @user.ai_available?
+
+      cells = [
+        short(preferred),
+        short(@family.resolved_categorization_provider),
+        "`#{model}`",
+        short(chat_provider),
+        yes(chat_shown),
+        yes(bills_one_shot_ai_available?),
+        yes(insight_dig_in_available?(Insight.new(family: @family))),
+        yes(offered.include?("auto_categorize")),
+        yes(offered.include?("auto_detect_merchants"))
+      ]
+
+      get family_merchants_path
+      assert_response :success
+      enhance_button = response.body.include?(enhance_family_merchants_path)
+      cells << yes(enhance_button)
+      cells << (VectorStore::Registry.adapter_name&.to_s || "–")
+
+      disagreements = []
+      if chat_shown && chat_provider.nil?
+        disagreements << "chat entry point is shown, but no provider supports `#{model}`, so every chat turn fails"
+      end
+      if enhance_button != preferred.present?
+        disagreements << "Enhance button #{enhance_button ? "rendered" : "not rendered"}, but the enhancer job would use #{short(preferred)}"
+      end
+
+      { cells: cells, disagreements: disagreements }
+    end
+
+    def short(provider)
+      provider ? provider.class.name.demodulize : "–"
+    end
+
+    def yes(value)
+      value ? "yes" : "no"
+    end
+
+    def report(name, lines)
+      text = lines.join("\n")
+      puts "\n#{text}\n"
+      File.write(File.join(ENV.fetch("RFC_OUT", Dir.tmpdir), name), text + "\n")
+    end
+end
+
+# E3: compare Provider::LlmConcept's declared signatures with the providers.
+class RfcLlmConceptDriftTest < ActiveSupport::TestCase
+  test "E3 LlmConcept signatures vs implementations" do
+    methods = %i[auto_categorize auto_detect_merchants enhance_provider_merchants suggest_bill_setup
+                 supports_pdf_processing? process_pdf extract_bank_statement chat_response]
+    impls = { "OpenAI" => Provider::Openai, "Anthropic" => Provider::Anthropic, "Jev" => Provider::Jev }
+
+    lines = [ "| Method | `LlmConcept` declares | #{impls.keys.join(" | ")} |", "|---|---|#{"---|" * impls.size}" ]
+    methods.each do |m|
+      declared = Provider::LlmConcept.instance_methods(false).include?(m) ? signature(Provider::LlmConcept.instance_method(m)) : "**not declared**"
+      cells = impls.values.map do |klass|
+        next "–" unless klass.method_defined?(m)
+        signature(klass.instance_method(m))
+      end
+      lines << "| `#{m}` | #{declared} | #{cells.join(" | ")} |"
+    end
+    lines << ""
+    lines << "Concepts included by Jev: #{Provider::Jev.ancestors.select { |a| a.name.to_s.match?(/\AProvider::\w+Concept\z/) }.map(&:name).join(", ")}"
+
+    text = lines.join("\n")
+    puts "\n#{text}\n"
+    File.write(File.join(ENV.fetch("RFC_OUT", Dir.tmpdir), "e3-concept-drift.md"), text + "\n")
+    assert_not Provider::LlmConcept.instance_methods(false).include?(:extract_bank_statement)
+  end
+
+  private
+    def signature(method)
+      method.parameters.map do |kind, name|
+        case kind
+        when :req then name.to_s
+        when :opt then "#{name}="
+        when :keyreq then "#{name}:"
+        when :key then "#{name}: opt"
+        when :rest then "*#{name}"
+        when :keyrest then "**#{name}"
+        when :block then "&#{name}"
+        end
+      end.join(", ").then { |s| s.empty? ? "()" : "`#{s}`" }
+    end
+end
