diff --git a/app/models/ai/router.rb b/app/models/ai/router.rb
new file mode 100644
index 000000000..3e7a211b8
--- /dev/null
+++ b/app/models/ai/router.rb
@@ -0,0 +1,54 @@
+# Answers "which provider and model serve this AI task?" in one place, so every
+# entry point that shows or hides an AI feature asks the same question.
+#
+# This first step only delegates to the existing resolution code (the registry's
+# provider order, the family's categorization provider, the chat model check).
+# Callers move over one at a time; per-task settings can come later.
+class Ai::Router
+  Route = Data.define(:provider, :model)
+  Unavailable = Data.define(:reason)
+
+  TASKS = %i[chat categorize detect_merchants enhance_merchants extract_pdf bill_setup].freeze
+
+  class << self
+    def for(task, family: nil)
+      raise ArgumentError, "Unknown AI task: #{task}" unless TASKS.include?(task)
+
+      case task
+      when :chat then chat_route
+      when :categorize then categorization_route(family)
+      else llm_route
+      end
+    end
+
+    def available?(task, family: nil)
+      self.for(task, family: family).is_a?(Route)
+    end
+
+    private
+      # The model stamped on a new message must be one some provider accepts,
+      # otherwise the chat is offered and every turn fails.
+      def chat_route
+        model = Chat.default_model
+        provider = Provider::Registry.llm_provider_order.lazy
+          .filter_map { |name| Provider::Registry.get_provider(name) }
+          .find { |candidate| candidate.supports_model?(model) }
+
+        provider ? Route.new(provider: provider, model: model) : Unavailable.new(reason: :no_provider_for_model)
+      end
+
+      def categorization_route(family)
+        provider = family.resolved_categorization_provider
+        provider ? Route.new(provider: provider, model: family.categorization_model_name) : Unavailable.new(reason: :no_provider)
+      end
+
+      # The model is looked up only when a caller reads it, so availability
+      # checks never depend on model configuration.
+      def llm_route
+        provider = Provider::Registry.preferred_llm_provider
+        return Unavailable.new(reason: :no_provider) unless provider
+
+        Route.new(provider: provider, model: -> { provider.class.effective_model })
+      end
+  end
+end
