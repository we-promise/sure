<%% content_for :title, t("<%= file_name %>_items.setup_accounts.title") %>

<%%= render ProviderItem::AccountSetupComponent.new(
      item: @<%= file_name %>_item,
      provider_accounts: @<%= file_name %>_accounts,
      api_error: @api_error,
      account_type_options: @account_type_options,
      displayable_account_type_options: @displayable_account_type_options,
      subtype_options: @subtype_options,
      defaults: <%= file_name %>_account_setup_defaults(@<%= file_name %>_accounts)
    ) %>
