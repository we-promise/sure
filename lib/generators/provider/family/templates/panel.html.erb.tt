<%%= render ProviderItem::PanelComponent.new(
      items: local_assigns[:<%= file_name %>_items] || @<%= file_name %>_items || Current.family.<%= file_name %>_items.active.ordered,
      new_item: Current.family.<%= file_name %>_items.build(name: t("<%= file_name %>_items.default_connection_name")),
      error_message: local_assigns[:error_message] || @error_message
    ) do |panel| %>
  <%% panel.with_setup_steps do %>
    <%%= render "settings/providers/setup_steps",
               steps: [
                 t("<%= file_name %>_items.provider_panel.instructions.step_1"),
                 t("<%= file_name %>_items.provider_panel.instructions.step_2"),
                 t("<%= file_name %>_items.provider_panel.instructions.step_3")
               ] %>
  <%% end %>
<%% end %>
