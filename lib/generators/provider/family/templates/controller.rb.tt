# frozen_string_literal: true

# <%= class_name %>'s connections, served by ProviderItemsController through the
# provider_items route concern: managing them, linking their accounts and setting
# those accounts up.
class <%= class_name %>ItemsController < ProviderItemsController
  private

    def item_params
      permitted = params.require(:<%= file_name %>_item).permit(:name, :sync_start_date<% parsed_fields.each do |field| %>, :<%= field[:name] %><% end %>)
<% parsed_fields.select { |field| field[:secret] }.each do |field| -%>
      # A blank secret on an edit keeps the stored one.
      permitted.delete(:<%= field[:name] %>) if @<%= file_name %>_item&.persisted? && permitted[:<%= field[:name] %>].blank?
<% end -%>
      permitted
    end
end
