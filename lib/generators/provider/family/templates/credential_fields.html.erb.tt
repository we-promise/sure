<%%# locals: (form:, item:, editing:) %>
<% parsed_fields.each_with_index do |field, index| -%>
<% scope = "#{file_name}_items.provider_panel.fields.#{field[:name]}" -%>
<%= "\n" if index.positive? -%>
<% if field[:secret] -%>
<%%= form.text_field :<%= field[:name] %>,
                    label: t("<%= scope %>.label"),
                    placeholder: t(editing ? "<%= scope %>.placeholder_update" : "<%= scope %>.placeholder_new"),
                    type: :password,
                    value: nil %>
<% elsif field[:type] == "boolean" -%>
<div class="flex items-center justify-between gap-2">
  <%%= form.label :<%= field[:name] %>, t("<%= scope %>.label"), class: "text-sm text-primary" %>
  <%%= form.toggle :<%= field[:name] %> %>
</div>
<% else -%>
<%%= form.<%= field[:type] == "integer" ? "number_field" : "text_field" %> :<%= field[:name] %>,
                    label: t("<%= scope %>.label"),
                    placeholder: <%= field[:default] ? %("#{field[:default]}") : %(t("#{scope}.placeholder_new")) %> %>
<% end -%>
<% end -%>
