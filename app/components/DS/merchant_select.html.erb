<div class="relative"
     data-controller="merchant-select"
     data-merchant-select-create-url-value="<%= helpers.family_merchants_path(format: :json) %>"
     data-merchant-select-create-dialog-url-value="<%= helpers.new_family_merchant_path(entry_id: entry_id) if avatar_variant? && entry_id.present? %>"
     data-merchant-select-field-name-value="<%= field_name %>"
     data-merchant-select-disabled-value="<%= disabled %>"
     data-merchant-select-auto-submit-value="<%= auto_submit %>"
     data-merchant-select-menu-placement-value="<%= menu_placement %>"
     data-merchant-select-fixed-menu-value="<%= avatar_variant? %>"
     data-merchant-select-avatar-value="<%= avatar_variant? %>"
     data-merchant-select-options-url-value="<%= options_url %>"
     data-merchant-select-error-message-value="<%= helpers.t("transactions.form.create_merchant_error") %>"
     data-action="keydown->merchant-select#handleKeydown">
  <% unless avatar_variant? %>
    <div class="form-field">
      <div class="form-field__body">
        <%= form.label method, label, class: "form-field__label" if label.present? %>
  <% end %>

  <button type="button"
              class="<%= avatar_variant? ? "#{avatar_size_classes} flex items-center justify-center rounded-full p-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary" : "form-field__input w-full flex items-center gap-2" %> <%= "cursor-not-allowed text-subdued" if disabled %>"
              data-merchant-select-target="button"
              data-action="click->merchant-select#toggle"
              title="<%= avatar_title %>"
              aria-label="<%= avatar_title %>"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="<%= menu_id %>"
              <%= "disabled" if disabled %>>
        <span data-merchant-select-target="selectionContainer" title="<%= avatar_variant? ? avatar_title : nil %>" class="flex items-center <%= "justify-center" if avatar_variant? %> gap-2 truncate">
          <% if selected_merchant %>
            <% if selected_merchant_logo_url %>
              <%= image_tag selected_merchant_logo_url, class: "#{avatar_variant? ? avatar_size_classes : "w-5 h-5"} rounded-full border border-secondary shrink-0", loading: "lazy" %>
            <% else %>
              <%= render DS::FilledIcon.new(variant: :text, text: selected_merchant.name, size: avatar_variant? ? size : "sm", rounded: true, description: selected_merchant.name) %>
            <% end %>
            <% unless avatar_variant? %><span class="truncate"><%= selected_merchant.name %></span><% end %>
          <% else %>
            <% if avatar_variant? %>
              <%= render DS::FilledIcon.new(variant: :text, text: fallback_text.presence || include_blank, size: size, rounded: true, description: include_blank) %>
            <% else %>
              <span class="text-secondary"><%= include_blank %></span>
            <% end %>
          <% end %>
        </span>
  </button>
  <% unless avatar_variant? %>
      </div>
    </div>
  <% end %>

  <input type="hidden"
         name="<%= field_name %>"
         value="<%= selected_id %>"
         data-merchant-select-target="hiddenInput"
         <%= "disabled" if disabled %>>

  <% unless disabled %>
    <div class="<%= avatar_variant? ? "fixed min-w-64 max-w-[calc(100vw-1rem)]" : "absolute w-full min-w-32" %> z-50 p-1.5 rounded-lg shadow-lg shadow-border-xs bg-container mt-1.5 transition duration-150 ease-out -translate-y-1 opacity-0 hidden"
         data-merchant-select-target="menu">
      <div class="flex items-center bg-container border border-secondary rounded-lg mb-1 focus-ring-within transition-shadow">
        <%= render DS::SearchInput.new(
              variant: :embedded,
              class: "flex-1 min-w-0",
              placeholder: helpers.t("transactions.form.merchant_search_placeholder"),
              data: {
                merchant_select_target: "search",
                action: "input->merchant-select#filter keydown->merchant-select#handleSearchKeydown"
              }
            ) %>
      </div>

      <div class="flex flex-col gap-0.5 max-h-64 overflow-auto"
           id="<%= menu_id %>"
           role="listbox"
           tabindex="-1"
           data-merchant-select-target="listbox">
        <% if avatar_variant? %>
          <p class="px-3 py-2 text-sm text-secondary" data-merchant-select-target="loading"><%= helpers.t("transactions.form.merchant_search_placeholder") %></p>
        <% end %>

        <% unless avatar_variant? %>
          <%= render partial: "DS/merchant_select/options",
                     locals: { merchants: merchants, selected_id: selected_id, include_blank: include_blank, view_helpers: helpers, avatar: false, fallback_text: nil } %>
        <% end %>
      </div>

      <button type="button"
              class="hidden text-primary text-sm cursor-pointer items-center gap-2 px-3 py-1.5 rounded-lg hover:bg-container-inset-hover"
              data-merchant-select-target="createForm"
              data-action="click->merchant-select#<%= avatar_variant? ? "openCreateDialog" : "createMerchant" %>">
        <%= helpers.icon("plus") %>
        <span><%= helpers.t("transactions.form.create_merchant") %> "<span data-merchant-select-create-name></span>"</span>
      </button>
      <p class="hidden px-3 py-1 text-xs text-destructive"
         data-merchant-select-target="createError"
         aria-live="assertive"
         aria-atomic="true"></p>
    </div>
  <% end %>
</div>
