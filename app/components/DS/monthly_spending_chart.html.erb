<div class="flex gap-3" data-controller="DS--monthly-spending-chart">
  <div class="hidden sm:flex flex-col justify-between h-56 text-xs text-secondary tabular-nums privacy-sensitive" aria-hidden="true">
    <span><%= money(max_total) %></span>
    <span><%= money(max_total / 2) %></span>
    <span><%= money(0) %></span>
  </div>
  <div class="min-w-0 flex-1 overflow-x-auto focus-ring" role="region" tabindex="0" aria-label="<%= t("pages.dashboard.monthly_spending.chart_label") %>" data-DS--monthly-spending-chart-target="scroller">
    <div class="flex gap-3 min-w-full">
      <% data[:months].each do |month| %>
        <button type="button" class="min-w-16 flex-1 rounded-lg focus-ring cursor-pointer text-primary" data-DS--monthly-spending-chart-target="bar" data-month="<%= month[:month] %>" data-action="DS--monthly-spending-chart#select" aria-pressed="false" aria-label="<%= accessible_label(month) %>">
          <span class="flex h-56 flex-col justify-end border-b border-primary privacy-sensitive" aria-hidden="true">
            <% month[:categories].reverse_each do |segment| %>
              <%= tag.span class: "block w-full shrink-0", style: "height: #{percentage(segment[:amount])}%; background-color: #{categories.fetch(segment[:id])[:color]}" %>
            <% end %>
          </span>
          <span class="block text-xs text-secondary pt-2 whitespace-nowrap"><%= month_label(month) %><%= " *" if month[:partial] %></span>
        </button>
      <% end %>
    </div>
  </div>
</div>
