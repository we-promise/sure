<%= tag.div **opts do %>
  <p class="text-xs text-secondary"><%= label %></p>
  <% if value? %>
    <%= value %>
  <% else %>
    <%= tag.p plain_value, class: value_classes, **value_attributes %>
  <% end %>
  <% if hint.present? %>
    <p class="<%= hint_classes %>"><%= hint %></p>
  <% end %>
<% end %>
