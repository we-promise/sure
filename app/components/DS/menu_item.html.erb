<% if variant == :divider %>
  <div role="separator">
    <%= render "shared/ruler", classes: "my-1" %>
  </div>
<% else %>
  <div class="px-1" role="none">
    <%= wrapper do %>
      <% if selectable? %>
        <span class="flex items-center justify-center w-5 h-5 shrink-0" aria-hidden="true">
          <% if render_check? %>
            <%= tag.span(helpers.icon("check", color: destructive? ? :destructive : :default), data: { menu_item_check: true }, style: ("display:none" unless selected)) %>
          <% end %>
        </span>
      <% end %>
      <% if icon %>
        <%= helpers.icon(icon, color: destructive? ? :destructive : :default) %>
      <% end %>
      <% if description.present? %>
        <span class="flex flex-col items-start text-left min-w-0">
          <%= tag.span(text, class: text_classes) %>
          <%= tag.span(description, class: "text-xs text-secondary") %>
        </span>
      <% else %>
        <%= tag.span(text, class: text_classes) %>
      <% end %>
    <% end %>
  </div>
<% end %>
