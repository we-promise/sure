<%= turbo_frame_tag dom_id(account, "entries") do %>
  <div class="bg-container px-3 py-4 lg:p-4 shadow-border-xs rounded-xl" data-controller="checkbox-toggle">
    <div class="flex items-center justify-between mb-4" data-testid="activity-menu">
      <%= tag.h2 t("accounts.show.activity.title"), class: "font-medium text-lg" %>

      <%# Show menu if: manual (can add balance) OR non-crypto (can add transactions) %>
      <%# This hides the menu only for linked crypto accounts who have no actions %>
      <% if !account.linked? || !account.crypto? %>
        <%= render DS::Menu.new(variant: "button") do |menu| %>
          <% menu.with_button(text: t("accounts.show.activity.new"), variant: "secondary", icon: "plus") %>

          <% unless account.linked? %>
            <% menu.with_item(
                variant: "link",
                text: t("accounts.show.activity.new_balance"),
                icon: "circle-dollar-sign",
                href: new_valuation_path(account_id: account.id),
                data: { turbo_frame: :modal }) %>
          <% end %>

          <% unless account.crypto? %>
            <% if account.investment? %>
              <% menu.with_item(
                  variant: "link",
                  text: t("accounts.show.activity.new_activity"),
                  icon: "arrow-left-right",
                  href: new_trade_path(account_id: account.id),
                  data: { turbo_frame: :modal }) %>
            <% else %>
              <% menu.with_item(
                  variant: "link",
                  text: t("accounts.show.activity.new_transaction"),
                  icon: "credit-card",
                  href: new_transaction_path(account_id: account.id),
                  data: { turbo_frame: :modal }) %>
            <% end %>
          <% end %>

          <% menu.with_item(
              variant: "link",
              text: t("accounts.show.activity.new_transfer"),
              icon: "arrow-right-left",
              href: new_transfer_path(from_account_id: account.id),
              data: { turbo_frame: :modal }) %>
        <% end %>
      <% end %>
    </div>

    <div>
      <%= form_with url: account_path(account),
              id: "entries-search",
              scope: :q,
              method: :get,
              data: { controller: "auto-submit-form", turbo_frame: dom_id(account, "entries") } do |form| %>
        <div class="flex gap-2 mb-4">
          <div class="grow">
            <div class="flex items-center px-3 py-2 gap-2 border border-secondary rounded-lg focus-within:border-primary">
              <%= helpers.icon("search") %>

              <%= hidden_field_tag :account_id, account.id %>
              <%= hidden_field_tag :per_page, params[:per_page].presence || pagy.limit %>

              <%= form.search_field :search,
                            placeholder: t("accounts.show.activity.search.placeholder"),
                            value: search,
                            class: "form-field__input placeholder:text-sm placeholder:text-secondary",
                            "data-auto-submit-form-target": "auto" %>
              <%= hidden_field_tag :tab, "activity" %>
            </div>
          </div>

          <%= render DS::Popover.new(variant: "button", no_padding: true) do |popover| %>
            <% popover.with_button(
              id: "activity-status-filter-button",
              type: "button",
              text: t("accounts.show.activity.filter"),
              variant: "outline",
              icon: "list-filter"
            ) %>

            <% popover.with_custom_content do %>
              <%= render DS::Tabs.new(
                variant: :unstyled,
                active_tab: helpers.transaction_search_filters.reject { |f| f[:key] == "account_filter" }.first[:key],
                active_btn_classes: "bg-surface text-primary",
                inactive_btn_classes: "text-secondary hover:bg-container-inset"
              ) do |tabs| %>
                <div class="flex flex-col md:flex-row h-[50vh] lg:max-h-auto z-10 md:h-80 w-full md:w-[540px] top-12 right-0 overflow-hidden">
                  <%= tabs.with_nav(classes: "shrink-0 flex w-full md:w-44 flex-row md:flex-col items-start p-3 text-sm font-medium text-secondary border-b md:border-b-0 md:border-r border-secondary overflow-x-auto md:overflow-x-visible") do |nav| %>
                    <% helpers.transaction_search_filters.reject { |f| f[:key] == "account_filter" }.each do |filter| %>
                      <%= nav.with_btn(id: filter[:key], label: filter[:label], classes: "w-full px-3 py-2 flex gap-2 items-center rounded-md") do %>
                        <%= helpers.icon(filter[:icon]) %>
                        <%= tag.span(filter[:label], class: "text-sm font-medium") %>
                      <% end %>
                    <% end %>
                  <% end %>

                  <div class="flex flex-col grow overflow-y-auto">
                    <div class="grow p-3 border-b border-secondary overflow-y-auto">
                      <% helpers.transaction_search_filters.reject { |f| f[:key] == "account_filter" }.each do |filter| %>
                        <%= tabs.with_panel(tab_id: filter[:key]) do %>
                          <%= render partial: helpers.get_transaction_search_filter_partial_path(filter), locals: { form: form } %>
                        <% end %>
                      <% end %>
                    </div>

                    <div class="flex justify-between items-center gap-2 bg-container p-3 shrink-0">
                      <div>
                        <% if filtered? %>
                          <%= render DS::Link.new(
                            text: t("transactions.search.menu.clear_filters"),
                            variant: "ghost",
                            href: helpers.account_path(account, tab: "activity"),
                          ) %>
                        <% end %>
                      </div>

                      <div class="flex gap-2">
                        <%= render DS::Button.new(text: t("transactions.search.menu.cancel"), type: "button", variant: "ghost", data: { action: "DS--popover#close" }) %>
                        <%= render DS::Button.new(text: t("transactions.search.menu.apply"), type: :submit) %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
      <% end %>
      <%= button_tag type: "button",
            id: "toggle-checkboxes-button",
            aria: { label: t(".toggle_selection_checkboxes") },
            class: "lg:hidden font-medium whitespace-nowrap inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm text-primary border border-secondary hover:bg-surface-hover",
            data: {
              action: "click->checkbox-toggle#toggle",
              checkbox_toggle_target: "toggleButton"
            } do %>
            <%= helpers.icon("list-todo") %>
        <% end %>
      </div>
    </div>

    <% if activity_dates.empty? %>
      <%= tag.p t("accounts.show.activity.no_entries"), class: "text-secondary text-sm p-4" %>
    <% else %>
      <%= tag.div id: dom_id(account, "entries_bulk_select"),
                data: {
                  controller: "bulk-select",
                  bulk_select_singular_label_value: "entry",
                  bulk_select_plural_label_value: "entries"
                } do %>
        <div id="entry-selection-bar" data-bulk-select-target="selectionBar" class="flex justify-center hidden">
          <%= render "entries/selection_bar" %>
        </div>

        <% if compact? %>
          <% if !group_by_date %>
            <div class="bg-container-inset rounded-xl px-2 py-2 text-xs uppercase font-medium text-secondary items-center mb-2 flex gap-2 lg:gap-3">
              <div class="hidden lg:flex w-8 shrink-0 justify-center">
                <%= check_box_tag "selection_entry",
                                  class: "checkbox checkbox--light",
                                  data: {
                                    action: "bulk-select#togglePageSelection",
                                    checkbox_toggle_target: "selectionEntry"
                                  } %>
              </div>
              <p class="hidden lg:block w-[110px] shrink-0"><%= t("transactions.show.date_label") %></p>
              <p class="flex-[2] min-w-0"><%= t("transactions.list.transaction") %></p>
              <p class="hidden lg:block flex-[2] min-w-0"><%= t("transactions.show.notes") %></p>
              <p class="hidden md:block flex-[1] min-w-0"><%= t("transactions.form.category_label") %></p>
              <p class="w-[120px] shrink-0 text-right"><%= t("transactions.show.amount") %></p>
              <% unless filtered? %>
                <p class="hidden lg:block w-[120px] shrink-0 text-right"><%= t("accounts.show.activity.balance") %></p>
              <% end %>
            </div>
          <% else %>
            <div class="bg-container-inset rounded-xl px-2 py-2 text-xs uppercase font-medium text-secondary items-center mb-2 flex gap-2 lg:gap-3">
              <div class="hidden lg:flex w-8 shrink-0 justify-center">
                <%= check_box_tag "selection_entry",
                                  class: "checkbox checkbox--light",
                                  data: {
                                    action: "bulk-select#togglePageSelection",
                                    checkbox_toggle_target: "selectionEntry"
                                  } %>
              </div>
              <p class="flex-[2] min-w-0"><%= t("transactions.list.transaction") %></p>
              <p class="hidden lg:block flex-[2] min-w-0"><%= t("transactions.show.notes") %></p>
              <p class="hidden md:block flex-[1] min-w-0"><%= t("transactions.form.category_label") %></p>
              <p class="w-[120px] shrink-0 text-right"><%= t("transactions.show.amount") %></p>
            </div>
          <% end %>
        <% else %>
          <div class="grid bg-container-inset rounded-xl grid-cols-12 items-center uppercase text-xs font-medium text-secondary px-5 py-3 mb-4">
            <div class="pl-0.5 col-span-8 flex items-center gap-4">
              <%= check_box_tag "selection_entry",
                                class: "checkbox checkbox--light hidden lg:block",
                                data: {
                                  action: "bulk-select#togglePageSelection",
                                  checkbox_toggle_target: "selectionEntry"
                                } %>
              <%= tag.p t("accounts.show.activity.date") %>
            </div>

            <%= tag.p t("accounts.show.activity.amount"), class: "col-span-4 justify-self-end" %>
          </div>
        <% end %>

        <div>
          <% if compact? && !group_by_date %>
            <div class="bg-container-inset rounded-xl p-1">
              <div class="bg-container shadow-border-xs rounded-lg">
                <% flat_entries = activity_dates.flat_map(&:entries) %>
                <% if Current.user.show_split_grouped? %>
                  <% helpers.group_split_entries(flat_entries, feed_data.split_parents).each do |item| %>
                    <% if item.is_a?(EntriesHelper::SplitGroup) %>
                      <div class="split-group">
                        <%= render "transactions/split_parent_row", entry: item.parent, view_ctx: "account", is_filtered: filtered? %>
                        <% item.children.each do |child_entry| %>
                          <% if child_entry.entryable_type == "Transaction" %>
                            <%= render "transactions/compact_transaction", entry: child_entry, view_ctx: "account", in_split_group: true, running_balance: running_balances[child_entry.id], hide_balance: filtered?, is_filtered: filtered? %>
                          <% elsif child_entry.entryable_type == "Trade" %>
                            <%= render "trades/compact_trade", entry: child_entry, view_ctx: "account", in_split_group: false, running_balance: running_balances[child_entry.id], hide_balance: filtered?, is_filtered: filtered? %>
                          <% elsif child_entry.entryable_type == "Valuation" %>
                            <%= render "valuations/compact_valuation", entry: child_entry, running_balance: running_balances[child_entry.id], hide_balance: filtered? %>
                          <% else %>
                            <%= render child_entry, view_ctx: "account", is_filtered: filtered? %>
                          <% end %>
                        <% end %>
                      </div>
                    <% else %>
                      <% if item.entryable_type == "Transaction" %>
                        <%= render "transactions/compact_transaction", entry: item, view_ctx: "account", in_split_group: false, running_balance: running_balances[item.id], hide_balance: filtered?, is_filtered: filtered? %>
                      <% elsif item.entryable_type == "Trade" %>
                        <%= render "trades/compact_trade", entry: item, view_ctx: "account", in_split_group: false, running_balance: running_balances[item.id], hide_balance: filtered?, is_filtered: filtered? %>
                      <% elsif item.entryable_type == "Valuation" %>
                        <%= render "valuations/compact_valuation", entry: item, running_balance: running_balances[item.id], hide_balance: filtered? %>
                      <% else %>
                        <%= render item, view_ctx: "account", is_filtered: filtered? %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% else %>
                  <% flat_entries.each do |entry| %>
                    <% if entry.entryable_type == "Transaction" %>
                      <%= render "transactions/compact_transaction", entry: entry, view_ctx: "account", in_split_group: false, running_balance: running_balances[entry.id], hide_balance: filtered?, is_filtered: filtered? %>
                    <% elsif entry.entryable_type == "Trade" %>
                      <%= render "trades/compact_trade", entry: entry, view_ctx: "account", in_split_group: false, running_balance: running_balances[entry.id], hide_balance: filtered?, is_filtered: filtered? %>
                    <% elsif entry.entryable_type == "Valuation" %>
                      <%= render "valuations/compact_valuation", entry: entry, running_balance: running_balances[entry.id], hide_balance: filtered? %>
                    <% else %>
                      <%= render entry, view_ctx: "account", is_filtered: filtered? %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% else %>
            <div class="space-y-4">
              <% activity_dates.each do |activity_date_data| %>
                <%= render UI::Account::ActivityDate.new(
                      account: account,
                      data: activity_date_data,
                      compact: compact?,
                      group_by_date: group_by_date,
                      filtered: filtered?
                    ) %>
              <% end %>
            </div>
          <% end %>

          <div class="p-4 bg-container rounded-bl-lg rounded-br-lg">
            <%= render "shared/pagination", pagy: pagy %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
