<%= turbo_stream_from account %>

<%= turbo_frame_tag id do %>
  <%= tag.div class: "space-y-4 pb-5 lg:pb-32" do %>
    <%= render "accounts/show/header", account: account, title: title, subtitle: subtitle, reconciliation_indicator: reconciliation_indicator %>

    <% if (gap = balance_gap) %>
      <div class="px-3" data-testid="balance-gap-status">
        <%= render DS::Alert.new(title: t("accounts.show.balance_gap.title"), variant: :warning) do %>
          <p class="privacy-sensitive">
            <%= t(gap.difference.positive? ? "accounts.show.balance_gap.body_higher" : "accounts.show.balance_gap.body_lower",
                  difference: Money.new(gap.difference.abs, account.currency).format,
                  since: l(gap.first_open_waypoint.date, format: :long)) %>
          </p>
          <p>
            <%= render DS::Link.new(
                  text: t("accounts.show.balance_gap.review", date: l(gap.anchor_waypoint.date, format: :long)),
                  href: transactions_path(q: { account_ids: [ account.id ], start_date: gap.anchor_waypoint.date }),
                  variant: :default,
                  frame: :_top
                ) %>
          </p>
        <% end %>
      </div>
    <% end %>

    <%= render UI::Account::Chart.new(account: account, period: chart_period, view: chart_view, loan_chart: loan_chart,
                                     extra_repayment: extra_repayment) %>

    <% if (fx_coverage_start = fx_coverage_start_date).present? %>
      <div class="px-3">
        <%= render DS::Alert.new(
          message: t("accounts.show.limited_fx_history_warning", date: l(fx_coverage_start, format: :long)),
          variant: :warning
        ) %>
      </div>
    <% end %>

    <div data-testid="account-details">
      <% if tabs.count > 1 %>
        <%= render DS::Tabs.new(active_tab: active_tab, url_param_key: "tab") do |tabs_container| %>
          <%# As wide as its tabs and no wider than the column. A loan's five
              tabs can outgrow the column beside the side panels; the bar then
              scrolls on its own instead of wrapping labels or pushing the
              page sideways. %>
          <% tabs_container.with_nav(classes: "w-max max-w-full overflow-x-auto") do |nav| %>
            <% tabs.each do |tab| %>
              <% nav.with_btn(id: tab, label: t("accounts.show.tabs.#{tab}", default: tab.to_s.humanize), classes: "px-6 whitespace-nowrap") %>
            <% end %>
          <% end %>

          <% tabs.each do |tab| %>
            <% tabs_container.with_panel(tab_id: tab) do %>
              <%= tab_content_for(tab) %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= tab_content_for(tabs.first) %>
      <% end %>
    </div>
  <% end %>
<% end %>
