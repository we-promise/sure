<% if items.any? %>
  <div class="space-y-3">
    <% items.each do |item| %>
      <%= render TradeRepublic::ConnectionCardComponent.new(
            item: item,
            qr_active: qr_login_active?(item),
            qr_code_svg: qr_code_svg_for(item)
          ) %>
    <% end %>
  </div>

  <div class="flex justify-center pt-2">
    <%= render DS::Link.new(
          text: translation("add_account"),
          icon: "plus",
          variant: "primary",
          href: helpers.new_trade_republic_item_path,
          frame: :drawer
        ) %>
  </div>
<% else %>
  <%= render TradeRepublic::NewConnectionFormComponent.new(item: new_item) %>
<% end %>
