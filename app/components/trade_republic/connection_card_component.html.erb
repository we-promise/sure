<%= tag.div id: dom_id,
            class: "p-3 rounded-lg bg-container border border-primary space-y-3",
            data: {
              controller: [ "trade-republic-pin-login", ("trade-republic-login" if login_stage == "waiting_for_approval") ].compact.join(" "),
              trade_republic_login_url_value: (helpers.poll_login_trade_republic_item_path(item) if login_stage == "waiting_for_approval")
            }.compact do %>
  <%= render TradeRepublic::QrLoginComponent.new(
        item: item,
        return_url: helpers.settings_providers_path(anchor: "trade-republic"),
        active: qr_active,
        code_svg: qr_code_svg
      ) do |qr| %>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-2 h-2 rounded-full shrink-0 <%= status_dot_class %>"></div>
        <div class="min-w-0">
          <p class="text-sm font-medium text-primary truncate">
            <%= item.name %>
            <% if identifier_last4 %>
              <span class="font-normal text-secondary">&middot; <%= identifier_label %> &bull;&bull;&bull;&bull; <%= identifier_last4 %></span>
            <% end %>
          </p>
          <p class="text-xs text-secondary">
            <% if item.syncing? %>
              <%= translation("syncing") %>
            <% elsif login_stage == "expired" %>
              <span class="text-destructive"><%= translation("login_expired") %></span>
            <% elsif item.pending_login_state.present? %>
              <%= login_stage == "authenticator_code" ? translation("awaiting_authenticator_code") : translation("awaiting_confirmation") %>
            <% elsif item.ready_for_sync? %>
              <% if item.unlinked_accounts_count.positive? %>
                <%= translation("accounts_discovered", count: item.unlinked_accounts_count) %>
                <%= helpers.link_to translation("setup_accounts"), helpers.setup_accounts_trade_republic_item_path(item), class: "link", data: { turbo_frame: :modal } %>
              <% else %>
                <%= translation("status_configured_prefix", summary: item.sync_status_summary) %>
                <%= helpers.link_to translation("accounts_tab"), helpers.accounts_path, class: "link" %>
                <%= translation("status_configured_suffix") %>
              <% end %>
            <% elsif item.needs_login? %>
              <span class="text-destructive"><%= translation("requires_update") %></span>
            <% else %>
              <%= translation("not_configured") %>
            <% end %>
          </p>
          <% if item.ready_for_sync? && item.session_expires_at.present? %>
            <p class="text-xs text-secondary"><%= translation("session_expires_in", time: helpers.distance_of_time_in_words_to_now(item.session_expires_at)) %></p>
          <% end %>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <%# Like Enable Banking, only a logged-in connection can sync. %>
        <% if item.ready_for_sync? %>
          <%= render DS::Button.new(
                text: translation("sync"),
                variant: :outline,
                size: :sm,
                icon: "refresh-cw",
                href: helpers.sync_trade_republic_item_path(item, source: "panel"),
                method: :post,
                disabled: item.syncing?
              ) %>
        <% end %>

        <% unless push_login_in_progress? %>
          <%= qr.button %>

          <%= render DS::Button.new(
                text: translation("pin_login"),
                variant: :outline,
                size: :sm,
                icon: "log-in",
                type: "button",
                aria: { expanded: false, controls: pin_login_form_id },
                data: { action: "trade-republic-pin-login#toggle", trade_republic_pin_login_target: "button" }
              ) %>
        <% end %>

        <%= render DS::Button.new(
              text: translation("remove"),
              variant: :outline_destructive,
              size: :sm,
              icon: "trash-2",
              href: helpers.trade_republic_item_path(item),
              method: :delete,
              confirm: identifier_last4 ? translation("disconnect_confirm_with_identifier", last4: identifier_last4) : translation("disconnect_confirm")
            ) %>
      </div>
    </div>
  <% end %>

  <% if login_stage == "authenticator_code" %>
    <%= render DS::Alert.new(message: translation("authenticator_code_notice"), variant: :info) %>

    <%= helpers.styled_form_with url: helpers.complete_login_trade_republic_item_path(item),
                         method: :post,
                         scope: :trade_republic_login,
                         class: "space-y-3" do |form| %>
      <%= form.text_field :code,
                          label: translation("authenticator_code_label"),
                          placeholder: translation("authenticator_code_placeholder"),
                          value: nil,
                          required: true %>
      <div class="flex flex-wrap justify-end gap-2">
        <%= form.submit(translation("complete_login")) %>
      </div>
    <% end %>
  <% elsif login_stage == "waiting_for_approval" %>
    <%= render DS::Alert.new(message: translation("push_login_notice"), variant: :info) %>
    <div class="flex flex-wrap justify-end gap-2">
      <%= render DS::Button.new(
            text: translation("check_login_status"),
            variant: :outline,
            size: :sm,
            icon: "refresh-cw",
            href: helpers.poll_login_trade_republic_item_path(item),
            method: :post
          ) %>
    </div>
  <% end %>

  <% unless push_login_in_progress? %>
    <div id="<%= pin_login_form_id %>" hidden data-trade-republic-pin-login-target="form" class="rounded-lg border border-secondary bg-container-inset p-4">
      <%= helpers.styled_form_with model: item,
                           url: helpers.trade_republic_item_path(item),
                           scope: :trade_republic_item,
                           method: :patch,
                           data: { turbo: true },
                           class: "space-y-3" do |form| %>
        <%= form.text_field :phone_number,
                            label: translation("phone_number_label"),
                            placeholder: item.phone_number.present? ? translation("phone_number_placeholder_existing") : translation("phone_number_placeholder_new"),
                            type: :tel,
                            value: nil,
                            required: item.phone_number.blank? %>

        <%= form.text_field :pin,
                            label: translation("pin_label"),
                            placeholder: translation("pin_placeholder_new"),
                            type: :password,
                            value: nil,
                            required: true %>

        <div class="flex flex-wrap justify-end gap-2">
          <%= form.submit(translation("connect")) %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
