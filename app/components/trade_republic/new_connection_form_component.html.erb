<%= helpers.styled_form_with model: pending_connection,
                     url: helpers.trade_republic_pending_connections_path,
                     scope: :trade_republic_pending_connection,
                     method: :post,
                     data: { turbo: true },
                     class: "space-y-3" do |form| %>
  <%= hidden_field_tag :in_drawer, "1" if in_drawer %>

  <%= form.text_field :phone_number,
                      label: translation("phone_number_label"),
                      placeholder: translation("phone_number_placeholder_new"),
                      type: :tel,
                      value: pending_connection.phone_number %>

  <%= form.text_field :pin,
                      label: translation("pin_label"),
                      placeholder: translation("pin_placeholder_new"),
                      type: :password,
                      value: nil %>

  <div class="flex flex-wrap justify-end gap-2">
    <%= form.submit(translation("save_configuration")) %>
    <%= render DS::Button.new(
          text: translation("qr_login"),
          variant: :outline,
          size: :sm,
          icon: "qr-code",
          type: "submit",
          name: "login_method",
          value: "qr"
        ) %>
  </div>
<% end %>
