<div class="space-y-3" data-controller="trade-republic-qr"
     data-trade-republic-qr-auto-poll-value="<%= active %>"
     data-trade-republic-qr-initiate-url-value="<%= login_path(:initiate_qr_login) %>"
     data-trade-republic-qr-poll-url-value="<%= login_path(:poll_qr_login) %>"
     data-trade-republic-qr-cancel-url-value="<%= login_path(:cancel_qr_login) %>"
     data-trade-republic-qr-return-url-value="<%= return_url %>"
     data-trade-republic-qr-login-token-value="<%= record.login_token if active %>"
     data-trade-republic-qr-loading-text-value="<%= translation("qr_loading") %>"
     data-trade-republic-qr-instruction-text-value="<%= translation("qr_instruction") %>"
     data-trade-republic-qr-success-text-value="<%= translation("qr_success") %>"
     data-trade-republic-qr-error-text-value="<%= translation("qr_error") %>"
     data-trade-republic-qr-login-text-value="<%= translation("qr_login") %>"
     data-trade-republic-qr-cancel-text-value="<%= translation("qr_cancel") %>">
  <%= content? ? content : button %>

  <%= render DS::Card.new(variant: :inset, tag: :div, class: "space-y-3", hidden: !active, data: { trade_republic_qr_target: "panel" }) do %>
    <p data-trade-republic-qr-target="status" class="text-sm text-secondary"></p>
    <div data-trade-republic-qr-target="code" class="qrcode flex justify-center min-h-48"><%= code_svg %></div>
  <% end %>
</div>
