<% items.each do |item| %>
  <%= render DS::Disclosure.new(variant: :card) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center justify-between gap-3 w-full">
        <div class="min-w-0">
          <p class="font-medium text-primary truncate"><%= item.name %></p>
          <p class="text-xs text-secondary">
            <% if item.syncing? %>
              <%= translation("syncing") %>
            <% else %>
              <%= sync_status_summary_for(item) %>
            <% end %>
          </p>
        </div>
      </div>
    <% end %>

    <div class="mt-4 space-y-4">
      <div class="flex flex-wrap justify-end gap-2">
        <%= render DS::Button.new(
                     text: translation("sync"),
                     icon: "refresh-cw",
                     variant: :outline,
                     href: helpers.sync_etoro_item_path(item, source: "panel"),
                     method: :post,
                     disabled: item.syncing?
                   ) %>

        <%= render DS::Button.new(
                     icon: "trash-2",
                     variant: :outline_destructive,
                     href: helpers.etoro_item_path(item),
                     method: :delete,
                     confirm: helpers.etoro_item_deletion_confirm(item, fallback: translation("disconnect_confirm")),
                     aria_label: translation("disconnect")
                   ) %>
      </div>

      <%# Each form has its own namespace, so its fields' ids, and the labels
          pointing at them, are its own. %>
      <%= helpers.styled_form_with model: item,
                                   url: helpers.etoro_item_path(item),
                                   scope: :etoro_item,
                                   namespace: helpers.dom_id(item),
                                   method: :patch,
                                   data: { turbo: true },
                                   class: "space-y-3" do |form| %>
        <%= form.text_field :api_key,
                            label: translation("api_key_label"),
                            placeholder: translation("api_key_placeholder_existing"),
                            type: :password,
                            value: nil %>

        <%= form.text_field :user_key,
                            label: translation("user_key_label"),
                            placeholder: translation("user_key_placeholder_existing"),
                            type: :password,
                            value: nil %>

        <%= render "etoro_items/own_securities_field", form: form %>

        <div class="flex flex-wrap justify-end gap-2">
          <%= form.submit translation("update_configuration") %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if items.any? %>
  <h3 class="flex items-center gap-2 text-sm font-medium text-primary mt-4">
    <%= helpers.icon "plus", size: "sm" %>
    <%= translation("add_account") %>
  </h3>
<% end %>

<%= helpers.styled_form_with model: new_item,
                             url: helpers.etoro_items_path,
                             scope: :etoro_item,
                             namespace: "new_etoro_item",
                             method: :post,
                             data: { turbo: true },
                             class: "space-y-3" do |form| %>
  <%= form.text_field :api_key,
                      label: translation("api_key_label"),
                      placeholder: translation("api_key_placeholder_new"),
                      type: :password %>

  <%= form.text_field :user_key,
                      label: translation("user_key_label"),
                      placeholder: translation("user_key_placeholder_new"),
                      type: :password %>

  <%= render "etoro_items/own_securities_field", form: form %>

  <div class="flex flex-wrap justify-end gap-2">
    <%= form.submit translation("save_configuration") %>
  </div>
<% end %>
