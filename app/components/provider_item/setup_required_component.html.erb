<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: dialog_t("title")) %>
    <% dialog.with_body do %>
      <div class="space-y-4">
        <%= render DS::Alert.new(title: dialog_t("heading"), message: dialog_t("description"), variant: :warning) %>

        <div class="bg-surface rounded-lg p-4 space-y-2 text-sm">
          <p class="font-medium text-primary"><%= dialog_t("setup_steps") %></p>
          <ol class="list-decimal list-inside space-y-1 text-secondary">
            <li><%= dialog_t("steps.open_settings_html") %></li>
            <li><%= dialog_t("steps.find_section_html") %></li>
            <li><%= dialog_t("steps.enter_token") %></li>
            <li><%= dialog_t("steps.return_to_link") %></li>
          </ol>
        </div>

        <div class="mt-4">
          <%= render DS::Link.new(
            text: dialog_t("settings_link"),
            href: helpers.settings_providers_path,
            variant: :primary,
            data: { turbo: false }
          ) %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
