<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: dialog_t("title")) %>
    <% dialog.with_body do %>
      <div class="space-y-4">
        <% if notice == :alert %>
          <%= render DS::Alert.new(title: heading, message: description, variant: :warning) %>
        <% else %>
          <div class="flex items-start gap-3">
            <%= helpers.icon("alert-circle", class: "text-warning w-5 h-5 shrink-0 mt-0.5") %>
            <div class="text-sm text-secondary">
              <p class="font-medium text-primary mb-2"><%= heading %></p>
              <p><%= description %></p>
            </div>
          </div>
        <% end %>

        <div class="bg-surface rounded-lg p-4 space-y-2 text-sm">
          <p class="font-medium text-primary"><%= steps_title %></p>
          <ol class="list-decimal list-inside space-y-1 text-secondary">
            <% steps.each do |step| %>
              <li><%= step %></li>
            <% end %>
          </ol>
        </div>

        <div class="mt-4">
          <%= render DS::Link.new(
            text: link_text,
            href: helpers.settings_providers_path,
            variant: :primary,
            data: { turbo: false }
          ) %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
