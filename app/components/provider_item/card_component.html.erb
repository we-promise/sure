<%= tag.div id: helpers.dom_id(item) do %>
  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <%= helpers.icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>

          <%= render ProviderLogo.new(provider_key: provider_key.to_sym) %>

          <div class="pl-1 text-sm">
            <div class="flex items-center gap-2">
              <%= tag.p item.name, class: "font-medium text-primary" %>
              <% if item.scheduled_for_deletion? %>
                <%= tag.p card_t("deletion_in_progress"), class: "text-destructive text-sm animate-pulse" %>
              <% end %>
            </div>
            <%# The institution belongs to every account on the connection, so it is
                shown only to a viewer who can see them all (#3630), once one is linked. %>
            <% if item.accounts.any? && whole_connection_visible? %>
              <p class="text-xs text-secondary">
                <%= item.institution_summary %>
              </p>
            <% end %>
            <% if item.syncing? %>
              <div class="text-secondary flex items-center gap-1">
                <%= helpers.icon "loader", size: "sm", class: "animate-spin" %>
                <%= tag.span card_t("syncing") %>
              </div>
            <% elsif item.sync_error.present? %>
              <div class="text-secondary flex items-center gap-1">
                <%= render DS::Tooltip.new(text: item.sync_error, icon: "alert-circle", size: "sm", color: "destructive", as: :span) %>
                <%= tag.span card_t("error"), class: "text-destructive" %>
              </div>
            <% else %>
              <p class="text-secondary">
                <% if item.last_synced_at %>
                  <% if whole_connection_visible? && item.sync_status_summary %>
                    <%= card_t("status_with_summary", timestamp: helpers.time_ago_in_words(item.last_synced_at), summary: item.sync_status_summary) %>
                  <% else %>
                    <%= card_t("status", timestamp: helpers.time_ago_in_words(item.last_synced_at)) %>
                  <% end %>
                <% else %>
                  <%= card_t("status_never") %>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>

        <% if Current.user&.admin? %>
          <div class="flex items-center gap-2">
            <% if Rails.env.development? %>
              <%= helpers.icon(
                "refresh-cw",
                as_button: true,
                href: sync_path
              ) %>
            <% end %>

            <%= render DS::Menu.new do |menu| %>
              <% helpers.sync_schedule_menu_item(menu, item) %>
              <% menu.with_item(
                variant: "button",
                text: card_t("delete"),
                icon: "trash-2",
                href: item_path,
                method: :delete,
                confirm: CustomConfirm.for_resource_deletion(item.name, high_severity: true)
              ) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% unless item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if visible_accounts.any? %>
          <%= helpers.render "accounts/index/account_groups", accounts: visible_accounts %>
        <% end %>

        <%= render ProviderSyncSummary.new(
          stats: stats,
          provider_item: item, show_account_details: whole_connection_visible?,
          show_account_counts: whole_connection_visible?,
          institutions_count: institutions_count
        ) %>

        <% if (prompt = setup_prompt) %>
          <%= render DS::EmptyState.new(icon: "settings", **prompt) do |empty_state| %>
            <% empty_state.with_action do %>
              <%= render DS::Link.new(
                text: card_t("setup_action"),
                icon: "settings",
                variant: "primary",
                href: setup_accounts_path,
                frame: :modal
              ) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
