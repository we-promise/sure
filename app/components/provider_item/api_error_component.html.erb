<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: dialog_t("title")) %>
    <% dialog.with_body do %>
      <div class="space-y-4">
        <%= render DS::Alert.new(title: heading, message: error_message, variant: :error) %>

        <div class="bg-surface rounded-lg p-4 space-y-2 text-sm">
          <p class="font-medium text-primary"><%= dialog_t("common_issues") %></p>
          <ul class="list-disc list-inside space-y-1 text-secondary">
            <% issues.each do |label, description| %>
              <li><strong><%= label %></strong> <%= description %></li>
            <% end %>
          </ul>
        </div>

        <div class="mt-4">
          <%= render DS::Link.new(
            text: link_text,
            href: return_path.presence || helpers.settings_providers_path,
            variant: :primary,
            data: { turbo: false }
          ) %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
