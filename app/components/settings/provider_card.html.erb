<%= content_tag(external_link ? :div : :a,
      href: (connect_path unless external_link),
      class: class_names(
        "bg-container shadow-border-xs rounded-xl p-4 flex flex-col gap-2.5 text-primary",
        "hover:bg-surface-inset transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-alpha-black-300" => !external_link
      ),
      data: filter_data.merge(external_link ? {} : { turbo_frame: "drawer", turbo_prefetch: "false" })) do %>
  <div class="flex items-start gap-2.5">
    <%= render ProviderLogo.new(provider_key: provider_key, class_name: "w-9 h-9 rounded-lg") %>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm font-medium text-primary"><%= name %></span>
        <%= render "settings/providers/maturity_badge", label: maturity_label %>
      </div>
      <% if meta_line.present? %>
        <p class="text-xs text-secondary mt-0.5"><%= meta_line %></p>
      <% end %>
    </div>
  </div>
  <% if tagline.present? %>
    <p class="text-sm text-secondary grow leading-snug"><%= tagline %></p>
  <% end %>
  <div class="flex items-center justify-end gap-1.5 text-sm font-medium text-primary">
    <% if external_link %>
      <% if external_link[:href].present? %>
        <%= render DS::Link.new(text: external_link.fetch(:text), href: external_link[:href], variant: :secondary, size: :sm,
              target: "_blank", data: { turbo: false }, title: external_link[:tooltip]) %>
      <% else %>
        <span title="<%= external_link[:tooltip] %>" tabindex="0" aria-label="<%= external_link.fetch(:text) %>" aria-description="<%= external_link[:tooltip] %>">
          <%= render DS::Button.new(text: external_link.fetch(:text), variant: :secondary, size: :sm,
                disabled: true, class: "pointer-events-none opacity-50", aria: { description: external_link[:tooltip] }) %>
        </span>
      <% end %>
    <% else %>
      <%= t("settings.providers.connect") %>
      <%= helpers.icon "arrow-right", size: "sm", class: "!w-3.5 !h-3.5" %>
    <% end %>
  </div>
<% end %>
