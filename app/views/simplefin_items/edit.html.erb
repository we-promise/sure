<% content_for :title, t(".title") %>

<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title")) do %>
    <div class="flex items-center gap-2">
      <%= icon "building-2", class: "text-primary" %>
      <span class="text-primary"><%= t(".header_subtitle") %></span>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <% if turbo_frame_request? %>
      <% if flash[:notice].present? %>
        <div class="mb-4">
          <%= render DS::Alert.new(message: flash[:notice], variant: :success, live: :status) %>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="mb-4">
          <%= render DS::Alert.new(message: flash[:alert], variant: :error, live: :alert) %>
        </div>
      <% end %>
    <% end %>

    <%= render "connection_requests", connection_requests: @connection_requests %>

    <%= form_with model: @simplefin_item, local: true, class: "space-y-6" do |form| %>
      <%= render DS::Alert.new(title: t(".connection_needs_update"), variant: :info) do %>
        <ol class="text-xs text-secondary space-y-1 list-decimal list-inside">
          <li><%= t(".step_1_html") %></li>
          <li><%= t(".step_2") %></li>
          <li><%= t(".step_3") %></li>
        </ol>
      <% end %>

      <% if @error_message %>
        <%= render DS::Alert.new(message: @error_message, variant: :error, live: :alert) %>
      <% end %>

      <div>
        <%= form.label :setup_token, t(".setup_token.label"), class: "block text-sm font-medium text-primary mb-2" %>
        <%= form.text_area :setup_token,
            placeholder: t(".setup_token.placeholder"),
            class: "appearance-none bg-container border border-primary rounded-md px-3 py-2 text-sm leading-6 text-primary focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none w-full h-32 resize-none font-mono" %>
        <p class="text-xs text-secondary mt-1"><%= t(".setup_token.help_text") %></p>
      </div>

      <div class="flex gap-3">
        <%= render DS::Button.new(
          text: t(".update"),
          variant: "primary",
          icon: "refresh-cw",
          type: "submit",
          class: "flex-1"
        ) %>
        <%= render DS::Link.new(
          text: t(".cancel"),
          variant: "secondary",
          href: accounts_path
        ) %>
      </div>
    <% end %>
  <% end %>
  <% end %>
<% end %>
