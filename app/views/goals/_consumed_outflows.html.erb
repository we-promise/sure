<%# locals: (goal:, entries:) %>

<%# The other half of the detection panel above. That one asks "was this spent
    on X?"; without this, pressing "This was it" produces a flash and nothing
    else — the figure under the ring moves and nothing says what moved it.
    Same card and same row as that panel on purpose: it is one conversation. %>
<% listed_total = entries.sum { |entry| entry.amount.to_d } %>
<% unaccounted = goal.consumption_unaccounted_for(listed_total) %>

<div class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
  <div class="flex items-start gap-3">
    <div class="w-8 h-8 rounded-full bg-surface-inset inline-flex items-center justify-center text-secondary shrink-0">
      <%= icon("receipt", size: "sm") %>
    </div>
    <div class="min-w-0">
      <h2 class="text-sm font-medium text-primary"><%= t(".heading") %></h2>
      <%# The reconciliation line. A consumption entered as a bare amount
          leaves no record, so the list cannot be complete — and a list that is
          quietly short of its own total is worse than one that says so. %>
      <p class="text-xs text-secondary mt-0.5 tabular-nums privacy-sensitive">
        <%= t(".summary",
              total: goal.consumed_amount_money.format(precision: 0),
              listed: Money.new(listed_total, goal.currency).format(precision: 0),
              count: entries.size) %>
        <% if unaccounted.positive? %>
          <span class="text-subdued">
            <%= t(".unaccounted", amount: Money.new(unaccounted, goal.currency).format(precision: 0)) %>
          </span>
        <% end %>
      </p>
    </div>
  </div>

  <ul class="space-y-2">
    <% entries.each do |entry| %>
      <li class="flex items-center justify-between gap-3 rounded-lg bg-surface-inset px-3 py-2">
        <div class="min-w-0">
          <p class="text-sm text-primary truncate"><%= entry.name %></p>
          <p class="text-xs text-secondary tabular-nums privacy-sensitive">
            <%= l(entry.date, format: :long) %>
            <span aria-hidden="true"><%= t("shared.dot_separator") %></span>
            <%= entry.account.name %>
          </p>
        </div>
        <span class="text-sm text-primary tabular-nums privacy-sensitive shrink-0">
          <%= Money.new(entry.amount, entry.currency).format %>
        </span>
      </li>
    <% end %>
  </ul>
</div>
