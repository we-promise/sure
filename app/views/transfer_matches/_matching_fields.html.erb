<%# locals: (form:, entry:, candidates:, accounts:, suggested_account: nil) %>

<% if candidates.any? %>
  <div data-controller="transfer-match" class="space-y-2">
    <p class="text-sm text-secondary">
      <%= t(".select_method") %>
    </p>

    <%= form.select :method,
              [
                [t(".match_existing_recommended"), "existing"],
                [t(".create_new_transaction"), "new"]
              ],
              { selected: "existing", label: t(".matching_method") },
              data: { action: "change->transfer-match#update" } %>

    <div data-transfer-match-target="existingSelect">
      <%= form.select :matched_entry_id,
                candidates.map { |entry|
                  [entry_name_detailed(entry), entry.id]
                },
                { label: t(".matching_transaction") } %>
    </div>

    <div data-transfer-match-target="newSelect" class="hidden">
      <%= form.select :target_account_id,
                accounts.map { |account| [account.name, account.id] },
                { label: t(".target_account") } %>
    </div>
  </div>
<% else %>
  <% if suggested_account.present? %>
    <%= render DS::Alert.new(variant: :info) do %>
      <div class="flex items-start justify-between gap-2">
        <p><%= t(".suggested_account_html", name: suggested_account.name) %></p>
        <%# A link, not DS::Button: button_to would nest a form inside the match form. %>
        <%= render DS::Link.new(
              text: t(".dismiss_suggestion"),
              href: dismiss_suggestion_transaction_transfer_match_path(entry),
              variant: :default,
              method: :post,
              frame: "_top",
              class: "whitespace-nowrap"
            ) %>
      </div>
    <% end %>
  <% else %>
    <p class="text-sm text-secondary">
      <%= t(".no_matching_transactions") %>
    </p>
  <% end %>

  <%= form.hidden_field :method, value: "new" %>

  <div>
    <%= form.select :target_account_id,
                accounts.map { |account| [account.name, account.id] },
                { label: t(".target_account"), selected: suggested_account&.id } %>
  </div>
<% end %>
