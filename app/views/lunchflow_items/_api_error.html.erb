<%# locals: (error_message:, return_path:) %>
<%# Lunch Flow's dialog links to the provider settings whatever the return path. %>
<%= render ProviderItem::ApiErrorComponent.new(
      provider_key: "lunchflow",
      error_message: error_message,
      return_path: nil,
      heading: t(".unable_to_connect"),
      issues: [
        [ "#{t(".invalid_api_key_label")}:", t(".invalid_api_key_desc") ],
        [ "#{t(".expired_credentials_label")}:", t(".expired_credentials_desc") ],
        [ "#{t(".network_issue_label")}:", t(".network_issue_desc") ],
        [ "#{t(".service_down_label")}:", t(".service_down_desc") ]
      ],
      link_text: t(".check_provider_settings")
    ) %>
