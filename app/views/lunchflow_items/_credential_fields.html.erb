<%# locals: (form:, item:, editing:) %>
<%= form.text_field :api_key,
                    label: t("settings.providers.lunchflow_panel.api_key_label"),
                    placeholder: t(editing ? "settings.providers.lunchflow_panel.api_key_placeholder_update" : "settings.providers.lunchflow_panel.api_key_placeholder_new"),
                    type: :password,
                    value: nil %>

<%= form.text_field :base_url,
                    label: t("settings.providers.lunchflow_panel.base_url_label"),
                    placeholder: t("settings.providers.lunchflow_panel.base_url_placeholder"),
                    value: item.base_url %>

<%= form.date_field :sync_start_date,
                    label: t("settings.providers.lunchflow_panel.sync_start_date_label"),
                    value: item.sync_start_date&.to_date,
                    max: Date.current,
                    help_text: t("settings.providers.lunchflow_panel.sync_start_date_help") %>
