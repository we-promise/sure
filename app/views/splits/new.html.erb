<%= render DS::Dialog.new(variant: "modal") do |dialog| %>
  <% dialog.with_header do %>
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-primary"><%= @entry.name %></h2>
        <p class="text-sm text-secondary flex items-center gap-1.5">
          <span><%= @entry.date.strftime("%b %d, %Y") %></span>
          <% if (category = @entry.entryable.try(:category)) %>
            <span class="text-secondary">&middot;</span>
            <span style="color: <%= category.color %>"><%= icon category.lucide_icon, size: "xs", color: "current" %></span>
            <span><%= category.display_name %></span>
          <% end %>
        </p>
      </div>
      <div class="text-right shrink-0">
        <p class="text-xs font-medium text-secondary uppercase tracking-wide"><%= t("splits.new.original_amount") %></p>
        <p class="text-lg font-semibold text-primary"><%= format_money(-@entry.amount_money) %></p>
      </div>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <% if @receipt_itemization_available %>
      <div class="flex items-center justify-between gap-3 mb-3">
        <p class="text-sm text-secondary"><%= t("splits.new.receipt_prompt") %></p>
        <%= render DS::Link.new(
              text: t("splits.new.fill_from_receipt"),
              icon: "sparkles",
              variant: :outline,
              href: itemize_transaction_split_path(@entry),
              method: :post,
              frame: :modal
            ) %>
      </div>
    <% end %>

    <% if @receipt_proposal %>
      <div class="mb-3">
        <%= render DS::Alert.new(title: t("splits.new.receipt_applied"), variant: :success, live: :status) do %>
          <% unless @receipt_proposal.unmatched_amount.zero? %>
            <p class="text-secondary">
              <%= t("splits.new.receipt_unmatched",
                    receipt_total: format_money(Money.new(@receipt_proposal.receipt_total, @entry.currency)),
                    name: @entry.name) %>
            </p>
          <% end %>
        <% end %>
      </div>
    <% elsif @receipt_error %>
      <div class="mb-3">
        <%= render DS::Alert.new(message: @receipt_error, variant: :error, live: :alert) %>
      </div>
    <% end %>

    <%= form_with(
          url: transaction_split_path(@entry),
          scope: :split,
          class: "space-y-3",
          data: {
            controller: "split-transaction",
            split_transaction_total_value: (-@entry.amount).to_f,
            split_transaction_currency_value: @entry.currency,
            turbo_frame: :_top
          }
        ) do %>

      <%# Split rows: one blank row, or the rows proposed from a receipt %>
      <%
        # Number inputs take only dot-decimal values, whatever the user's language.
        precision = Money::Currency.new(@entry.currency).default_precision
        input_number = ->(value) { number_with_precision(value, precision: precision, separator: ".", delimiter: "") }
        amount_step = input_number.call(BigDecimal(10)**-precision)
        rows = if @receipt_proposal
          @receipt_proposal.rows.map { |row| { name: row.name, amount: input_number.call(-row.amount) } }
        else
          [ { name: @entry.name, amount: nil } ]
        end
      %>
      <div data-split-transaction-target="rowsContainer" class="space-y-3">
        <% rows.each_with_index do |row, index| %>
          <%= render "splits/row",
                     index: index,
                     name: row[:name],
                     amount: row[:amount],
                     step: amount_step,
                     categories: @categories,
                     merchants: @merchants,
                     tags: @tags,
                     removable: !index.zero? %>
        <% end %>
      </div>

      <template data-split-transaction-target="rowTemplate">
        <%= render "splits/row",
                   index: "ROW_IDX_PLACEHOLDER",
                   step: amount_step,
                   categories: @categories,
                   merchants: @merchants,
                   tags: @tags %>
      </template>

      <%# Add split button %>
      <button type="button"
              class="flex items-center justify-center gap-1.5 w-full py-2 text-sm font-medium text-secondary hover:text-primary border border-dashed border-secondary hover:border-primary rounded-lg transition-colors"
              data-action="click->split-transaction#addRow">
        <%= icon "plus", size: "sm" %>
        <%= t("splits.new.add_row") %>
      </button>

      <%# Remaining balance indicator %>
      <div data-split-transaction-target="remainingContainer" class="p-3 rounded-lg border border-destructive bg-red-tint-10 text-sm">
        <div class="flex items-center justify-between">
          <span class="text-secondary font-medium"><%= t("splits.new.remaining") %></span>
          <span data-split-transaction-target="remaining" class="font-semibold text-destructive">
            <%= (-@entry.amount).to_f %>
          </span>
        </div>
        <p data-split-transaction-target="error" class="text-destructive text-xs mt-1.5">
          <%= t("splits.new.amounts_must_match") %>
        </p>
      </div>

      <%# Actions %>
      <div class="flex justify-end gap-3 pt-4 border-t border-primary">
        <%= render DS::Button.new(
          text: t("splits.new.cancel"),
          variant: "outline",
          type: "button",
          data: { action: "click->DS--dialog#close" }
        ) %>
        <%= render DS::Button.new(
          text: t("splits.new.submit"),
          variant: "primary",
          type: "submit",
          data: { split_transaction_target: "submitButton" }
        ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
