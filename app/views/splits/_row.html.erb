<%# locals: (index:, categories:, merchants:, tags:, name: nil, amount: nil, category_id: nil, merchant_id: nil, tag_ids: [], removable: true) %>

<div class="p-3 rounded-lg border border-secondary bg-container" data-split-transaction-target="row">
  <div class="flex flex-wrap md:flex-nowrap items-end gap-2">
    <div class="w-full md:flex-1 md:w-auto min-w-0">
      <label class="text-xs font-medium text-secondary uppercase tracking-wide block mb-1"><%= t("splits.new.name_label") %></label>
      <input type="text"
             name="split[splits][<%= index %>][name]"
             placeholder="<%= t("splits.new.name_placeholder") %>"
             class="form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container"
             required
             autocomplete="off"
             value="<%= name %>"
             data-split-transaction-target="nameInput">
    </div>
    <div class="flex-1 md:flex-none md:w-28">
      <label class="text-xs font-medium text-secondary uppercase tracking-wide block mb-1"><%= t("splits.new.amount_label") %></label>
      <input type="number"
             name="split[splits][<%= index %>][amount]"
             placeholder="0.00"
             step="0.01"
             class="form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container"
             required
             autocomplete="off"
             value="<%= amount %>"
             data-split-transaction-target="amountInput"
             data-action="input->split-transaction#updateRemaining">
    </div>
    <% if removable %>
      <%= icon(
        "x",
        size: "sm",
        as_button: true,
        aria_label: t("splits.new.remove_row"),
        data: { action: "split-transaction#removeRow" }) %>
    <% else %>
      <div class="w-8 shrink-0 hidden md:block"></div>
    <% end %>
  </div>
  <div class="flex flex-wrap md:flex-nowrap items-end gap-2 mt-2">
    <%= render "splits/category_select",
               name: "split[splits][#{index}][category_id]",
               categories: categories,
               selected_id: category_id %>
    <%= render "splits/merchant_select",
               name: "split[splits][#{index}][merchant_id]",
               merchants: merchants,
               selected_id: merchant_id %>
    <%= render "splits/tag_select",
               name: "split[splits][#{index}][tag_ids][]",
               tags: tags,
               selected_ids: tag_ids %>
  </div>
</div>
