<%# locals: (form:, idx:, split: {}, categories:, merchants:, tags:) %>

<% base_name = "#{form.object_name}[split_rows][#{idx}]" %>
<% split_tag_ids = Array(split["tag_ids"]) %>

<div class="p-2 rounded-md border border-secondary bg-container flex flex-col gap-1.5" data-rule--split-action-target="row">
  <div class="flex items-center gap-1.5">
    <input type="text"
           name="<%= base_name %>[name]"
           placeholder="<%= t("rules.actions.split.name_placeholder") %>"
           value="<%= split["name"] %>"
           class="form-field__input border border-secondary rounded-md px-2 py-1 text-sm text-primary bg-container flex-1 min-w-0"
           autocomplete="off">

    <input type="number"
           name="<%= base_name %>[share]"
           step="0.01"
           min="0"
           placeholder="0.00"
           value="<%= split["share"] %>"
           class="form-field__input border border-secondary rounded-md px-2 py-1 text-sm text-primary bg-container w-20 shrink-0"
           autocomplete="off"
           data-rule--split-action-target="shareInput"
           data-action="input->rule--split-action#updateSummary">

    <%= icon(
      "trash-2",
      size: "sm",
      as_button: true,
      data: { action: "rule--split-action#removeRow" }) %>
  </div>

  <div class="flex flex-wrap items-center gap-1.5">
    <select name="<%= base_name %>[category_id]"
            class="form-field__input border border-secondary rounded-md px-2 py-1 text-sm text-primary bg-container flex-1 min-w-0">
      <option value=""><%= t("splits.new.uncategorized") %></option>
      <% categories.each do |name, id| %>
        <option value="<%= id %>" <%= "selected" if split["category_id"] == id %>><%= name %></option>
      <% end %>
    </select>

    <select name="<%= base_name %>[merchant_id]"
            class="form-field__input border border-secondary rounded-md px-2 py-1 text-sm text-primary bg-container flex-1 min-w-0">
      <option value=""><%= t("rules.actions.split.no_merchant") %></option>
      <% merchants.each do |name, id| %>
        <option value="<%= id %>" <%= "selected" if split["merchant_id"] == id %>><%= name %></option>
      <% end %>
    </select>

    <select name="<%= base_name %>[tag_ids][]" multiple
            title="<%= t("rules.actions.split.tags_hint") %>"
            class="form-field__input border border-secondary rounded-md px-2 py-1 text-sm text-primary bg-container flex-1 min-w-0">
      <% tags.each do |name, id| %>
        <option value="<%= id %>" <%= "selected" if split_tag_ids.include?(id) %>><%= name %></option>
      <% end %>
    </select>
  </div>
</div>
