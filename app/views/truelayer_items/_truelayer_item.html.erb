<%# locals: (truelayer_item:, visible_accounts:) %>

<%= tag.div id: dom_id(truelayer_item) do %>
  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex w-full items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>

          <%= render ProviderLogo.new(provider_key: :truelayer) %>

          <div class="pl-1 text-sm">
            <div class="flex items-center gap-2">
              <%= tag.p truelayer_item.name, class: "font-medium text-primary" %>
              <% if truelayer_item.scheduled_for_deletion? %>
                <p class="text-destructive text-sm animate-pulse"><%= t(".deletion_in_progress") %></p>
              <% end %>
            </div>
            <% if truelayer_item.requires_update? %>
              <div class="text-warning flex items-center gap-1">
                <%= icon "alert-triangle", size: "sm", color: "warning" %>
                <%= tag.span t(".requires_update") %>
              </div>
            <% elsif truelayer_item.syncing? %>
              <div class="text-secondary flex items-center gap-1">
                <%= icon "loader", size: "sm", class: "animate-spin" %>
                <%= tag.span t(".syncing") %>
              </div>
            <% elsif truelayer_item.sync_error.present? %>
              <div class="text-secondary flex items-center gap-1">
                <%= render DS::Tooltip.new(text: truelayer_item.sync_error, icon: "alert-circle", size: "sm", color: "destructive", as: :span) %>
                <%= tag.span t(".error"), class: "text-destructive" %>
              </div>
            <% else %>
              <p class="text-secondary">
                <% if truelayer_item.last_synced_at %>
                  <% if truelayer_item.sync_status_summary %>
                    <%= t(".status_with_summary", timestamp: time_ago_in_words(truelayer_item.last_synced_at), summary: truelayer_item.sync_status_summary) %>
                  <% else %>
                    <%= t(".status", timestamp: time_ago_in_words(truelayer_item.last_synced_at)) %>
                  <% end %>
                <% else %>
                  <%= t(".status_never") %>
                <% end %>
              </p>
              <% if truelayer_item.consent_expiring_soon? %>
                <p class="text-xs text-warning"><%= t(".consent_expiring", date: l(truelayer_item.consent_expires_at.to_date, format: :long)) %></p>
              <% end %>
              <% if truelayer_item.history_backfill_missed? %>
                <p class="text-xs text-secondary"><%= t(".history_missed") %></p>
              <% end %>
            <% end %>
          </div>
        </div>

        <% if Current.user&.admin? %>
          <div class="flex items-center gap-2">
            <% if truelayer_item.requires_update? || truelayer_item.consent_expiring_soon? || truelayer_item.history_backfill_missed? %>
              <%= render DS::Button.new(
                text: t(".reconnect"),
                icon: "refresh-cw",
                variant: :outline,
                size: :sm,
                href: reauthorize_truelayer_item_path(truelayer_item),
                method: :post,
                data: { turbo: false }
              ) %>
            <% end %>
            <% if Rails.env.development? %>
              <%= icon(
                "refresh-cw",
                as_button: true,
                href: sync_truelayer_item_path(truelayer_item)
              ) %>
            <% end %>

            <%= render DS::Menu.new do |menu| %>
              <% menu.with_item(
                variant: "button",
                text: t(".delete"),
                icon: "trash-2",
                href: truelayer_item_path(truelayer_item),
                method: :delete,
                confirm: CustomConfirm.for_resource_deletion(truelayer_item.name, high_severity: true)
              ) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% unless truelayer_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if visible_accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: visible_accounts %>
        <% end %>

        <%# Sync summary (collapsible) - using shared ProviderSyncSummary component %>
        <% stats = if defined?(@truelayer_sync_stats_map) && @truelayer_sync_stats_map
             @truelayer_sync_stats_map[truelayer_item.id] || {}
           else
             truelayer_item.syncs.ordered.first&.sync_stats || {}
           end %>
        <%= render ProviderSyncSummary.new(
          stats: stats,
          provider_item: truelayer_item, show_account_details: visible_accounts.size == truelayer_item.accounts.size,
          institutions_count: 1
        ) %>

        <%# Use model methods for consistent counts %>
        <% unlinked_count = truelayer_item.unlinked_accounts_count %>
        <% linked_count = truelayer_item.linked_accounts_count %>
        <% total_count = truelayer_item.total_accounts_count %>

        <% if unlinked_count > 0 %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".setup_needed") %></p>
            <p class="text-secondary text-sm"><%= t(".setup_description", linked: linked_count, total: total_count) %></p>
            <%= render DS::Link.new(
              text: t(".setup_action"),
              icon: "settings",
              variant: "primary",
              href: setup_accounts_truelayer_item_path(truelayer_item),
              frame: :modal
            ) %>
          </div>
        <% elsif truelayer_item.accounts.empty? && total_count == 0 %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".no_accounts_title") %></p>
            <p class="text-secondary text-sm"><%= t(".no_accounts_description") %></p>
            <%= render DS::Link.new(
              text: t(".setup_action"),
              icon: "settings",
              variant: "primary",
              href: setup_accounts_truelayer_item_path(truelayer_item),
              frame: :modal
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
