<%# locals: (form:) %>

<% if preview_features_enabled? %>
  <%= form.text_field :custom_group,
      label: Current.user.custom_account_group_label,
      placeholder: t("accounts.form.custom_group_placeholder"),
      maxlength: AccountGrouping::CUSTOM_GROUP_MAX_LENGTH,
      list: "account_custom_group_suggestions",
      autocomplete: "off" %>
  <datalist id="account_custom_group_suggestions">
    <% account_custom_group_suggestions.each do |suggestion| %>
      <option value="<%= suggestion %>"></option>
    <% end %>
  </datalist>
<% end %>
