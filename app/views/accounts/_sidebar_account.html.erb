<%# locals: (account:, color:, copy:, link_class: nil) %>
<%# copy: the id of the sidebar copy (tab panel or mobile) this row sits in,
    so the permanent wrappers below get ids unique across copies. %>

<%= link_to account_path(account),
          class: class_names(
            "block flex items-center gap-2 px-3 py-2 rounded-lg",
            link_class,
            page_active?(account_path(account)) ? "bg-container" : "hover:bg-surface-hover"
          ),
          data: page_active?(account_path(account)) ? { active_account: true } : {},
          title: account.name do %>
  <%= tag.span id: sidebar_logo_wrapper_id(copy, account, color), class: "shrink-0", data: kept_element_data do %>
    <%= render "accounts/logo", account: account, size: "sm", color: color %>
  <% end %>

  <div class="min-w-0 grow">
    <div class="flex items-center gap-2 mb-0.5">
      <%= tag.p account.name, class: class_names("text-sm text-primary font-medium truncate", "animate-pulse" => account.syncing?) %>
      <% if account.shared? %>
        <%= icon("users", class: "w-3 h-3 text-secondary shrink-0") %>
      <% end %>
    </div>
    <%= tag.p account.short_subtype_label, class: "text-sm text-secondary truncate" %>
  </div>

  <div class="ml-auto text-right grow h-10">
    <%= tag.p format_money(account.balance_money), class: "text-sm font-medium text-primary whitespace-nowrap privacy-sensitive" %>
    <% account_version = sidebar_sparkline_versions(Current.family)[account.id] %>
    <%= tag.div id: sidebar_sparkline_wrapper_id(copy, account.id, account_version), data: kept_element_data do %>
      <%= turbo_frame_tag dom_id(account, :sparkline),
                          src: sparkline_account_path(account, v: account_version),
                          loading: "lazy",
                          data: sparkline_frame_data do %>
        <div class="flex items-center w-8 h-4 ml-auto">
          <div class="w-6 h-px bg-loader"></div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
