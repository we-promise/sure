<%# locals: (account_group:, mobile: false, all_tab: false, open: nil, sortable: false, **args) %>

<div id="<%= account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile) %>" data-group-key="<%= account_group.key %>">
  <% is_open = open.nil? ? (account_group.accounts.any? { |account| page_active?(account_path(account)) } || Current.user.always_expanded_account_group?(account_group.key)) : open %>
  <%= render DS::Disclosure.new(align: :left, open: is_open) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center gap-3">
        <%= icon "chevron-right", class: "[details[open]>summary_&]:rotate-90 motion-safe:transition-transform" %>
        <%= tag.span class: class_names("text-sm text-primary font-medium", "animate-pulse" => account_group.syncing?) do %>
          <%= account_group.name %>
        <% end %>
      </div>

      <div class="ml-auto text-right grow">
        <%= tag.p format_money(account_group.total_money), class: "text-sm font-medium text-primary privacy-sensitive" %>
        <%= turbo_frame_tag "#{account_group.key}_sparkline",
                            src: accountable_sparkline_path(account_group.key),
                            loading: "lazy",
                            data: sparkline_frame_data do %>
          <div class="flex items-center w-8 h-4 ml-auto">
            <div class="w-6 h-px bg-loader"></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if sortable %>
      <%= tag.div class: "space-y-1",
            data: sortable ? {
              controller: "sortable-list",
              sortable_list_url_value: reorder_accounts_path(group: account_group.key),
              sortable_list_param_value: "account_ids",
              sortable_list_hold_delay_value: 400,
              sortable_list_save_timeout_value: 10_000,
              sortable_list_mirror_lists_value: true,
              action: "dragover->sortable-list#dragOver drop->sortable-list#drop account-sort-mode:stop@window->sortable-list#releaseKeyboardGrab turbo:before-visit@window->sortable-list#saveBeforeVisit"
            } : {} do %>
        <%= render partial: "accounts/sidebar_account", collection: account_group.accounts, as: :account, locals: { color: account_group.color, sortable: true } %>
      <% end %>
    <% else %>
      <div class="space-y-2">
        <% account_group.institution_groups.each do |institution_group| %>
          <% if institution_group.name.present? %>
            <% institution_open = institution_group.accounts.any? { |account| page_active?(account_path(account)) } || Current.user.always_expanded_account_group?(account_group.key) || open == true %>
            <%= render DS::Disclosure.new(
              open: institution_open,
              class: "rounded-xl border border-primary",
              summary_class: "flex items-center gap-2 px-3 py-2 rounded-xl cursor-pointer focus-ring min-h-11 hover:bg-surface-hover",
              body_class: "ml-3 pl-2 pb-2 border-l border-primary",
              data: { institution_group: institution_group.name }
            ) do |institution_disclosure| %>
              <% institution_disclosure.with_summary_content do %>
                <%= icon "chevron-right", class: "shrink-0 [details[open]>summary_&]:rotate-90 motion-safe:transition-transform" %>
                <div class="min-w-0 flex-1">
                  <%= tag.p institution_group.name, class: "text-sm font-medium text-primary truncate" %>
                  <%= tag.p t("accounts.sidebar.account_count", count: institution_group.accounts.size), class: "text-xs text-secondary" %>
                </div>
                <%= tag.p format_money(institution_group.total_money), class: "shrink-0 text-sm font-medium text-primary whitespace-nowrap privacy-sensitive" %>
              <% end %>

              <div class="space-y-1">
                <%= render partial: "accounts/sidebar_account", collection: institution_group.accounts, as: :account, locals: { color: account_group.color } %>
              </div>
            <% end %>
          <% else %>
            <%= render partial: "accounts/sidebar_account", collection: institution_group.accounts, as: :account, locals: { color: account_group.color } %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="my-2">
      <%= render DS::Link.new(
      href: new_polymorphic_path(account_group.key, step: "method_select"),
      text: t("accounts.sidebar.new_account_group", account_group: account_group.accountable_type.singular_display_name.downcase),
      icon: "plus",
      full_width: true,
      variant: "ghost",
      frame: :modal,
      class: "justify-start"
    ) %>
    </div>
  <% end %>
</div>
