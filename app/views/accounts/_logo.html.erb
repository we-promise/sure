<%# locals: (account:, size: "md", color: nil) %>

<% size_classes = {
  "sm" => "w-6 h-6",
  "md" => "w-9 h-9",
  "lg" => "w-10 h-10",
  "full" => "w-full h-full"
} %>

<%= render DS::Logo.new(src: account.logo_url, name: account.name,
      class_name: size_classes[size], color: color || account.accountable&.color) %>
