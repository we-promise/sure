<%# locals: (account:, size: "md", color: nil, url: account.logo_url) %>

<% size_classes = {
  "sm" => "w-6 h-6",
  "md" => "w-9 h-9",
  "lg" => "w-10 h-10",
  "full" => "w-full h-full"
} %>

<% initials = capture do %>
  <%= render DS::FilledIcon.new(
        variant: :text,
        hex_color: color || account.accountable&.color,
        text: account.name.to_s,
        size: size,
        rounded: true
      ) %>
<% end %>

<% if url.present? %>
  <%# A logo the browser cannot show (an upload whose file is gone, a dead
      favicon or Brandfetch URL) gives way to the initials, which are already
      in the page, so the swap needs no other request. %>
  <%= tag.span class: "inline-flex items-center justify-center shrink-0 #{size_classes[size]}", data: { controller: "image-fallback" } do %>
    <%= image_tag url,
          class: "w-full h-full rounded-full object-contain",
          loading: "lazy",
          data: { image_fallback_target: "image",
                  action: "error->image-fallback#showFallback load->image-fallback#showImage" } %>
    <%= tag.span initials, class: "hidden", data: { image_fallback_target: "fallback" } %>
  <% end %>
<% else %>
  <%= initials %>
<% end %>
