<%= content_for :page_title, t(".accounts") %>
<%= content_for :page_actions do %>
  <%= render "accounts/sync_controls", family: Current.family %>
  <%= render DS::Link.new(
    text: t(".new_account"),
    href: new_account_path(return_to: accounts_path),
    variant: "primary",
    icon: "plus",
    frame: :modal
  ) %>
<% end %>

<% if @manual_accounts.empty? && @financekit_accounts.empty? && @plaid_items.empty? && @simplefin_items.empty? && @lunchflow_items.empty? && @redbark_items.empty? && @akahu_items.empty? && @up_items.empty? && @monobank_items.empty? && @fio_items.empty? && @enable_banking_items.empty? && @coinstats_items.empty? && @coinbase_items.empty? && @mercury_items.empty? && @brex_items.empty? && @ibkr_items.empty? && @snaptrade_items.empty? && @indexa_capital_items.empty? && @sophtron_items.empty? && @binance_items.empty? && @kraken_items.empty? && @coinspot_items.empty? && @questrade_items.empty? && @wise_items.empty? && @onchain_wallet_items.empty? && @trade_republic_items.empty? && @trading212_items.empty? %>
  <%= render "empty" %>
<% else %>
  <div class="space-y-2">
    <% if @financekit_accounts.any? %>
      <%= render "accounts/index/financekit_accounts", accounts: @financekit_accounts %>
    <% end %>

    <% if @plaid_items.any? %>
      <% @plaid_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @simplefin_items.any? %>
      <% @simplefin_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @lunchflow_items.any? %>
      <% @lunchflow_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @redbark_items.any? %>
      <% @redbark_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @akahu_items.any? %>
      <% @akahu_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @up_items.any? %>
      <% @up_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @monobank_items.any? %>
      <% @monobank_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @enable_banking_items.any? %>
      <% @enable_banking_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @coinstats_items.any? %>
      <% @coinstats_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @onchain_wallet_items.any? %>
      <%# Rendered by name rather than as a collection: the model's default
          partial is the provider settings row, and this is the accounts card. %>
      <% @onchain_wallet_items.sort_by(&:created_at).each do |onchain_wallet_item| %>
        <%= render "onchain_wallet_items/wallet_card",
                   onchain_wallet_item: onchain_wallet_item,
                   card: @onchain_wallet_cards.fetch(onchain_wallet_item.id) %>
      <% end %>
    <% end %>

    <% if @sophtron_items.any? %>
      <% @sophtron_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @mercury_items.any? %>
      <% @mercury_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @brex_items.any? %>
      <% @brex_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @coinbase_items.any? %>
      <% @coinbase_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @binance_items.any? %>
      <% @binance_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @kraken_items.any? %>
      <% @kraken_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @coinspot_items.any? %>
      <% @coinspot_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @trading212_items.any? %>
      <% @trading212_items.each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @wise_items.any? %>
      <% @wise_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @trade_republic_items.any? %>
      <% @trade_republic_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @snaptrade_items.any? %>
      <% @snaptrade_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @ibkr_items.any? %>
      <% @ibkr_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @indexa_capital_items.any? %>
      <% @indexa_capital_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @questrade_items.any? %>
      <% @questrade_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @fio_items.any? %>
      <% @fio_items.sort_by(&:created_at).each do |item| %>
        <%= render item, visible_accounts: visible_card_accounts(item) %>
      <% end %>
    <% end %>

    <% if @manual_accounts.any? %>
      <div id="manual-accounts">
        <%= render "accounts/index/manual_accounts", accounts: @manual_accounts %>
      </div>
    <% else %>
      <div id="manual-accounts"></div>
    <% end %>
  </div>
<% end %>
