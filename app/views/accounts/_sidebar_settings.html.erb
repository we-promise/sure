<%# locals: (has_groups:) %>

<%# Settings menu of the account sidebar: expand/collapse all groups, the
    account sort order, custom (drag) ordering, and hiding accounts. %>
<% current_order = Current.user&.account_order&.key || "name_asc" %>
<% hidden_count = Current.user&.sidebar_hidden_account_ids&.size.to_i %>

<%= render DS::Popover.new(variant: "button", placement: "bottom-end", mobile_fullwidth: false) do |popover| %>
  <% popover.with_button(
    variant: :outline,
    size: :md,
    icon: "settings-2",
    class: "shrink-0",
    title: t("accounts.sidebar.settings.title"),
    aria: { label: t("accounts.sidebar.settings.title") },
    data: { account_sort_mode_target: "toggle" }
  ) %>

  <% popover.with_custom_content do %>
    <div class="w-64 p-1 space-y-1">
      <% if has_groups %>
        <div class="flex gap-1 p-1">
          <%= render DS::Button.new(
            variant: :outline,
            size: :sm,
            icon: "chevrons-up-down",
            text: t("accounts.sidebar.expand_all"),
            class: "flex-1 justify-center",
            data: { account_sort_mode_open_param: "true", action: "account-sort-mode#setGroupsOpen DS--popover#close" }
          ) %>
          <%= render DS::Button.new(
            variant: :outline,
            size: :sm,
            icon: "chevrons-down-up",
            text: t("accounts.sidebar.collapse_all"),
            class: "flex-1 justify-center",
            data: { account_sort_mode_open_param: "false", action: "account-sort-mode#setGroupsOpen DS--popover#close" }
          ) %>
        </div>

        <%= render "shared/ruler", classes: "my-1" %>
      <% end %>

      <p class="px-2 pt-1 pb-0.5 text-xs font-medium text-secondary"><%= t("accounts.sidebar.settings.sort_by") %></p>
      <%# Sorting happens in place (account-sort-mode#setOrder) and is saved in
          the background, so open groups stay open. The script moves the
          check and shows the reorder item with inline display, for the same
          reason as the sort-mode handles (precompiled CSS). %>
      <% %w[name_asc name_desc balance_desc balance_asc manual].each do |order_key| %>
        <%= render DS::MenuItem.new(
          variant: :action,
          text: t("accounts.sidebar.settings.orders.#{order_key}"),
          selected: current_order == order_key,
          roving: false,
          data: {
            account_sort_mode_target: "orderOption",
            order: order_key,
            account_sort_mode_order_param: order_key,
            action: "account-sort-mode#setOrder DS--popover#close"
          }
        ) %>
      <% end %>

      <% if has_groups %>
        <%= render DS::MenuItem.new(
          variant: :action,
          text: t("accounts.sidebar.settings.reorder"),
          icon: "grip-vertical",
          roving: false,
          style: ("display:none" unless current_order == "manual"),
          data: { account_sort_mode_target: "reorderItem", action: "account-sort-mode#start DS--popover#close" }
        ) %>
      <% end %>

      <%= render "shared/ruler", classes: "my-1" %>

      <%= render DS::MenuItem.new(
        variant: :link,
        text: hidden_count.positive? ? t("accounts.sidebar.settings.hide_accounts_count", count: hidden_count) : t("accounts.sidebar.settings.hide_accounts"),
        icon: "eye-off",
        href: sidebar_visibility_accounts_path,
        frame: :modal,
        roving: false
      ) %>
    </div>
  <% end %>
<% end %>
