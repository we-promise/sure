<%# locals: (account:) %>

<%= render DS::Tooltip.new(placement: "right", offset: 10, cross_axis: 50) do %>
  <div>
    <%= t(".description") %>
  </div>
  <div class="flex pt-3">
    <div class="opacity-70">
      <%= t(".current") %>
    </div>
    <div class="ml-auto privacy-sensitive">
      <%= format_money(account.balance_money, precision: 0) %>
    </div>
  </div>
  <div class="flex">
    <div class="opacity-70">
      <%= t(".scheduled") %>
    </div>
    <div class="ml-auto privacy-sensitive">
      <%= "#{'+' if account.scheduled_entries_total_money.amount.positive?}#{format_money(account.scheduled_entries_total_money, precision: 0)}" %>
    </div>
  </div>

  <hr class="my-2 border-inverse">

  <div class="flex">
    <div class="font-bold opacity-70">
      <%= t(".projected") %>
    </div>
    <div class="font-bold ml-auto privacy-sensitive">
      <%= format_money(account.projected_balance_money, precision: 0) %>
    </div>
  </div>
<% end %>
