<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: t(".title")) %>

    <% dialog.with_body do %>
      <% if @available_etoro_accounts.blank? %>
        <div class="p-4 text-sm text-secondary">
          <p class="mb-2"><%= t(".no_accounts_available") %></p>
          <ul class="list-disc list-inside space-y-1">
            <li><%= t(".run_sync_hint") %></li>
            <li><%= t(".wait_for_sync") %></li>
          </ul>
        </div>
      <% else %>
        <%= form_with url: link_existing_account_etoro_items_path, method: :post, data: { turbo_frame: "_top" }, class: "space-y-4" do %>
          <%= hidden_field_tag :account_id, @account.id %>
          <div class="space-y-2 max-h-64 overflow-auto">
            <% @available_etoro_accounts.each do |etoro_account| %>
              <label class="flex items-center gap-3 p-2 rounded border border-secondary hover:border-primary cursor-pointer">
                <%= radio_button_tag :etoro_account_id, etoro_account.id, false %>
                <div class="flex flex-col">
                  <span class="text-sm text-primary font-medium"><%= etoro_account.name.presence || etoro_account.etoro_account_id %></span>
                  <span class="text-xs text-secondary">
                    <%= t(
                      ".account_summary",
                      currency: etoro_account.currency,
                      balance: number_to_currency(etoro_account.current_balance || 0, unit: Money::Currency.new(etoro_account.currency.presence || Current.family.currency).symbol)
                    ) %>
                  </span>
                </div>
              </label>
            <% end %>
          </div>

          <div class="flex items-center justify-end gap-2">
            <%= render DS::Link.new(text: t(".cancel"), variant: :secondary, href: accounts_path, data: { turbo_frame: "_top" }) %>
            <%= render DS::Button.new(text: t(".link"), variant: :primary, icon: "link-2", type: :submit) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
