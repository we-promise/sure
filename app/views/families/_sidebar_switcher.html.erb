<%# locals: (user:) %>

<% family_options = user.available_families %>
<% current_family = user.active_family(Current.session) %>
<% current_family_name = current_family&.name.presence || t("families.default_name") %>

<div id="family-sidebar-switcher" class="mb-4">
  <%= render DS::Popover.new(placement: "bottom-start", no_padding: true, max_width: "w-64", aria_label: t("families.sidebar_title")) do |popover| %>
    <% popover.with_button(class: "w-full flex items-center justify-between p-2 -mx-2 rounded-xl hover:bg-surface-inset focus-ring transition-colors group bg-transparent border-0") do %>
      <div class="flex flex-col items-start min-w-0">
        <span class="text-[10px] uppercase tracking-wider text-secondary font-medium leading-tight mb-0.5">
          <%= t("families.current_ledger") %>
        </span>
        <span class="text-sm font-semibold text-primary truncate w-full text-left">
          <%= current_family_name %>
        </span>
      </div>
      <%= render DS::Pill.new(label: t("families.switch"), tone: :neutral, marker: false, show_dot: false) %>
    <% end %>

    <% popover.with_custom_content do %>
      <div class="p-1.5 max-h-[50vh] overflow-y-auto space-y-0.5">
        <p class="px-2 py-1.5 text-xs font-semibold text-secondary uppercase tracking-wider"><%= t("families.sidebar_title") %></p>
        
        <% family_options.each do |family| %>
          <% is_active = current_family.id == family.id %>
          <% family_name = family.name.presence || t("families.default_name") %>
          
          <%= button_to current_session_path, method: :put, params: { current_session: { active_family_id: family.id } }, class: "w-full text-left focus-ring rounded-lg" do %>
            <div class="flex items-center gap-2 px-2 py-2 rounded-lg <%= is_active ? 'bg-container-inset-hover' : 'hover:bg-surface-hover' %>" title="<%= family_name %>">
              <div class="w-6 h-6 rounded bg-primary text-inverse flex items-center justify-center text-xs font-semibold shrink-0">
                <%= family_name.first.upcase %>
              </div>

              <div class="min-w-0 grow">
                <%= tag.p family_name, class: "text-sm text-primary font-medium truncate" %>
              </div>
              
              <% if is_active %>
                <div class="ml-auto text-right shrink-0">
                  <%= render DS::Pill.new(label: t("families.active"), tone: :info, marker: true, show_dot: false) %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
      
      <div class="p-1.5 border-t border-tertiary">
        <%= render DS::MenuItem.new(
          text: t("users.user_menu.create_ledger"),
          variant: "link",
          href: new_family_path,
          frame: :modal
        ) %>
      </div>
    <% end %>
  <% end %>
</div>
