<%# Shadow mode exists so an operator can look at real disagreements before
    switching provider. Leaving that in the database means reaching for a Rails
    console, which defeats the point — so the summary lives here. %>
<%
  comparisons = Current.family.ai_comparisons.for_feature(:categorize)
  sampled = comparisons.count
  agreement = comparisons.agreement_rate
  recent_disagreements = comparisons.disagreements.order(created_at: :desc).limit(5).to_a
  names = Ai::Comparison.category_names(recent_disagreements, Current.family)
%>

<%= render DS::Note.new(title: t(".shadow_results_heading")) do %>
  <% if sampled.zero? %>
    <%# Not "0% agreement": no data and total disagreement look identical in a
        bare percentage, and they mean opposite things. %>
    <p><%= t(".shadow_results_empty") %></p>
  <% else %>
    <p><%= t(".shadow_results_summary", agreement: agreement, count: sampled) %></p>

    <% if recent_disagreements.any? %>
      <p class="font-medium text-primary pt-1"><%= t(".shadow_disagreements_heading") %></p>
      <ul class="space-y-1">
        <% recent_disagreements.each do |comparison| %>
          <li>
            <%= t(".shadow_disagreement_row",
                  applied_provider: comparison.primary_endpoint,
                  applied_category: comparison.category_name(:primary, names) || t(".shadow_no_category"),
                  shadow_provider: comparison.shadow_endpoint,
                  shadow_category: comparison.category_name(:shadow, names) || t(".shadow_no_category")) %>
            <% if comparison.shadow_confidence.present? %>
              <%= t(".shadow_disagreement_confidence", confidence: number_with_precision(comparison.shadow_confidence, precision: 2)) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p><%= t(".shadow_no_disagreements") %></p>
    <% end %>
  <% end %>
<% end %>
