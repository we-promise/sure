<div class="space-y-4">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <h2 class="font-medium"><%= t(".title") %></h2>
      <%= render DS::Pill.new(label: t(".preview_pill")) %>
    </div>
    <% if ENV["JEV_API_KEY"].present? %>
      <p class="text-sm text-secondary"><%= t(".env_configured_message") %></p>
    <% else %>
      <p class="text-secondary text-sm"><%= t(".description") %></p>
    <% end %>
    <%# Configuring a key is not enough on its own: Family::AutoCategorizer only
        reaches Jev for families with an opted-in member. Without this line an
        admin sees the key save and nothing happen, with no way to tell why. %>
    <p class="text-secondary text-sm mt-2 mb-4"><%= t(".preview_requirement") %></p>
  </div>

  <%= styled_form_with model: Setting.new,
                       url: settings_hosting_path,
                       method: :patch,
                       class: "space-y-4",
                       data: {
                         controller: "auto-submit-form",
                         "auto-submit-form-trigger-event-value": "blur"
                       } do |form| %>
    <%= form.password_field :jev_api_key,
                            label: t(".api_key_label"),
                            placeholder: t(".api_key_placeholder"),
                            value: (Setting.jev_api_key.present? ? "********" : nil),
                            autocomplete: "off",
                            autocapitalize: "none",
                            spellcheck: "false",
                            inputmode: "text",
                            disabled: ENV["JEV_API_KEY"].present?,
                            data: { "auto-submit-form-target": "auto" } %>

    <%= form.text_field :jev_endpoint,
                        label: t(".endpoint_label"),
                        placeholder: t(".endpoint_placeholder"),
                        value: @jev_endpoint_input || Setting.jev_endpoint,
                        autocomplete: "off",
                        autocapitalize: "none",
                        spellcheck: "false",
                        inputmode: "url",
                        disabled: ENV["JEV_ENDPOINT"].present?,
                        data: { "auto-submit-form-target": "auto" } %>

    <%= form.text_field :jev_model,
                        label: t(".model_label"),
                        placeholder: t(".model_placeholder"),
                        value: @jev_model_input || Setting.jev_model,
                        autocomplete: "off",
                        autocapitalize: "none",
                        spellcheck: "false",
                        inputmode: "text",
                        disabled: ENV["JEV_MODEL"].present?,
                        data: { "auto-submit-form-target": "auto" } %>
    <p class="text-xs text-secondary mt-1"><%= t(".model_help") %></p>
  <% end %>
</div>
