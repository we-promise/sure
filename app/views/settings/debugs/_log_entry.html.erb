<tr class="group" data-controller="expandable">
  <td class="px-4 py-3 text-sm text-primary whitespace-nowrap align-top"><%= l(entry.created_at, format: :long) %></td>
  <td class="px-4 py-3 text-sm text-primary whitespace-nowrap align-top"><%= entry.level %></td>
  <td class="px-4 py-3 text-sm text-primary whitespace-nowrap align-top"><%= entry.category %></td>
  <td class="px-4 py-3 text-sm text-primary font-mono align-top"><%= entry.source %></td>
  <td class="px-4 py-3 text-sm text-primary align-top"><%= entry.message %></td>
  <td class="px-4 py-3 text-xs text-secondary font-mono whitespace-nowrap align-top">
    <div><%= t("settings.debugs.show.context.provider", value: entry.provider_key.presence || t("settings.debugs.show.missing_value")) %></div>
    <div><%= t("settings.debugs.show.context.family", value: entry.family_id || t("settings.debugs.show.missing_value")) %></div>
    <div><%= t("settings.debugs.show.context.account", value: entry.account_id || t("settings.debugs.show.missing_value")) %></div>
    <div><%= t("settings.debugs.show.context.user", value: entry.user_id || t("settings.debugs.show.missing_value")) %></div>
    <div><%= t("settings.debugs.show.context.account_provider", value: entry.account_provider_id || t("settings.debugs.show.missing_value")) %></div>
  </td>
  <td class="px-4 py-3 text-xs text-secondary align-top">
    <% if entry.metadata.present? %>
      <%= render DS::Disclosure.new(variant: :inline) do |disclosure| %>
        <% disclosure.with_summary_content do %>
          <span class="text-xs text-secondary"><%= t("settings.debugs.show.table.view_metadata") %></span>
        <% end %>
        <pre class="whitespace-pre-wrap break-words"><%= JSON.pretty_generate(entry.metadata) %></pre>
      <% end %>
    <% else %>
      <%= t("settings.debugs.show.missing_value") %>
    <% end %>
  </td>
  <td class="px-4 py-3 w-px align-top">
    <%# Desktop reveals the expand affordance on row hover (and on keyboard
        focus, since an opacity-0 button is still tabbable); touch devices have
        no hover state, so it stays visible below `lg`. %>
    <%= render DS::Button.new(
          variant: "icon",
          size: :sm,
          icon: "maximize-2",
          title: t("global.expand"),
          aria_label: t("global.expand"),
          class: "opacity-100 lg:opacity-0 lg:group-hover:opacity-100 focus-visible:opacity-100 transition-opacity",
          data: { action: "click->expandable#open" }
        ) %>

    <%= render DS::Dialog.new(
          auto_open: false,
          disable_frame: true,
          width: "custom",
          content_class: "max-w-[900px]",
          data: { expandable_target: "dialog" }
        ) do |dialog| %>
      <% dialog.with_header(
           title: t("settings.debugs.show.details.title"),
           subtitle: l(entry.created_at, format: :long)
         ) %>
      <% dialog.with_body do %>
        <div class="space-y-5">
          <div class="flex flex-wrap items-center gap-2">
            <%= render DS::Pill.new(label: entry.level, tone: debug_log_level_tone(entry.level), marker: false, size: :md) %>
            <%= render DS::Pill.new(label: entry.category, tone: :neutral, marker: false, size: :md) %>
          </div>

          <div>
            <h3 class="text-xs font-medium text-secondary uppercase mb-1"><%= t("settings.debugs.show.table.message") %></h3>
            <p class="text-sm text-primary whitespace-pre-wrap break-words"><%= entry.message %></p>
          </div>

          <div>
            <h3 class="text-xs font-medium text-secondary uppercase mb-1"><%= t("settings.debugs.show.table.source") %></h3>
            <p class="text-sm text-primary font-mono break-all"><%= entry.source %></p>
          </div>

          <div>
            <h3 class="text-xs font-medium text-secondary uppercase mb-2"><%= t("settings.debugs.show.table.context") %></h3>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
              <% debug_log_context_fields(entry).each do |label, value| %>
                <div class="min-w-0">
                  <dt class="text-xs text-secondary"><%= label %></dt>
                  <dd class="text-sm text-primary font-mono break-all"><%= value %></dd>
                </div>
              <% end %>
            </dl>
          </div>

          <div>
            <h3 class="text-xs font-medium text-secondary uppercase mb-2"><%= t("settings.debugs.show.table.metadata") %></h3>
            <% if entry.metadata.present? %>
              <pre class="bg-container-inset rounded-lg p-3 text-xs text-primary font-mono whitespace-pre-wrap break-words max-h-[45dvh] overflow-y-auto overscroll-contain"><%= JSON.pretty_generate(entry.metadata) %></pre>
            <% else %>
              <p class="text-sm text-secondary"><%= t("settings.debugs.show.details.no_metadata") %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </td>
</tr>
