<div id="ca-auto-bank-providers-panel" class="space-y-4">
  <%= render DS::Pill.new(label: t("ca_auto_bank.preview"), tone: :violet, marker: false) %>
  <p class="text-sm text-secondary"><%= t("ca_auto_bank.connection_description") %></p>
  <p class="text-sm text-secondary"><%= t("ca_auto_bank.session_limit") %></p>
  <% if @ca_auto_bank_item %>
    <%= render "ca_auto_bank_items/status", item: @ca_auto_bank_item %>
  <% end %>
  <div class="flex flex-wrap justify-end gap-2">
    <% if @ca_auto_bank_item&.ready_for_sync? %>
      <%= render DS::Button.new(text: t("ca_auto_bank.sync.action"), icon: "refresh-cw", variant: :secondary,
                               href: sync_ca_auto_bank_item_path(@ca_auto_bank_item),
                               disabled: @ca_auto_bank_item.syncing? || @ca_auto_bank_item.sync_cooldown?) %>
    <% end %>
    <%= render DS::Link.new(text: t(@ca_auto_bank_item&.session_configured? ? "ca_auto_bank.manage" : "ca_auto_bank.connect"),
                           href: ca_auto_bank_login_path, frame: :_top) %>
    <% if @ca_auto_bank_item&.authentication_token.present? %>
      <%= render DS::Menu.new do |menu| %>
        <% menu.with_item(variant: "button", text: t("ca_auto_bank.disconnect"), icon: "pause",
                          href: ca_auto_bank_item_path(@ca_auto_bank_item), method: :delete,
                          confirm: t("ca_auto_bank.disconnect_confirmation")) %>
      <% end %>
    <% end %>
  </div>
</div>
