<div id="coinspot-providers-panel" class="space-y-4">
  <% items = local_assigns[:coinspot_items] || @coinspot_items || Current.family.coinspot_items.active.ordered %>

  <%= render DS::Alert.new(
        variant: :warning,
        message: safe_join([
          content_tag(:p, t("settings.providers.coinspot_panel.read_only_title"), class: "font-medium"),
          content_tag(:p, t("settings.providers.coinspot_panel.read_only_body"), class: "mt-1")
        ])
      ) %>

  <%= render "settings/providers/setup_steps",
             steps: [
               t("settings.providers.coinspot_panel.step1_html").html_safe,
               t("settings.providers.coinspot_panel.step2"),
               t("settings.providers.coinspot_panel.step3")
             ] %>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <%= render DS::Alert.new(message: error_msg, variant: :error) %>
  <% end %>

  <% if items.any? %>
    <div class="space-y-3">
      <% items.each do |item| %>
        <%= render DS::Disclosure.new(variant: :card) do |disclosure| %>
          <% disclosure.with_summary_content do %>
            <div class="flex items-center justify-between gap-3 w-full">
              <div class="flex items-center gap-3 min-w-0">
                <div class="flex items-center justify-center h-8 w-8 rounded-full bg-surface-inset">
                  <%= icon "coins", size: "sm", class: "text-primary" %>
                </div>
                <div class="min-w-0">
                  <p class="font-medium text-primary truncate"><%= item.name %></p>
                  <p class="text-xs text-secondary">
                    <% if item.syncing? %>
                      <%= t("settings.providers.coinspot_panel.syncing") %>
                    <% else %>
                      <%= item.sync_status_summary %>
                    <% end %>
                  </p>
                </div>
              </div>
            </div>
          <% end %>

          <div class="mt-4 space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <%= render DS::Button.new(
                text: t("settings.providers.coinspot_panel.sync"),
                icon: "refresh-cw",
                variant: :outline,
                size: :sm,
                href: sync_coinspot_item_path(item),
                method: :post,
                disabled: item.syncing?
              ) %>

              <%= render DS::Link.new(
                text: t("settings.providers.coinspot_panel.setup_accounts"),
                icon: "settings",
                variant: "secondary",
                href: setup_accounts_coinspot_item_path(item),
                frame: :modal
              ) %>

              <%= render DS::Button.new(
                text: t("settings.providers.coinspot_panel.disconnect"),
                icon: "trash-2",
                variant: :outline_destructive,
                size: :sm,
                href: coinspot_item_path(item),
                method: :delete,
                confirm: t("settings.providers.coinspot_panel.disconnect_confirm", name: item.name)
              ) %>
            </div>

            <%= styled_form_with model: item,
                                 url: coinspot_item_path(item),
                                 scope: :coinspot_item,
                                 method: :patch,
                                 data: { turbo: true },
                                 class: "space-y-3" do |form| %>
              <%= form.text_field :name,
                                  label: t("settings.providers.coinspot_panel.connection_name_label"),
                                  placeholder: t("settings.providers.coinspot_panel.connection_name_placeholder") %>

              <%= form.text_field :api_key,
                                  label: t("settings.providers.coinspot_panel.api_key_label"),
                                  placeholder: t("settings.providers.coinspot_panel.keep_api_key_placeholder"),
                                  type: :password,
                                  value: nil %>

              <%= form.text_field :api_secret,
                                  label: t("settings.providers.coinspot_panel.api_secret_label"),
                                  placeholder: t("settings.providers.coinspot_panel.keep_api_secret_placeholder"),
                                  type: :password,
                                  value: nil %>

              <div class="flex justify-end">
                <%= form.submit t("settings.providers.coinspot_panel.update_connection") %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% coinspot_item = Current.family.coinspot_items.build(name: t("settings.providers.coinspot_panel.default_connection_name")) %>
  <% if items.any? %>
    <h3 class="flex items-center gap-2 text-sm font-medium text-primary mt-4">
      <%= icon "plus", size: "sm" %>
      <%= t("settings.providers.coinspot_panel.add_connection") %>
    </h3>
  <% end %>

  <%= styled_form_with model: coinspot_item,
                       url: coinspot_items_path,
                       scope: :coinspot_item,
                       method: :post,
                       data: { turbo: true },
                       class: "space-y-3" do |form| %>
    <%= form.text_field :name,
                        label: t("settings.providers.coinspot_panel.connection_name_label"),
                        placeholder: t("settings.providers.coinspot_panel.connection_name_placeholder") %>

    <%= form.text_field :api_key,
                        label: t("settings.providers.coinspot_panel.api_key_label"),
                        placeholder: t("settings.providers.coinspot_panel.api_key_placeholder"),
                        type: :password,
                        value: nil %>

    <%= form.text_field :api_secret,
                        label: t("settings.providers.coinspot_panel.api_secret_label"),
                        placeholder: t("settings.providers.coinspot_panel.api_secret_placeholder"),
                        type: :password,
                        value: nil %>

    <div class="flex justify-end">
      <%= form.submit t("settings.providers.coinspot_panel.add_connection") %>
    </div>
  <% end %>
</div>
