<%= render ProviderItem::PanelComponent.new(
      items: local_assigns[:mercury_items] || @mercury_items || Current.family.mercury_items.active.ordered,
      new_item: Current.family.mercury_items.build(name: t("mercury_items.provider_panel.default_connection_name")),
      error_message: local_assigns[:error_message] || @error_message,
      variant: :classic
    ) do |panel| %>
  <% panel.with_setup_steps do %>
    <%= render "settings/providers/setup_steps",
               steps: [
                 t("mercury_items.provider_panel.instructions.sign_in_html", link: link_to("Mercury", "https://mercury.com", target: "_blank", rel: "noopener noreferrer", class: "text-link underline")),
                 t("mercury_items.provider_panel.instructions.open_tokens"),
                 t("mercury_items.provider_panel.instructions.create_token"),
                 t("mercury_items.provider_panel.instructions.whitelist_ip_html"),
                 t("mercury_items.provider_panel.instructions.copy_token_html")
               ] %>
  <% end %>
<% end %>
