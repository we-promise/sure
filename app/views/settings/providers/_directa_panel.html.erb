<div id="directa-providers-panel" class="space-y-4">
  <%= render DS::Pill.new(label: t(".preview"), tone: :violet, marker: false) %>

  <% sync_status = BankSyncStatusPresenter.new(item: @directa_item, provider_key: :directa) if @directa_item %>

  <div class="space-y-2 text-sm text-secondary">
    <p><%= t(".description") %></p>
    <p><%= t(".read_only") %></p>
  </div>

  <% if @directa_item %>
    <div class="space-y-3 rounded-lg bg-container-inset p-3 text-sm">
      <%= render BankSyncStatusComponent.new(presenter: sync_status) %>
    </div>
  <% end %>

  <div class="flex flex-wrap justify-end gap-2">
    <% if @directa_item&.syncable? %>
      <%= render DS::Button.new(
            text: t(".sync"),
            icon: "refresh-cw",
            variant: :secondary,
            href: sync_directa_item_path(@directa_item),
            disabled: sync_status.manual_refresh_blocked?
          ) %>
    <% end %>

    <%= render DS::Link.new(
          text: t(@directa_item&.session_configured? ? ".reconnect" : ".connect"),
          href: directa_login_path,
          variant: @directa_item&.session_configured? ? :secondary : :primary,
          frame: :_top
        ) %>

    <% if @directa_item&.session_configured? %>
      <%= render DS::Menu.new do |menu| %>
        <% menu.with_item(
          variant: "button",
          text: t(".disconnect"),
          icon: "pause",
          href: directa_item_path(@directa_item),
          method: :delete,
          confirm: t(".disconnect_confirmation")
        ) %>
      <% end %>
    <% end %>
  </div>
</div>
