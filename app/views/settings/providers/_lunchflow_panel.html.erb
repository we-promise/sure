<%= render ProviderItem::PanelComponent.new(
      item: Current.family.lunchflow_items.first_or_initialize(name: t("lunchflow_items.default_connection_name")),
      error_message: local_assigns[:error_message] || @error_message,
      i18n_scope: "settings.providers.lunchflow_panel"
    ) do |panel| %>
  <% panel.with_setup_steps do %>
    <%= render "settings/providers/setup_steps",
               steps: [
                 t("settings.providers.lunchflow_panel.step_1_html", link: link_to("Lunch Flow", "https://www.lunchflow.app/?atp=BiDIYS", target: "_blank", rel: "noopener noreferrer", class: "text-link underline")),
                 t("settings.providers.lunchflow_panel.step_2"),
                 t("settings.providers.lunchflow_panel.step_3")
               ] %>
  <% end %>
<% end %>
