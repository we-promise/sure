<%= render ProviderItem::PanelComponent.new(
      items: local_assigns[:brex_items] || @brex_items || Current.family.brex_items.active.ordered,
      new_item: Current.family.brex_items.build(name: t("brex_items.provider_panel.default_connection_name")),
      error_message: local_assigns[:error_message] || @error_message
    ) do |panel| %>
  <% panel.with_setup_steps do %>
    <%= render "settings/providers/setup_steps",
               steps: [
                 t("brex_items.provider_panel.instructions.sign_in_html", link: link_to("Brex", "https://brex.com", target: "_blank", rel: "noopener noreferrer", class: "text-link underline")),
                 t("brex_items.provider_panel.instructions.open_tokens"),
                 t("brex_items.provider_panel.instructions.create_token"),
                 t("brex_items.provider_panel.instructions.copy_token_html")
               ] %>
  <% end %>
<% end %>
