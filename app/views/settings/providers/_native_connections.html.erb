<%# locals: (connections:) %>
<% if connections.any? %>
  <%= render DS::Card.new do %>
    <h2 class="text-sm font-medium text-primary"><%= t("provider_connections.list.title") %></h2>
    <ul class="mt-3 space-y-3">
      <% connections.each do |connection| %>
        <li class="flex items-center justify-between gap-4 py-3">
          <div class="flex items-center gap-3">
            <%= render ProviderLogo.new(provider_key: connection.provider_key) %>
            <span class="text-primary"><%= connection.name %></span>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <% if native_account_setup_available?(connection) %>
              <%= render DS::Link.new(text: t("provider_connections.account_setup.open"),
                                      href: provider_connection_account_setup_path(connection), frame: "_top", icon: "plus") %>
            <% end %>
            <%= render DS::Link.new(text: t("provider_connections.list.edit", name: connection.name),
                                    href: edit_provider_connection_path(connection), frame: "_top", icon: "settings") %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
