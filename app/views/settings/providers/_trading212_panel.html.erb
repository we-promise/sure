<div id="trading212-providers-panel" class="space-y-4">
  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <%= render DS::Alert.new(message: error_msg, variant: :error) %>
  <% end %>

  <%= render "settings/providers/setup_steps",
             steps: [
               t(".steps.step_1"),
               t(".steps.step_2"),
               t(".steps.step_3")
             ] %>

  <% items = local_assigns[:trading212_items] || @trading212_items || Current.family.trading212_items.ordered %>

  <% if items.any? %>
    <div class="space-y-3">
      <% items.each do |item| %>
        <%= render DS::Disclosure.new(variant: :card) do |disclosure| %>
          <% disclosure.with_summary_content do %>
            <div class="flex items-center justify-between gap-3 w-full">
              <div class="min-w-0">
                <p class="font-medium text-primary truncate"><%= item.name %></p>
                <p class="text-xs text-secondary">
                  <% if item.syncing? %>
                    <%= t(".syncing") %>
                  <% else %>
                    <%= item.sync_status_summary %>
                  <% end %>
                </p>
              </div>
            </div>
          <% end %>

          <div class="mt-4 space-y-4">
            <div class="flex flex-wrap justify-end gap-2">
              <%= button_to sync_trading212_item_path(item),
                            method: :post,
                            class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-secondary hover:text-primary border border-secondary rounded-lg hover:border-primary",
                            disabled: item.syncing? do %>
                <%= icon "refresh-cw", size: "sm" %>
                <%= t(".sync") %>
              <% end %>

              <%= button_to trading212_item_path(item),
                            method: :delete,
                            class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-destructive hover:bg-destructive/10 rounded-lg",
                            data: { turbo_confirm: t(".disconnect_confirm") } do %>
                <%= icon "trash-2", size: "sm" %>
              <% end %>
            </div>

            <%= styled_form_with model: item,
                                 url: trading212_item_path(item),
                                 scope: :trading212_item,
                                 method: :patch,
                                 data: { turbo: true },
                                 class: "space-y-3" do |form| %>
              <%= form.text_field :api_key,
                                  label: t(".api_key_label"),
                                  placeholder: t(".api_key_placeholder_existing"),
                                  type: :password,
                                  value: nil %>

              <%= form.text_field :api_secret,
                                  label: t(".api_secret_label"),
                                  placeholder: t(".api_secret_placeholder_existing"),
                                  type: :password,
                                  value: nil %>

              <%= form.select :environment,
                              [ [ t(".environment_live"), "live" ], [ t(".environment_demo"), "demo" ] ],
                              { label: t(".environment_label"), selected: item.environment || "live" } %>

              <%= form.select :currency,
                              Money::Currency.as_options.map { |c| [ "#{c.name} (#{c.iso_code})", c.iso_code ] },
                              { label: t(".currency_label"), selected: item.currency.presence || Current.family.currency } %>

              <div class="flex flex-wrap justify-end gap-2">
                <%= form.submit t(".update_configuration") %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% trading212_item = Current.family.trading212_items.build(name: t(".default_account_name")) %>
  <% if items.any? %>
    <h3 class="flex items-center gap-2 text-sm font-medium text-primary mt-4">
      <%= icon "plus", size: "sm" %>
      <%= t(".add_account") %>
    </h3>
  <% end %>

  <%= styled_form_with model: trading212_item,
                       url: trading212_items_path,
                       scope: :trading212_item,
                       method: :post,
                       data: { turbo: true },
                       class: "space-y-3" do |form| %>
    <%= form.text_field :api_key,
                        label: t(".api_key_label"),
                        placeholder: t(".api_key_placeholder_new"),
                        type: :password %>

    <%= form.text_field :api_secret,
                        label: t(".api_secret_label"),
                        placeholder: t(".api_secret_placeholder_new"),
                        type: :password %>

    <%= form.select :environment,
                    [ [ t(".environment_live"), "live" ], [ t(".environment_demo"), "demo" ] ],
                    { label: t(".environment_label"), selected: "live" } %>

    <%= form.select :currency,
                    Money::Currency.as_options.map { |c| [ "#{c.name} (#{c.iso_code})", c.iso_code ] },
                    { label: t(".currency_label"), selected: Current.family.currency } %>

    <div class="flex flex-wrap justify-end gap-2">
      <%= form.submit t(".save_configuration") %>
    </div>
  <% end %>
</div>
