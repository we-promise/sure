<div id="scalable-providers-panel" class="space-y-4">
  <%= render DS::Pill.new(label: t("settings.providers.scalable_panel.preview"), tone: :violet, marker: false) %>

  <% sync_status = BankSyncStatusPresenter.new(item: @scalable_item, provider_key: :scalable) if @scalable_item %>

  <div class="space-y-2 text-sm text-secondary">
    <p><%= t("settings.providers.scalable_panel.description") %></p>
    <p><%= t("settings.providers.scalable_panel.read_only") %></p>
    <p><%= t("settings.providers.scalable_panel.profile_security_note") %></p>
  </div>

  <% if @scalable_item.present? %>
    <div class="space-y-3 rounded-lg bg-container-inset p-3 text-sm">
      <%= render BankSyncStatusComponent.new(presenter: sync_status) %>
    </div>
  <% end %>

  <div class="flex flex-wrap justify-end gap-2">
    <% if @scalable_item&.ready_for_sync? %>
      <%= render DS::Button.new(
            text: t("settings.providers.scalable_panel.sync"),
            icon: "refresh-cw",
            variant: :secondary,
            href: sync_scalable_item_path(@scalable_item),
            disabled: @scalable_item.syncing? || !@scalable_item.sync_due?
          ) %>
    <% end %>

    <%= render DS::Link.new(
          text: t(@scalable_item&.requires_update? ? "settings.providers.scalable_panel.reconnect" : "settings.providers.scalable_panel.connect"),
          href: scalable_login_path,
          variant: @scalable_item&.session_configured? ? :secondary : :primary,
          frame: :_top
        ) %>

    <% if @scalable_item&.session_configured? %>
      <%= render DS::Menu.new do |menu| %>
        <% menu.with_item(
          variant: "button",
          text: t("settings.providers.scalable_panel.disconnect"),
          icon: "pause",
          href: scalable_item_path(@scalable_item),
          method: :delete,
          confirm: t("settings.providers.scalable_panel.disconnect_confirmation")
        ) %>
      <% end %>
    <% end %>
  </div>
</div>
