<div id="saxo-providers-panel" class="space-y-4">
  <%= render DS::Pill.new(label: t("saxo.preview")) %>
  <p class="text-sm text-secondary"><%= t("saxo.description") %></p>
  <% if Provider::Saxo.configured? %>
    <% Current.family.saxo_items.active.ordered.each do |item| %>
      <%= render "saxo_items/saxo_item", saxo_item: item, visible_accounts: item.accounts.accessible_by(Current.user) %>
    <% end %>
    <%= render DS::Button.new(text: t("saxo.connect"), href: saxo_items_path, method: :post, data: { turbo: false }) %>
  <% else %>
    <%= render DS::Alert.new(message: t("saxo.configuration_required")) %>
  <% end %>
</div>
