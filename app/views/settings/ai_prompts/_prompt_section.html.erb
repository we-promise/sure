<%# Section chrome shared by the three prompt groups: icon puck, title,
    subtitle, and an expandable indented body. %>
<div class="space-y-3">
  <div class="flex items-center gap-3">
    <div class="w-9 h-9 rounded-full bg-surface-inset flex justify-center items-center">
      <%= icon icon_name %>
    </div>
    <div>
      <p class="text-sm font-medium text-primary"><%= title %></p>
      <p class="text-xs text-secondary"><%= subtitle %></p>
    </div>
  </div>

  <div class="pl-12 space-y-2">
    <details class="group">
      <summary class="flex items-center gap-2 cursor-pointer select-none">
        <span class="text-xs font-medium text-primary uppercase"><%= t("settings.ai_prompts.show.prompt_instructions") %></span>
        <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>
      </summary>
      <div class="mt-3 space-y-4">
        <%= yield %>
      </div>
    </details>
  </div>
</div>
