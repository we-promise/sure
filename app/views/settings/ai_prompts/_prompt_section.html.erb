<%# Section chrome shared by the three prompt groups: icon puck, title,
    subtitle, and an indented body supplied by the caller. %>
<div class="space-y-3">
  <div class="flex items-center gap-3">
    <div class="w-9 h-9 rounded-full bg-surface-inset flex justify-center items-center">
      <%= icon icon_name %>
    </div>
    <div>
      <p class="text-sm font-medium text-primary"><%= title %></p>
      <p class="text-xs text-secondary"><%= subtitle %></p>
    </div>
  </div>

  <div class="pl-12 space-y-4">
    <%= yield %>
  </div>
</div>
