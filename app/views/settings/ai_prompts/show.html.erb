<%= content_for :page_title, t(".page_title") %>

<% if Current.user.ai_enabled? %>
  <div class="mb-4 flex justify-end">
    <%= render DS::Button.new(
      text: t(".disable_ai"),
      href: user_path(Current.user),
      method: :patch,
      params: { user: { ai_enabled: false, redirect_to: "ai_prompts" } },
      data: { turbo: false },
      variant: :destructive
    ) %>
  </div>
<% end %>

<%= styled_form_with model: @family,
                     url: settings_ai_prompts_path,
                     method: :patch,
                     class: "space-y-4" do |form| %>
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="bg-container rounded-lg space-y-4">
      <p class="text-xs text-secondary"><%= t(".intro") %></p>

      <%= render layout: "settings/ai_prompts/prompt_section",
                 locals: { icon_name: "message-circle",
                           title: t(".main_system_prompt.title"),
                           subtitle: t(".main_system_prompt.subtitle") } do %>
        <%= render "settings/ai_prompts/prompt_field",
                   form: form, family: @family, key: :chat_system,
                   label: t(".main_system_prompt.label"), warning: nil %>
      <% end %>

      <div class="border-t border-primary"></div>

      <%= render layout: "settings/ai_prompts/prompt_section",
                 locals: { icon_name: "brain",
                           title: t(".transaction_categorizer.title"),
                           subtitle: t(".transaction_categorizer.subtitle") } do %>
        <%= render "settings/ai_prompts/prompt_field",
                   form: form, family: @family, key: :categorizer_openai,
                   label: t(".transaction_categorizer.openai_label"),
                   warning: t(".json_shape_warning") %>
        <%= render "settings/ai_prompts/prompt_field",
                   form: form, family: @family, key: :categorizer_anthropic,
                   label: t(".transaction_categorizer.anthropic_label"), warning: nil %>
      <% end %>

      <div class="border-t border-primary"></div>

      <%= render layout: "settings/ai_prompts/prompt_section",
                 locals: { icon_name: "store",
                           title: t(".merchant_detector.title"),
                           subtitle: t(".merchant_detector.subtitle") } do %>
        <%= render "settings/ai_prompts/prompt_field",
                   form: form, family: @family, key: :merchant_openai,
                   label: t(".merchant_detector.openai_label"),
                   warning: t(".json_shape_warning") %>
        <%= render "settings/ai_prompts/prompt_field",
                   form: form, family: @family, key: :merchant_anthropic,
                   label: t(".merchant_detector.anthropic_label"), warning: nil %>
      <% end %>
    </div>
  </div>

  <div class="flex justify-end">
    <%= form.submit t(".save") %>
  </div>
<% end %>
