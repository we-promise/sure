<%# locals: (settings:) %>
<%# The matcher: filling in missing merchants from near-duplicates before
    Bayes runs, how alike they must be (also set by Auto-tune's Apply), and
    whether it locks them. %>
<%= classifier_section_form do %>
  <%= render "settings/classifiers/toggle", key: :fill_similar_merchants, settings: settings, label: t(".fill_similar_merchants"), hint: t(".fill_similar_merchants_hint") %>
  <%= render "settings/classifiers/number", key: :similar_threshold, settings: settings,
        attrs: { step: 0.01 },
        label: t(".similar_threshold"), hint: t(".similar_threshold_hint") %>
  <%= render "settings/classifiers/toggle", key: :lock_similar_merchants, settings: settings, label: t(".lock_similar_merchants"), hint: t(".lock_similar_merchants_hint") %>
<% end %>
