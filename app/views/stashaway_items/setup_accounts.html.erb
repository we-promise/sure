<% content_for :title, t(".page_title") %>

<%= render DS::Dialog.new(disable_click_outside: true) do |dialog| %>
  <% dialog.with_header(title: t(".dialog_title")) do %>
    <div class="flex items-center gap-2">
      <%= icon "chart-line", class: "text-primary" %>
      <span class="text-primary"><%= t(".subtitle") %></span>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <div class="space-y-6">
      <%= render DS::Note.new(title: t(".info_box.title")) do %>
        <ul class="list-disc list-inside space-y-1">
          <li><%= t(".info_box.items.item_1") %></li>
          <li><%= t(".info_box.items.item_2") %></li>
          <li><%= t(".info_box.items.item_3") %></li>
          <li><%= t(".info_box.items.item_4") %></li>
        </ul>
      <% end %>

      <% if @waiting_for_sync %>
        <div class="flex flex-col items-center justify-center py-6 space-y-3">
          <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
          <p class="text-secondary text-center"><%= t(".status.fetching_accounts") %></p>
        </div>
        <div class="flex gap-3 justify-center">
          <%= render DS::Link.new(
            text: t(".buttons.refresh"),
            variant: "secondary",
            icon: "refresh-cw",
            href: setup_accounts_stashaway_item_path(@stashaway_item),
            frame: "_top"
          ) %>
          <%= render DS::Link.new(
            text: t(".buttons.cancel"),
            variant: "ghost",
            href: accounts_path,
            frame: "_top"
          ) %>
        </div>
      <% elsif @no_accounts_found || @never_synced %>
        <div class="flex flex-col items-center justify-center py-6 space-y-3">
          <%= icon "alert-circle", size: "lg", class: "text-warning" %>
          <% if @no_accounts_found %>
            <p class="text-primary text-center font-medium"><%= t(".status.no_accounts_found_title") %></p>
            <p class="text-secondary text-center text-sm"><%= t(".status.no_accounts_found_description") %></p>
          <% else %>
            <p class="text-primary text-center font-medium"><%= t(".status.not_synced_title") %></p>
            <p class="text-secondary text-center text-sm"><%= t(".status.not_synced_description") %></p>
          <% end %>
        </div>
        <div class="flex gap-3 justify-center">
          <%= render DS::Link.new(
            text: t(".buttons.back_to_settings"),
            variant: "secondary",
            href: settings_providers_path,
            frame: "_top"
          ) %>
        </div>
      <% else %>
        <%= form_with url: complete_account_setup_stashaway_item_path(@stashaway_item), method: :post, data: { turbo_frame: "_top" } do %>
          <% if @unlinked_accounts.any? %>
            <div class="space-y-4">
              <h3 class="font-medium text-primary"><%= t(".available_accounts.title") %></h3>

              <% @unlinked_accounts.each do |stashaway_account| %>
                <div class="border border-primary rounded-lg p-4 hover:bg-surface transition-colors">
                  <div class="flex items-center gap-3">
                    <input type="checkbox"
                           id="account_<%= stashaway_account.id %>"
                           name="account_ids[]"
                           value="<%= stashaway_account.id %>"
                           checked
                           class="checkbox checkbox--light cursor-pointer">
                    <label for="account_<%= stashaway_account.id %>" class="flex-1 cursor-pointer">
                      <h4 class="font-medium text-primary"><%= stashaway_account.name %></h4>
                      <p class="text-sm text-secondary">
                        <%= t(
                          ".available_accounts.account_summary",
                          account_type: t(".available_accounts.account_types.#{stashaway_account.accountable_type.underscore}"),
                          balance: number_to_currency(stashaway_account.current_balance || 0, unit: Money::Currency.new(stashaway_account.currency.presence || Current.family.currency).symbol)
                        ) %>
                      </p>
                      <% if stashaway_account.goals.size > 1 %>
                        <p class="text-xs text-secondary"><%= t(".available_accounts.portfolio_count", count: stashaway_account.goals.size) %></p>
                      <% end %>
                    </label>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="flex justify-end gap-2 mt-6">
              <%= render DS::Link.new(
                text: t(".buttons.cancel"),
                variant: :secondary,
                href: accounts_path,
                frame: "_top"
              ) %>
              <%= render DS::Button.new(
                text: t(".buttons.create_selected_accounts"),
                icon: "plus",
                type: :submit
              ) %>
            </div>
          <% end %>
        <% end %>

        <% if @unlinked_accounts.any? && @linkable_accounts.any? %>
          <div class="border-t border-secondary pt-4 mt-2">
            <p class="text-xs text-secondary mb-3"><%= t(".link_existing.description") %></p>
            <div class="space-y-2">
              <% @unlinked_accounts.each do |stashaway_account| %>
                <%= styled_form_with url: link_existing_account_stashaway_items_path, method: :post, data: { turbo_frame: "_top" }, class: "space-y-2" do |link_form| %>
                  <%= link_form.hidden_field :stashaway_account_id, value: stashaway_account.id %>
                  <%= link_form.select :account_id,
                        options_for_select(@linkable_accounts.map { |a| [ t(".link_existing.manual_account_option", name: a.name, balance: number_to_currency(a.balance, unit: Money::Currency.new(a.currency.presence || Current.family.currency).symbol)), a.id ] }),
                        { label: stashaway_account.name, prompt: t(".link_existing.select_prompt") },
                        { required: true } %>
                  <div class="flex justify-end">
                    <%= render DS::Button.new(
                      text: t(".buttons.link"),
                      variant: :secondary,
                      type: :submit
                    ) %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @linked_accounts.any? %>
          <div class="<%= "border-t border-primary pt-6 mt-4" if @unlinked_accounts.any? %>">
            <h3 class="font-medium text-primary mb-4"><%= t(".linked_accounts.title") %></h3>
            <% @linked_accounts.each do |stashaway_account| %>
              <div class="border border-success/20 bg-success/5 rounded-lg p-4 mb-2">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <%= icon "check-circle", class: "text-success" %>
                    <div>
                      <h4 class="font-medium text-primary"><%= stashaway_account.name %></h4>
                      <p class="text-sm text-secondary"><%= t(".linked_accounts.linked_to_html", account: link_to(stashaway_account.current_account.name, account_path(stashaway_account.current_account), class: "link")) %></p>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <% if @unlinked_accounts.blank? %>
              <div class="flex justify-end mt-4">
                <%= render DS::Link.new(
                  text: t(".buttons.done"),
                  variant: "primary",
                  href: accounts_path,
                  frame: "_top"
                ) %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
