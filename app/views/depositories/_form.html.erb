<%# locals: (account:, url:) %>

<%= render "accounts/form", account: account, url: url do |form| %>
  <%= form.select :subtype,
                 Depository.subtype_options_for_select,
                 { label: true, prompt: t("depositories.form.subtype_prompt"), include_blank: t("depositories.form.none") } %>

  <%= render "shared/ruler", classes: "my-4" %>

  <%# Behind a disclosure: most accounts have no arranged overdraft, and six
      extra inputs would bury the two fields that matter when opening one. %>
  <details class="group" <%= "open" if account.accountable.is_a?(Depository) && account.accountable.overdraft_terms? %>>
    <summary class="cursor-pointer text-sm font-medium text-secondary">
      <%= t("depositories.form.overdraft_summary") %>
    </summary>

    <p class="text-xs text-secondary mt-2"><%= t("depositories.form.overdraft_hint") %></p>

    <div class="space-y-2 mt-3">
      <%= form.fields_for :accountable do |depository_form| %>
        <div class="flex items-center gap-2">
          <%= depository_form.money_field :overdraft_limit,
                                          label: t("depositories.form.overdraft_limit"),
                                          default_currency: account.currency || Current.family.currency %>
          <%= depository_form.number_field :overdraft_interest_rate,
                                           label: t("depositories.form.overdraft_interest_rate"),
                                           placeholder: t("depositories.form.overdraft_interest_rate_placeholder"),
                                           min: 0,
                                           step: 0.001 %>
        </div>

        <div class="flex items-center gap-2">
          <%= depository_form.money_field :intervention_fee_amount,
                                          label: t("depositories.form.intervention_fee_amount"),
                                          default_currency: account.currency || Current.family.currency %>
          <%= depository_form.money_field :intervention_fee_threshold,
                                          label: t("depositories.form.intervention_fee_threshold"),
                                          default_currency: account.currency || Current.family.currency %>
        </div>

        <div class="flex items-center gap-2">
          <%= depository_form.money_field :intervention_fee_monthly_cap,
                                          label: t("depositories.form.intervention_fee_monthly_cap"),
                                          default_currency: account.currency || Current.family.currency %>
          <%= depository_form.number_field :intervention_fee_monthly_count_cap,
                                           label: t("depositories.form.intervention_fee_monthly_count_cap"),
                                           min: 0,
                                           step: 1 %>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
