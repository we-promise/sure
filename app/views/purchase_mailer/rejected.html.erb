<h1><%= t(".heading") %></h1>
<% if @purchase.ai_metadata["subject"].present? %>
  <p><%= t(".subject_line", subject: @purchase.ai_metadata["subject"]) %></p>
<% end %>
<% if @reason&.dig("reason") == "duplicate" %>
  <p><%= t(".duplicate") %></p>
  <% if @existing_purchase_url %><%= link_to t("purchase_mailer.view_purchase"), @existing_purchase_url, class: "button" %><% end %>
<% else %>
  <p><%= t(".not_an_order", reason: @purchase.ai_metadata.dig("raw_output", "not_order_reason").presence || t(".no_reason")) %></p>
<% end %>
