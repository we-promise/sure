<div id="<%= dom_id(transfer, :display_name) %>" class="text-sm text-secondary">
  <% if can_rename && transfer.shared_name %>
    <%= styled_form_with scope: :transfer,
          url: transfer_path(transfer),
          method: :patch,
          data: { controller: "auto-submit-form" } do |f| %>
      <%= f.text_field :shared_name,
            value: transfer.shared_name,
            inline: true,
            required: true,
            autocomplete: "off",
            class: "w-full bg-transparent border-0 p-0 text-sm text-secondary rounded-sm hover:bg-container-inset focus:bg-container-inset focus-ring",
            title: t("transfers.show.shared_name_hint"),
            aria: { label: t("transfers.show.shared_name") },
            "data-auto-submit-form-target": "auto" %>
    <% end %>
  <% else %>
    <%= transfer.display_name %>
  <% end %>
</div>
