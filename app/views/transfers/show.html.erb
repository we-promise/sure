<%= render DS::Dialog.new(frame: "drawer", responsive: true) do |dialog| %>
  <% dialog.with_header(custom_header: true) do %>
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="font-medium flex items-center gap-2">
          <span class="text-2xl text-primary privacy-sensitive">
            <%= format_money @transfer.amount_abs %>
          </span>
          <span class="text-lg text-secondary">
            <%= @transfer.amount_abs.currency.iso_code %>
          </span>
          <%= icon "arrow-left-right", size: "sm", class: "text-secondary" %>
        </h3>
        <%= render "transfers/display_name", transfer: @transfer %>
      </div>
      <%= dialog.close_button %>
    </div>
  <% end %>
  <% dialog.with_body do %>
    <% dialog.with_section(title: t(".overview"), open: true) do %>
      <% if @can_rename_transfer_entries %>
        <%= styled_form_with scope: :transfer,
              url: transfer_path(@transfer),
              method: :patch,
              class: "pb-4 px-3 pt-2 text-sm space-y-3 text-primary",
              data: { controller: "auto-submit-form" } do |f| %>
          <%= render "transfers/overview", transfer: @transfer, form: f %>
        <% end %>
      <% else %>
        <div class="pb-4 px-3 pt-2 text-sm space-y-3 text-primary">
          <%= render "transfers/overview", transfer: @transfer %>
        </div>
      <% end %>
    <% end %>
    <% dialog.with_section(title: t(".details")) do %>
      <div class="space-y-2">
        <%# Separate forms: the investment contribution switch reloads the page, so
            it must not be submitted along with every category or notes edit. %>
        <% if @transfer.categorizable? %>
          <%= styled_form_with model: @transfer, data: { controller: "auto-submit-form" } do |f| %>
            <%= f.collection_select :category_id, @categories, :id, :name, { label: t(".category"), include_blank: t(".uncategorized"), selected: @transfer.outflow_transaction.category&.id, variant: :badge, searchable: true }, "data-auto-submit-form-target": "auto" %>
          <% end %>
        <% end %>
        <% if @can_switch_investment_contribution %>
          <%= styled_form_with model: @transfer,
                data: { controller: "auto-submit-form" },
                class: "flex items-center justify-between gap-4 py-1" do |f| %>
            <div class="space-y-1">
              <p class="text-sm text-primary"><%= t(".investment_contribution_title") %></p>
              <p class="text-xs text-secondary"><%= t(".investment_contribution_subtitle") %></p>
            </div>
            <%= f.toggle :investment_contribution, data: { auto_submit_form_target: "auto" } %>
          <% end %>
        <% end %>
        <%= styled_form_with model: @transfer,
                data: { controller: "auto-submit-form" }, class: "space-y-2" do |f| %>
          <%= render DS::TagSelect.new(
                form: f,
                tags: @tags,
                selected_ids: @transfer.outflow_transaction.tag_ids,
                auto_submit: true,
                update_url: tags_transfer_path(@transfer)
              ) %>
          <%= f.text_area :notes,
                    label: t(".note_label"),
                    placeholder: t(".note_placeholder"),
                    rows: 5,
                    "data-auto-submit-form-target": "auto" %>
        <% end %>
      </div>
    <% end %>
    <% dialog.with_section(title: t(".settings")) do %>
      <div class="pb-4">
        <% if @can_mark_as_recurring_transfer %>
          <div class="flex items-center justify-between gap-2 p-3">
            <div class="text-sm space-y-1">
              <h4 class="text-primary"><%= t(".mark_recurring_title") %></h4>
              <p class="text-secondary"><%= t(".mark_recurring_subtitle") %></p>
            </div>
            <%= render DS::Button.new(
              text: t(".mark_recurring"),
              variant: "outline",
              icon: "repeat",
              href: mark_as_recurring_transfer_path(@transfer),
              method: :post,
              frame: "_top"
            ) %>
          </div>
        <% end %>
        <div class="flex items-center justify-between gap-2 p-3">
          <div class="text-sm space-y-1">
            <h4 class="text-primary"><%= t(".delete_title") %></h4>
            <p class="text-secondary"><%= t(".delete_subtitle") %></p>
          </div>
          <%= render DS::Button.new(
                text: t(".delete"),
                variant: :outline_destructive,
                size: :md,
                href: transfer_path(@transfer),
                method: :delete,
                confirm: CustomConfirm.new(
                  title: t(".delete_title"),
                  body: t(".delete_subtitle"),
                  destructive: true
                ),
                frame: "_top"
              ) %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
