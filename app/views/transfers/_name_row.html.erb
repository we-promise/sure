<%# locals: (form:, method:, value:) %>

<dl class="flex items-center gap-2 justify-between">
  <dt class="text-secondary"><%= t("transfers.show.transaction_name") %></dt>
  <dd class="min-w-0 flex-1">
    <%= form.text_field method,
          value: value,
          inline: true,
          required: true,
          autocomplete: "off",
          class: "w-full bg-transparent border-0 p-0 text-right text-sm font-medium text-primary rounded-sm hover:bg-container-inset focus:bg-container-inset focus-ring",
          aria: { label: t("transfers.show.transaction_name") },
          "data-auto-submit-form-target": "auto" %>
  </dd>
</dl>
