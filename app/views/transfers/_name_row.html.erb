<%# locals: (form:, method:, value:) %>

<dl>
  <%= render DS::DetailRow.new(label: t("transfers.show.transaction_name"), align: :center) do |row| %>
    <% row.with_value do %>
      <%= render DS::InlineEdit.new(
            form: form,
            method: method,
            value: value,
            aria_label: t("transfers.show.transaction_name"),
            data: { auto_submit_form_target: "auto" }
          ) %>
    <% end %>
  <% end %>
</dl>
