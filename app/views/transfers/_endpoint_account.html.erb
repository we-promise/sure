<%# locals: (account:, readable:) %>
<%# A side whose account the user cannot open is neither named nor linked:
    the drawer opens with access to the inflow side only. %>
<dd class="flex items-center gap-2 font-medium">
  <% if readable %>
    <%= render "accounts/logo", account: account, size: "sm" %>
    <%= link_to account.name, account_path(account), data: { turbo_frame: "_top" } %>
  <% else %>
    <%= t("transfer.hidden_account").upcase_first %>
  <% end %>
</dd>
