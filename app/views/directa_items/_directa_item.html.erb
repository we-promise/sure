<%# locals: (directa_item:, visible_accounts:) %>

<%= tag.div id: dom_id(directa_item) do %>
  <% can_manage_directa = Current.user&.admin? && directa_item.owned_by?(Current.user) &&
    Current.user.preview_features_enabled? && Rails.application.config.app_mode.self_hosted? %>

  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>
          <%= render ProviderLogo.new(provider_key: :directa) %>
          <div class="min-w-0 pl-1 text-sm">
            <p class="font-medium text-primary"><%= Provider::Metadata.for(:directa)[:name] %></p>
            <% if directa_item.syncing? %>
              <p class="text-secondary"><%= t("directa_items.card.syncing") %></p>
            <% elsif directa_item.last_sync_error.present? %>
              <p class="text-warning"><%= directa_item.last_sync_error %></p>
            <% elsif directa_item.last_synced_at.present? %>
              <p class="text-secondary"><%= t("directa_items.card.last_synced", time: time_ago_in_words(directa_item.last_synced_at)) %></p>
            <% else %>
              <p class="text-secondary"><%= t("directa_items.card.not_synced") %></p>
            <% end %>
          </div>
        </div>

        <% if can_manage_directa %>
          <div class="flex items-center gap-2">
            <% if directa_item.syncable? %>
              <%= render DS::Button.new(
                    text: t("directa_items.card.sync"),
                    icon: "refresh-cw",
                    variant: :secondary,
                    size: :sm,
                    href: sync_directa_item_path(directa_item),
                    disabled: directa_item.syncing?
                  ) %>
            <% end %>
            <%= render DS::Menu.new do |menu| %>
              <% menu.with_item(
                variant: "link",
                text: t("directa_items.card.reconnect"),
                icon: "refresh-cw",
                href: directa_login_path
              ) %>
              <% if directa_item.session_configured? %>
                <% menu.with_item(
                  variant: "button",
                  text: t("directa_items.card.stop_syncing"),
                  icon: "pause",
                  href: directa_item_path(directa_item),
                  method: :delete,
                  confirm: t("directa_items.card.stop_syncing_confirmation")
                ) %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 space-y-3">
      <% if visible_accounts.any? %>
        <%= render "accounts/index/account_groups", accounts: visible_accounts %>
      <% end %>
      <p class="text-xs text-secondary"><%= t("directa_items.card.snapshot_scope") %></p>
    </div>
  <% end %>
<% end %>
