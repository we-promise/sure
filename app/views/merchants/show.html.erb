<% totals = @search.totals %>

<div class="space-y-4 pb-6 lg:pb-12 flex flex-col">
  <header class="flex items-center justify-between gap-4 text-primary">
    <div class="flex items-center gap-3 min-w-0">
      <% if @merchant.logo_url.present? %>
        <%= image_tag Setting.transform_brand_fetch_url(@merchant.logo_url), class: "w-9 h-9 rounded-full border border-secondary", alt: "" %>
      <% else %>
        <%= render DS::FilledIcon.new(variant: :text, text: @merchant.name, hex_color: @merchant.color, size: "lg", rounded: true) %>
      <% end %>
      <h1 class="text-xl font-medium truncate"><%= @merchant.name %></h1>
    </div>

    <% unless Current.user.guest? %>
      <%= render DS::Link.new(
        text: t(".edit"),
        icon: "pencil",
        variant: "outline",
        href: edit_family_merchant_path(@merchant, return_to: request.fullpath),
        frame: :modal
      ) %>
    <% end %>
  </header>

  <%= render DS::Card.new(class: "gap-3") do %>
    <h2 class="text-base font-medium text-primary"><%= t(".summary") %></h2>
    <dl class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-10 gap-y-3">
      <%= render DS::DetailRow.new(label: t(".total_transactions"), value: totals.count.to_s, align: :center, value_class: "privacy-sensitive") %>
      <%= render DS::DetailRow.new(label: t(".total_spending"), value: format_money(@expense_totals.expense_money), align: :center, value_class: "privacy-sensitive") %>
      <% if @average_expense_money %>
        <%= render DS::DetailRow.new(label: t(".average_transaction"), value: format_money(@average_expense_money), align: :center, value_class: "privacy-sensitive") %>
      <% end %>
      <% if @first_date %>
        <%= render DS::DetailRow.new(label: t(".first_transaction"), value: l(@first_date, format: :long), align: :center) %>
        <%= render DS::DetailRow.new(label: t(".last_transaction"), value: l(@last_date, format: :long), align: :center) %>
      <% end %>
    </dl>
  <% end %>

  <div>
    <%= form_with url: merchant_path(@merchant),
          id: "merchant-transactions-search",
          scope: :q,
          method: :get,
          data: { controller: "auto-submit-form" } do |form| %>
      <div class="flex gap-2">
        <div class="grow">
          <div class="flex items-center px-3 py-2 gap-2 bg-container border border-secondary rounded-lg focus-within:border-primary">
            <%= icon("search") %>
            <%= form.search_field :search,
                  placeholder: t("transactions.searches.form.search_placeholder"),
                  value: @q[:search],
                  class: "form-field__input placeholder:text-sm placeholder:text-secondary",
                  "data-auto-submit-form-target": "auto" %>
          </div>
        </div>

        <%= render DS::Popover.new(variant: "button", no_padding: true) do |popover| %>
          <% popover.with_button(
            id: "merchant-filters-button",
            type: "button",
            text: t("transactions.searches.form.filter"),
            variant: "outline",
            icon: "list-filter"
          ) %>

          <% popover.with_custom_content do %>
            <%= render "transactions/searches/menu",
                  form: form,
                  exclude: [ "merchant_filter", "ai_filter", "attachment_filter" ],
                  clear_filters_path: merchant_path(@merchant) %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @q.except(:amount_operator).present? %>
      <ul id="merchant-transaction-filters" class="flex items-center flex-wrap gap-2 mt-4">
        <% @q.except(:amount_operator).each do |param_key, param_value| %>
          <% if param_key == "amount" %>
            <%= render "transactions/searches/filters/badge",
                  param_key: "amount",
                  param_value: "#{transaction_amount_operator_label(@q[:amount_operator])} #{param_value}",
                  clear_filter_path: clear_filter_merchant_path(@merchant, param_key: "amount", param_value: param_value, **request.query_parameters) %>
          <% else %>
            <% Array(param_value).each do |value| %>
              <%= render "transactions/searches/filters/badge",
                    param_key: param_key,
                    param_value: value,
                    clear_filter_path: clear_filter_merchant_path(@merchant, param_key: param_key, param_value: value, **request.query_parameters) %>
            <% end %>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%= render "transactions/list", transactions: @transactions, projected_recurring: @projected_recurring, q: @q, pagy: @pagy, toolbar: false %>
</div>
