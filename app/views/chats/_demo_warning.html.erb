<% message = t("chats.demo_banner_message") %>
<% if Current.user.admin? %>
  <% suffix = t("chats.demo_banner_message_addendum_html",
    link: render(DS::Link.new(text: t("chats.demo_banner_link"), href: settings_llm_usage_path, frame: "_top", variant: :default, class: "font-bold! hover:underline!"))) %>
  <% message = safe_join([message, suffix], " ") %>
<% end %>
<%= render "shared/demo_warning", title: t("chats.demo_banner_title"), message: message %>
