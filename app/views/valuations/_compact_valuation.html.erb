<%# locals: (entry:, running_balance: nil, hide_balance: false, flat: false) %>
<% valuation = entry.entryable %>
<% show_date = flat %>
<% show_balance = flat && !hide_balance %>

<%= turbo_frame_tag dom_id(entry) do %>
  <%= turbo_frame_tag dom_id(valuation) do %>
    <%= render DS::CompactRow.new(show_date: show_date, show_balance: show_balance, show_notes: Current.user.transactions_show_notes?, data: { controller: "clickable-row", action: "click->clickable-row#open" }) do |row| %>
      <% row.with_checkbox do %>
        <%= check_box_tag dom_id(entry, "selection"),
            class: "checkbox checkbox--light hidden @5xl/compact-table:block",
            data: { id: entry.id, entry_type: entry.entryable_type, "bulk-select-target": "row", action: "bulk-select#toggleRowSelection", checkbox_toggle_target: "selectionEntry" } %>
      <% end %>

      <% if show_date %>
        <% row.with_date { format_date(entry.date) } %>
      <% end %>

      <% row.with_primary do %>
        <div class="min-w-0 flex-1 truncate">
          <% if show_date %>
            <span class="@5xl/compact-table:hidden shrink-0 text-secondary text-xs"><%= format_date(entry.date) %> • </span>
          <% end %>
          <%= link_to(
                valuation.opening_anchor? ? t("valuations.show.opening_balance") : entry.name,
                entry_path(entry),
                data: { turbo_frame: "drawer", turbo_prefetch: false, clickable_row_target: "link" },
                class: "hover:underline truncate"
              ) %>
        </div>
      <% end %>

      <% row.with_amount do %>
        <%= tag.p format_money(entry.amount_money), class: "privacy-sensitive text-sm font-medium truncate" %>
      <% end %>

      <% if show_balance %>
        <% row.with_balance do %>
          <% if running_balance.present? %>
            <span class="privacy-sensitive text-sm font-medium text-primary truncate" title="<%= format_money(running_balance) %>"><%= format_money(running_balance) %></span>
          <% else %>
            <span class="text-secondary opacity-40 text-sm" title="<%= t("transactions.show.balance_unavailable") %>">—</span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
