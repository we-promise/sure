<%# locals: (account:, revealed:) %>

<% gift_card = account.gift_card %>
<% codes = revealed ? gift_card.visible_codes_for(Current.user) : gift_card.masked_codes_for(Current.user) %>
<% redeem_url = gift_card.visible_redeem_url_for(Current.user) %>

<%= turbo_frame_tag dom_id(account, :gift_card_credentials) do %>
  <dl class="space-y-2 px-3">
    <% codes.each do |attribute, value| %>
      <%= render DS::DetailRow.new(label: t("gift_cards.credentials.#{attribute}"), align: :center) do |row| %>
        <% row.with_value do %>
          <% if !revealed && attribute == :pin %>
            <span class="flex items-center gap-2">
              <code class="font-mono text-sm text-secondary"><%= value %></code>
              <%= render DS::Link.new(
                text: t("gift_cards.credentials.show"),
                href: credentials_gift_card_path(account, reveal: true),
                icon: "eye",
                variant: "ghost",
                size: "sm",
                frame: dom_id(account, :gift_card_credentials)
              ) %>
            </span>
          <% else %>
            <span class="flex items-center gap-2" data-controller="clipboard" data-clipboard-copied-text-value="<%= t("gift_cards.credentials.copied") %>">
              <code class="font-mono text-sm text-primary break-all privacy-sensitive" data-clipboard-target="source"><%= value %></code>
              <%= render DS::Button.new(
                text: t("gift_cards.credentials.copy"),
                variant: :ghost,
                icon: "copy",
                size: :sm,
                data: { action: "clipboard#copy" }
              ) %>
              <% if revealed && attribute == :pin %>
                <%= render DS::Link.new(
                  text: t("gift_cards.credentials.hide"),
                  href: credentials_gift_card_path(account),
                  icon: "eye-off",
                  variant: "ghost",
                  size: "sm",
                  frame: dom_id(account, :gift_card_credentials)
                ) %>
              <% end %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if redeem_url.present? %>
      <%= render DS::DetailRow.new(label: t("gift_cards.credentials.redeem_url"), align: :center) do |row| %>
        <% row.with_value do %>
          <%= render DS::Link.new(
            text: t("gift_cards.credentials.open_redeem_url"),
            href: redeem_url,
            icon: "external-link",
            variant: "ghost",
            size: "sm",
            target: "_blank"
          ) %>
        <% end %>
      <% end %>
    <% end %>
  </dl>
<% end %>
