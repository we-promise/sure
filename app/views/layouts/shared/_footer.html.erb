<% privacy_link = legal_page_url(:privacy) %>
<% terms_link = legal_page_url(:terms) %>
<footer class="p-6">
  <div class="space-y-2 text-center text-xs text-secondary">
    <p>&copy; <%= Date.current.year %>, <%= brand_name %> <%= product_name %> (community fork of Maybe Finance)</p>
    <% if privacy_link || terms_link %>
      <div class="flex justify-center items-center gap-2">
        <%= link_to "Privacy Policy", privacy_path, class: "text-secondary", target: "_blank" if privacy_link %>
        <% if privacy_link && terms_link %>
          <span>&bull;</span>
        <% end %>
        <%= link_to "Terms of Service", terms_path, class: "text-secondary", target: "_blank" if terms_link %>
      </div>
    <% end %>
  </div>
</footer>
