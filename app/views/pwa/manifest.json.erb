<%#
  Icon safe areas — read before regenerating any of these PNGs.

  A `maskable` icon is cropped by the launcher to its own shape (circle,
  squircle, teardrop…). Per the W3C spec only the centred circle of diameter
  80% of the icon is guaranteed to survive, so a maskable icon needs its own
  file with the artwork well inside that circle — it CANNOT be the same file as
  the `any` icon. Pointing both at one full-bleed image is what clipped the
  wordmark's outer letters on Android.

  Current geometry (artwork is 160x145, from public/logo-offline.svg):
    any / apple-touch  -> artwork at 72% of the canvas (~14% side margin)
    maskable           -> artwork at 59%, so its corners need a 79.6% circle
                          and clear the 80% safe zone

  iOS ignores this file entirely and uses the <link rel="apple-touch-icon">
  tags in layouts/shared/_head.html.erb. It reserves no safe area and composites
  transparency onto black, so those icons must stay opaque and self-padded.
%>
{
  "name": "<%= j product_name %>",
  "short_name": "<%= j product_name %>",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/logo-pwa.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/logo-pwa-maskable.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "scope": "/",
  "orientation": "any",
  "description": "<%= j product_name %> is your personal finance assistant.",
  "theme_color": "#F9F9F9",
  "background_color": "#F9F9F9"
}
