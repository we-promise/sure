<%= content_for :header_nav do %>
  <%= render "imports/nav", import: @import %>
<% end %>

<%= content_for :previous_path, imports_path %>

<div class="space-y-6" data-controller="import-flow">
  <div class="mx-auto max-w-md space-y-4">
    <div class="text-center space-y-2">
      <h1 class="text-3xl text-primary font-medium"><%= t("import.uploads.show.title") %></h1>
      <p class="text-secondary text-sm"><%= t("import.uploads.show.description") %></p>
    </div>

    <% file_format_options = [ [ t("imports.new.format_csv"), "csv" ] ] %>
    <% file_format_options << [ t("imports.new.format_document"), "document" ] if @document_upload_extensions.any? %>
    <% file_format_options.concat([
      [ t("imports.new.format_qif"), "qif" ],
      [ t("imports.new.format_sure"), "sure" ]
    ]) %>
    <% has_accounts = accessible_accounts.any? %>
    <% csv_import_kind_options = [
      [ t("imports.new.import_transactions"), "TransactionImport", { disabled: !has_accounts } ],
      [ t("imports.new.import_portfolio"), "TradeImport", { disabled: !has_accounts } ],
      [ t("imports.new.import_accounts"), "AccountImport" ],
      [ t("imports.new.import_categories"), "CategoryImport" ],
      [ t("imports.new.import_merchants"), "MerchantImport" ],
      [ t("imports.new.import_rules"), "RuleImport" ],
      [ t("imports.new.csv_formats.mint"), "MintImport" ],
      [ t("imports.new.csv_formats.actual"), "ActualImport" ],
      [ t("imports.new.csv_formats.ynab"), "YnabImport" ]
    ] %>
    <% selected_import_kind = params[:import_kind].presence_in(%w[TransactionImport TradeImport AccountImport CategoryImport MerchantImport RuleImport MintImport ActualImport YnabImport]) || (@import.type.in?(%w[TransactionImport TradeImport AccountImport CategoryImport MerchantImport RuleImport MintImport ActualImport YnabImport]) ? @import.type : "TransactionImport") %>
    <% selected_csv_format = params[:csv_format].presence || Import::CsvFormat::TRANSACTION_TYPES.key(selected_import_kind) || "auto" %>
    <%= label_tag :import_file_format, t("imports.new.format_label"), class: "text-sm font-medium text-primary" %>
    <%= select_tag :file_format,
          options_for_select(file_format_options, @file_format),
          id: "import_file_format",
          class: "w-full",
          data: { import_flow_target: "format", action: "change->import-flow#update" } %>

    <div data-import-flow-target="csvOptions" class="space-y-4" <%= "hidden" unless @file_format == "csv" %>>
      <%= label_tag :import_kind, t("imports.new.csv_import_kind_label"), class: "text-sm font-medium text-primary" %>
      <%= select_tag :import_kind,
            options_for_select(csv_import_kind_options, selected_import_kind),
            id: "import_kind",
            class: "w-full",
            data: { import_flow_target: "kind", action: "change->import-flow#update" } %>
      <div data-import-flow-target="transactionFormat" class="space-y-2" <%= "hidden" unless selected_import_kind == "TransactionImport" %>>
        <%= label_tag :csv_format, t("imports.new.csv_format_label"), class: "text-sm font-medium text-primary" %>
        <%= select_tag :csv_format,
              options_for_select(Import::CsvFormat.options.map { |key, _value| [ t("imports.new.csv_formats.#{key}"), key ] }, selected_csv_format),
              class: "w-full",
              data: { import_flow_target: "csvSource", action: "change->import-flow#update" } %>
        <p class="text-xs text-secondary"><%= t("imports.new.csv_format_description") %></p>
      </div>
    </div>

    <section data-import-flow-target="panel" data-import-flow-panel="csv" class="space-y-4" <%= "hidden" unless @file_format == "csv" %>>
      <% unless has_accounts %>
        <%= render DS::Alert.new(message: t("imports.new.requires_account"), variant: :info) %>
      <% end %>
      <div class="space-y-4" data-controller="drag-and-drop-import">
        <%= render "imports/drag_drop_overlay", title: t("import.uploads.show.drop_csv_title"), subtitle: t("import.uploads.show.drop_csv_subtitle") %>

        <%= render DS::Tabs.new(active_tab: params[:tab] || "csv-upload", url_param_key: "tab", testid: "import-tabs") do |tabs| %>
          <% tabs.with_nav do |nav| %>
            <% nav.with_btn(id: "csv-upload", label: t("import.uploads.show.upload_csv_tab")) %>
            <% nav.with_btn(id: "csv-paste", label: t("import.uploads.show.copy_paste_tab")) %>
          <% end %>

          <% [ "csv-upload", "csv-paste" ].each do |tab| %>
            <% tabs.with_panel(tab_id: tab) do %>
              <%= styled_form_with model: @import, scope: :import, url: import_upload_path(@import), multipart: true, class: "space-y-4", data: { drag_and_drop_import_target: (tab == "csv-upload" ? "form" : nil) }.compact do |form| %>
                <%= form.hidden_field :file_format, value: "csv" %>
                <%= form.hidden_field :import_kind, value: selected_import_kind, data: { import_flow_target: "kind" } %>
                <%= form.hidden_field :csv_format, value: selected_csv_format, data: { import_flow_target: "csvSource" } %>

                <%= form.select :col_sep, Import.separator_options, label: true %>

                <div data-import-flow-target="account" <%= "hidden" unless selected_import_kind.in?(%w[TransactionImport TradeImport]) %>>
                  <%= form.select :account_id, Current.user.accessible_accounts.visible.alphabetically.pluck(:name, :id), { label: t("import.uploads.show.account_optional_label"), include_blank: t("import.uploads.show.multi_account_import"), selected: @import.account_id } %>
                </div>

                <% if tab == "csv-upload" %>
                  <label for="import_import_file_csv" class="flex flex-col items-center justify-center w-full h-64 border border-secondary border-dashed rounded-xl cursor-pointer" data-controller="file-upload" data-file-upload-target="uploadArea">
                    <div class="flex flex-col items-center justify-center pt-5 pb-6">
                      <div data-file-upload-target="uploadText" class="flex flex-col items-center">
                        <%= icon("plus", size: "lg", class: "mb-4 mx-auto") %>
                        <p class="mb-2 text-md text-gray text-center"><span class="font-medium text-primary"><%= t("import.uploads.show.browse") %></span> <%= t("import.uploads.show.csv_file_prompt") %></p>
                      </div>
                      <div class="flex flex-col gap-4 items-center hidden mb-2" data-file-upload-target="fileName">
                        <span class="text-primary"><%= icon("file-text", size: "lg", color: "current") %></span>
                        <p class="text-md font-medium text-primary"></p>
                      </div>
                      <%= form.file_field :import_file, id: "import_import_file_csv", class: "hidden", "data-auto-submit-form-target": "auto", "data-file-upload-target": "input", "data-drag-and-drop-import-target": "input" %>
                    </div>
                  </label>
                <% else %>
                  <%= form.text_area :raw_file_str, rows: 10, required: true, placeholder: t("import.uploads.show.paste_csv_placeholder"), "data-auto-submit-form-target": "auto" %>
                <% end %>

                <%= form.submit t("import.uploads.show.upload_csv_button"), disabled: @import.complete? %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <div class="flex justify-center">
          <span class="text-secondary text-sm">
            <%= link_to t("import.uploads.show.download_sample_csv"), "/imports/#{@import.id}/upload/sample_csv", class: "text-primary underline", data: { turbo: false } %> <%= t("import.uploads.show.to_see_format") %>
          </span>
        </div>
      </div>
    </section>

    <% if @document_upload_extensions.any? %>
      <section data-import-flow-target="panel" data-import-flow-panel="document" class="space-y-4" <%= "hidden" unless @file_format == "document" %>>
        <p class="text-sm text-secondary"><%= t("imports.new.document_description") %></p>
        <%= styled_form_with url: imports_path, scope: :import, multipart: true, class: "space-y-4", data: { turbo: false } do |form| %>
          <%= form.hidden_field :file_format, value: "document" %>
          <%= form.select :account_id,
                Current.user.accessible_accounts.visible.alphabetically.pluck(:name, :id),
                { label: t("imports.new.document_account_label"), include_blank: t("imports.new.document_account_placeholder") },
                required: false %>
          <label for="document_import_file" class="flex flex-col items-center justify-center w-full h-64 border border-secondary border-dashed rounded-xl cursor-pointer" data-controller="file-upload" data-file-upload-target="uploadArea">
            <div class="flex flex-col items-center justify-center pt-5 pb-6">
              <div data-file-upload-target="uploadText" class="flex flex-col items-center">
                <%= icon("plus", size: "lg", class: "mb-4 mx-auto") %>
                <p class="mb-2 text-md text-gray text-center"><span class="font-medium text-primary"><%= t("imports.new.browse_document") %></span> <%= t("imports.new.document_file_prompt") %></p>
              </div>
              <div data-file-upload-target="fileName" class="flex flex-col gap-4 items-center hidden mb-2">
                <span class="text-primary"><%= icon("file-text", size: "lg", color: "current") %></span>
                <p class="text-md font-medium text-primary"></p>
              </div>
              <%= form.file_field :import_file, id: "document_import_file", class: "hidden", accept: @document_upload_extensions.join(","), required: true, "data-file-upload-target": "input", "data-import-flow-target": "fileInput", "data-import-flow-file-format": "document" %>
            </div>
          </label>
          <%= form.submit t("imports.new.upload_document") %>
        <% end %>
      </section>
    <% end %>

    <section data-import-flow-target="panel" data-import-flow-panel="qif" class="space-y-4" <%= "hidden" unless @file_format == "qif" %>>
      <p class="text-sm text-secondary"><%= t("import.uploads.show.qif_description") %></p>
      <%= styled_form_with model: @import, scope: :import, url: import_upload_path(@import), multipart: true, class: "space-y-4" do |form| %>
        <%= form.hidden_field :file_format, value: "qif" %>
        <%= form.select :account_id,
              Current.user.accessible_accounts.visible.alphabetically.pluck(:name, :id),
              { label: t("import.uploads.show.qif_account_label"), include_blank: t("import.uploads.show.qif_account_placeholder"), selected: @import.account_id },
              required: false %>
        <label for="qif_import_file" class="flex flex-col items-center justify-center w-full h-64 border border-secondary border-dashed rounded-xl cursor-pointer" data-controller="file-upload" data-file-upload-target="uploadArea">
          <div class="flex flex-col items-center justify-center pt-5 pb-6">
            <%= icon("plus", size: "lg", class: "mb-4 mx-auto") %>
            <p class="mb-2 text-md text-gray text-center"><span class="font-medium text-primary"><%= t("import.uploads.show.browse") %></span> <%= t("import.uploads.show.qif_file_prompt") %></p>
            <p class="text-xs text-secondary"><%= t("import.uploads.show.qif_file_hint") %></p>
            <%= form.file_field :import_file, accept: ".qif", id: "qif_import_file", class: "hidden", "data-file-upload-target": "input" %>
          </div>
        </label>
        <%= form.submit t("import.uploads.show.qif_submit"), disabled: @import.complete? %>
      <% end %>
    </section>

    <section data-import-flow-target="panel" data-import-flow-panel="sure" class="space-y-4" <%= "hidden" unless @file_format == "sure" %>>
      <p class="text-sm text-secondary"><%= t("import.uploads.sure_import.description") %></p>
      <%= styled_form_with model: @import, scope: :import, url: import_upload_path(@import), multipart: true, class: "space-y-4", data: { drag_and_drop_import_target: "form" } do |form| %>
        <%= form.hidden_field :file_format, value: "sure" %>
        <label for="sure_import_file" class="flex flex-col items-center justify-center w-full h-64 border border-secondary border-dashed rounded-xl cursor-pointer" data-controller="file-upload" data-file-upload-target="uploadArea">
          <div class="flex flex-col items-center justify-center pt-5 pb-6">
            <div data-file-upload-target="uploadText" class="flex flex-col items-center">
              <%= icon("database", size: "lg", class: "mb-4 mx-auto") %>
              <p class="mb-2 text-md text-gray text-center"><span class="font-medium text-primary"><%= t("import.uploads.sure_import.browse") %></span> <%= t("import.uploads.sure_import.browse_hint") %></p>
            </div>
            <div data-file-upload-target="fileName" class="flex flex-col gap-4 items-center hidden mb-2">
              <span class="text-primary"><%= icon("file-text", size: "lg", color: "current") %></span>
              <p class="text-md font-medium text-primary"></p>
            </div>
            <%= form.file_field :ndjson_file, id: "sure_import_file", class: "hidden", accept: ".ndjson,.json", "data-auto-submit-form-target": "auto", "data-file-upload-target": "input", "data-import-flow-target": "fileInput", "data-import-flow-file-format": "sure" %>
          </div>
        </label>
        <%= form.submit t("import.uploads.sure_import.upload_button"), disabled: @import.complete?, data: { action: "click->import-flow#uploadSure" } %>
      <% end %>
      <div class="flex justify-center"><span class="text-secondary text-sm"><%= t("import.uploads.sure_import.hint_html") %></span></div>
    </section>
  </div>
</div>
