<%# locals: (revolut_x_item:, unlinked_count: revolut_x_item.unlinked_accounts_count, visible_accounts:) %>

<%= tag.div id: dom_id(revolut_x_item) do %>
  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>

          <%= render ProviderLogo.new(provider_key: :revolut_x) %>

          <div class="pl-1 text-sm">
            <div class="flex items-center gap-2">
              <%= tag.p revolut_x_item.name, class: "font-medium text-primary" %>
              <% if revolut_x_item.scheduled_for_deletion? %>
                <p class="text-destructive text-sm animate-pulse"><%= t(".deletion_in_progress") %></p>
              <% end %>
            </div>
            <p class="text-xs text-secondary"><%= t(".provider_name") %></p>

            <% if revolut_x_item.syncing? %>
              <div class="text-secondary flex items-center gap-1">
                <%= icon "loader", size: "sm", class: "animate-spin" %>
                <%= tag.span t(".syncing") %>
              </div>
            <% elsif !revolut_x_item.credentials_configured? || revolut_x_item.requires_update? %>
              <div class="text-warning flex items-center gap-1">
                <%= icon "alert-triangle", size: "sm", color: "warning" %>
                <%= tag.span revolut_x_item.credentials_configured? ? t(".reconnect") : t(".awaiting_api_key") %>
              </div>
            <% else %>
              <p class="text-secondary">
                <% if revolut_x_item.last_synced_at %>
                  <%= t(".status_with_summary", timestamp: time_ago_in_words(revolut_x_item.last_synced_at), summary: revolut_x_item.sync_status_summary) %>
                <% else %>
                  <%= t(".status_never") %>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>

        <% if Current.user&.admin? %>
          <div class="flex items-center gap-2">
            <%= icon(
              "refresh-cw",
              as_button: true,
              href: sync_revolut_x_item_path(revolut_x_item),
              disabled: revolut_x_item.syncing? || !revolut_x_item.credentials_configured?
            ) %>

            <%= render DS::Menu.new do |menu| %>
              <% sync_schedule_menu_item(menu, revolut_x_item) %>
              <% if unlinked_count.to_i > 0 %>
                <% menu.with_item(
                  variant: "link",
                  text: t(".import_accounts_menu"),
                  icon: "plus",
                  href: setup_accounts_revolut_x_item_path(revolut_x_item),
                  frame: :modal
                ) %>
              <% end %>
              <% menu.with_item(
                variant: "button",
                text: t(".delete"),
                icon: "trash-2",
                href: revolut_x_item_path(revolut_x_item),
                method: :delete,
                confirm: CustomConfirm.for_resource_deletion(revolut_x_item.name, high_severity: true)
              ) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% unless revolut_x_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if visible_accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: visible_accounts %>
        <% end %>

        <% stats = revolut_x_item.syncs.ordered.first&.sync_stats || {} %>
        <%= render ProviderSyncSummary.new(stats: stats, provider_item: revolut_x_item, show_account_details: visible_accounts.size == revolut_x_item.accounts.size) %>

        <% if unlinked_count.to_i > 0 && revolut_x_item.accounts.empty? %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".setup_needed") %></p>
            <p class="text-secondary text-sm"><%= t(".setup_description") %></p>
            <%= render DS::Link.new(
              text: t(".setup_action"),
              icon: "plus",
              variant: "primary",
              href: setup_accounts_revolut_x_item_path(revolut_x_item),
              frame: :modal
            ) %>
          </div>
        <% elsif revolut_x_item.accounts.empty? && revolut_x_item.revolut_x_accounts.none? %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".no_accounts_title") %></p>
            <p class="text-secondary text-sm"><%= t(".no_accounts_message") %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
