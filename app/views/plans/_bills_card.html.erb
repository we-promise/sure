<%# locals: () %>

<%= render DS::Card.new do %>
  <div class="flex flex-wrap items-center gap-2 mb-2">
    <span class="w-7 h-7 rounded-lg bg-surface-inset text-secondary flex items-center justify-center shrink-0">
      <%= icon("receipt", size: "sm") %>
    </span>
    <h2 class="text-sm font-medium text-primary shrink-0"><%= t(".title") %></h2>
  </div>
  <p class="text-sm text-secondary"><%= t(".body") %></p>
  <%= render DS::Link.new(
    text: t(".view_bills"),
    variant: "secondary",
    href: bills_path,
    icon: "chevron-right",
    icon_position: :right,
    full_width: true,
    class: "mt-5"
  ) %>
<% end %>
