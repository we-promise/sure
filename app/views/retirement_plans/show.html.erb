<div class="@container space-y-6 pb-6 lg:pb-12">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
        <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
      </div>
      <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
    </div>
    <%= render DS::Link.new(text: t(".settings"), variant: "secondary", size: "sm",
                            icon: "settings-2", href: edit_retirement_plan_path, frame: :modal) %>
  </header>

  <% @unconverted.each do |kind, count| %>
    <%= tag.div data: { unconverted: kind } do %>
      <%= render DS::Alert.new(variant: :warning, message: t(".unconverted_#{kind}", count: count)) %>
    <% end %>
  <% end %>

  <%= render DS::Card.new do %>
    <%= render RetirementPlans::PlannerComponent.new(
      plan: @retirement_plan, simulation: @simulation, solution: @solution,
      currency: Current.user.family.currency, milestones: @milestones
    ) %>
  <% end %>

  <% if @monte_carlo_available %>
    <%= render DS::Card.new do %>
      <h2 class="text-sm font-medium text-primary mb-3"><%= t(".monte_carlo") %></h2>
      <%= turbo_frame_tag "retirement-plan-monte-carlo-frame", src: monte_carlo_retirement_plan_path(as_of: @as_of.iso8601), loading: :lazy do %>
        <p class="text-sm text-secondary"><%= t(".monte_carlo_loading", paths: number_with_delimiter(RetirementPlan::MONTE_CARLO_PATHS)) %></p>
      <% end %>
    <% end %>
  <% end %>

  <%= render DS::Card.new do %>
    <div class="flex items-center justify-between gap-2 mb-3">
      <h2 class="text-sm font-medium text-primary"><%= t(".streams") %></h2>
      <%= render DS::Link.new(text: t(".add_stream"), variant: "secondary", size: "sm", icon: "plus",
                              href: new_retirement_plan_stream_path, frame: :modal) %>
    </div>

    <% if @streams.any? %>
      <%= render DS::Table.new(rows: @streams, id: "retirement-plan-streams", inset: true, label: t(".streams"),
                               row_opts: ->(stream) { { data: { stream_id: stream.id } } }) do |table| %>
        <% table.with_column(t(".columns.name"), row_header: true) { |stream| stream.name } %>
        <% table.with_column(t(".columns.kind")) { |stream| t(".stream_kinds.#{stream.kind}") } %>
        <% table.with_column(t(".columns.years")) do |stream| %>
          <% if stream.kind == "one_off" %>
            <%= t(".stream_once", year: stream.start_year || t(".now")) %>
          <% else %>
            <%= t(".stream_years", from: stream.start_year || t(".now"), to: stream.end_year || t(".end_age")) %>
          <% end %>
          <% unless stream.indexed %><span class="text-xs text-subdued"><%= t(".fixed") %></span><% end %>
        <% end %>
        <% table.with_column(t(".columns.amount"), numeric: true, class: "privacy-sensitive") { |stream| Money.new(stream.annual_amount, stream.currency).format(precision: 0) } %>
        <% table.with_column("", align: :right) do |stream| %>
          <%= render DS::Menu.new do |menu| %>
            <% menu.with_item(variant: "link", text: t(".edit"), icon: "pencil-line",
                              href: edit_retirement_plan_stream_path(stream), data: { turbo_frame: :modal }) %>
            <% menu.with_item(variant: "button", text: t(".delete"), icon: "trash-2",
                              href: retirement_plan_stream_path(stream), method: :delete, destructive: true,
                              confirm: t(".confirm_delete", name: stream.name)) %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".no_streams") %></p>
    <% end %>
  <% end %>
</div>
