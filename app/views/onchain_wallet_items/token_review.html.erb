<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title"), subtitle: t(".subtitle", chain: Onchain::Chains.find!(@chain).label, address: @address)) %>

  <% dialog.with_body do %>
    <%= render "onchain_wallet_items/token_review_form",
               chain: @chain,
               address: @address,
               review: @review,
               url: link_wallet_onchain_wallet_items_path,
               submit_label: t(".import_selected"),
               assets_truncated: @assets_truncated %>
  <% end %>
<% end %>
