<%= link_to t(".back"), rules_path %>

<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title", resource: t("transactions.index.#{@rule.resource_type}", default: @rule.resource_type))) %>
  <% dialog.with_body do %>
    <%= render "rules/form", rule: @rule %>
  <% end %>
<% end %>
