<%= link_to t("rules.form.back"), rules_path %>

<%= render DS::Dialog.new do |dialog| %>
  <%
    title = if @rule.name.present?
              t("rules.edit.title_named", name: @rule.name)
            else
              t("rules.edit.title")
            end
  %>
  <% dialog.with_header(title: title) %>

  <% dialog.with_body do %>
    <%= render "rules/form", rule: @rule %>
  <% end %>
<% end %>
