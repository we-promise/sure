<%= link_to t("rules.new.back"), rules_path %>

<%= render DS::Dialog.new do |dialog| %>
  <%
    resource = t("transactions.index.#{@rule.resource_type}", default: @rule.resource_type)
    title = if @rule.name.present?
              t(".title_with_name", resource: resource, name: @rule.name)
            else
              t(".title", resource: resource)
            end
  %>
  <% dialog.with_header(title: title) %>

  <% dialog.with_body do %>
    <%= render "rules/form", rule: @rule %>
  <% end %>
<% end %>
