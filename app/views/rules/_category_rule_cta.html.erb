<%# locals: (cta:) %>
<% message = t(".message", category_name: cta[:category_name]) %>
<% description = t(".description") %>
<%# The X closes just this prompt. "Hide for 24h" snoozes rule prompts, "Never suggest" turns them off. %>
<%= render "shared/notifications/cta", message: message, description: description, close_label: t(".close") do %>
  <%# Full i18n keys inside this block: lazy t(".x") would resolve against the shared cta partial. %>
  <%= form_with model: Current.user, url: rule_prompt_settings_user_path(Current.user), method: :patch do |f| %>
    <%= f.hidden_field :rule_prompt_dismissed_at, value: Time.current %>
    <%= tag.div class: "flex flex-wrap gap-2 justify-end" do %>
      <%= render DS::Button.new(text: t("rules.category_rule_cta.hide_for_24h"), variant: "secondary", type: :submit) %>
      <% rule_href = new_rule_path(resource_type: "transaction", action_type: "set_transaction_category", action_value: cta[:category_id], name: cta[:merchant_name]) %>
      <%= render DS::Link.new(text: t("rules.category_rule_cta.create_rule"), variant: "primary", href: rule_href, frame: :modal) %>
    <% end %>
    <%# Turns rule suggestions off; Settings > Preferences turns them back on. %>
    <div class="flex justify-end mt-1">
      <%= render DS::Button.new(text: t("rules.category_rule_cta.never_suggest"), variant: "ghost", size: :sm, type: :submit,
            name: "user[rule_prompts_disabled]", value: "true", class: "text-secondary") %>
    </div>
  <% end %>
<% end %>
