<%# locals: (cta:) %>
<% message = t(".message", category_name: cta[:category_name]) %>
<% description = t(".description") %>
<%= render "shared/notifications/cta", message: message, description: description do %>
  <%# Closes just this prompt. "Hide for today" below is the one that snoozes prompts. %>
  <%# Full i18n keys inside this block: lazy t(".x") would resolve against the shared cta partial. %>
  <button type="button"
          class="absolute top-2 right-2 p-1 rounded-md text-secondary hover:text-primary hover:bg-container-inset-hover"
          aria-label="<%= t("rules.category_rule_cta.close") %>"
          title="<%= t("rules.category_rule_cta.close") %>"
          data-action="element-removal#remove">
    <%= icon "x", size: "sm", color: "current" %>
  </button>

  <%= form_with model: Current.user, url: rule_prompt_settings_user_path(Current.user), method: :patch do |f| %>
    <div class="flex gap-2 items-center mb-3 -mt-1">
      <%= f.check_box :rule_prompts_disabled, class: "checkbox checkbox--light" %>
      <%= f.label :rule_prompts_disabled, t("rules.category_rule_cta.dont_show_again"), class: "text-xs text-secondary" %>
    </div>
    <%= f.hidden_field :rule_prompt_dismissed_at, value: Time.current %>
    <%= tag.div class:"flex gap-2 justify-end" do %>
      <%= render DS::Button.new(text: t("rules.category_rule_cta.hide_for_today"), variant: "secondary", type: :submit, title: t("rules.category_rule_cta.hide_for_today_hint")) %>
      <% rule_href = new_rule_path(resource_type: "transaction", action_type: "set_transaction_category", action_value: cta[:category_id], name: cta[:merchant_name]) %>
      <%= render DS::Link.new(text: t("rules.category_rule_cta.create_rule"), variant: "primary", href: rule_href, frame: :modal) %>
    <% end %>
  <% end %>
<% end %>
