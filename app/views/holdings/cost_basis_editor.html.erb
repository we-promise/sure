<%= turbo_frame_tag dom_id(@holding, :cost_basis_editor) do %>
  <div class="p-4 min-w-70 text-left">
    <h4 class="font-medium text-sm mb-3">
      <%= t("holdings.cost_basis_cell.set_cost_basis_header", ticker: @holding.ticker) %>
    </h4>
    <%= render "holdings/cost_basis_form", holding: @holding, context: :popover, cancel_action: "DS--popover#close" %>
  </div>
<% end %>
