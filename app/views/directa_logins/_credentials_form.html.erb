<%# locals: (title:, submit_label:, broker_account:, encryption_ready:) %>

<section class="space-y-4 rounded-xl border border-primary bg-container p-4">
  <h2 class="text-lg font-semibold text-primary"><%= title %></h2>

  <%= styled_form_with url: start_directa_login_path,
                       method: :post,
                       scope: :directa_login,
                       class: "space-y-3" do |form| %>
    <%= form.text_field :broker_account,
                        id: "broker_account",
                        label: t("directa_logins.show.broker_account_label"),
                        autocomplete: "username",
                        autocorrect: "off",
                        autocapitalize: "off",
                        spellcheck: false,
                        required: true,
                        value: broker_account %>
    <%= form.password_field :password,
                            id: "current-password",
                            label: t("directa_logins.show.password_label"),
                            autocomplete: "current-password",
                            required: true,
                            value: nil %>
    <div class="flex flex-wrap justify-end gap-2">
      <%= form.submit submit_label, disabled: !encryption_ready %>
    </div>
  <% end %>
</section>
