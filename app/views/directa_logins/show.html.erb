<% page_title_key = @directa_session_configured ? ".connected_title" : ".title" %>
<%= content_for :page_title, t(page_title_key) %>

<main class="mx-auto max-w-3xl space-y-6">
  <header class="space-y-3">
    <%= render DS::Pill.new(label: t(".preview"), tone: :violet, marker: false) %>
    <h1 class="text-2xl font-semibold text-primary"><%= t(page_title_key) %></h1>
    <p class="text-sm text-secondary"><%= t(@directa_session_configured ? ".connected_description" : ".description") %></p>
    <p class="text-sm text-secondary"><%= t(".read_only") %></p>
  </header>

  <% unless @encryption_ready %>
    <%= render DS::Alert.new(
          variant: :warning,
          title: t(".encryption_warning.title"),
          message: t(".encryption_warning.message")
        ) %>
  <% end %>

  <% if @login_error_key.present? %>
    <%= render DS::Alert.new(message: t(@login_error_key), variant: :error) %>
  <% end %>

  <% if flash[:notice].present? %>
    <%= render DS::Alert.new(message: flash[:notice], variant: :info) %>
  <% end %>
  <% if flash[:alert].present? %>
    <%= render DS::Alert.new(message: flash[:alert], variant: :error) %>
  <% end %>

  <% if @directa_session_configured %>
    <p class="text-sm text-secondary" role="status" aria-live="polite">
      <%= t(@directa_waiting_for_first_snapshot ? ".status_waiting_for_snapshot" : ".status_connected") %>
    </p>
    <% if @directa_item.present? %>
      <% history_synced_at = @directa_item.directa_account&.history_synced_at %>
      <section class="space-y-2 rounded-xl border border-primary bg-container p-4" aria-labelledby="directa-history-heading">
        <h2 id="directa-history-heading" class="text-sm font-medium text-primary"><%= t(".history_status_heading") %></h2>
        <% if @directa_item.history_sync_error_code.present? %>
          <p class="text-sm text-warning" role="status" aria-live="polite">
            <%= t(".history_status_failed", error: @directa_item.last_history_sync_error) %>
          </p>
          <% if history_synced_at.present? %>
            <p class="text-sm text-secondary">
              <%= t(".history_status_last_success", date: I18n.l(history_synced_at.to_date, format: :long)) %>
            </p>
          <% end %>
        <% elsif history_synced_at.present? %>
          <p class="text-sm text-secondary" role="status" aria-live="polite">
            <%= t(".history_status_synced", date: I18n.l(history_synced_at.to_date, format: :long)) %>
          </p>
        <% else %>
          <p class="text-sm text-secondary" role="status" aria-live="polite"><%= t(".history_status_waiting") %></p>
        <% end %>
        <p class="text-sm text-secondary"><%= t(".history_scope") %></p>
      </section>
    <% end %>
  <% elsif @directa_requires_update %>
    <p class="text-sm text-warning" role="status" aria-live="polite"><%= t(".status_requires_update") %></p>
  <% end %>

  <% if @directa_error_code.present? && !@suppress_first_snapshot_valuation_error %>
    <p class="text-sm text-secondary"><%= t("settings.providers.directa_panel.errors.#{@directa_error_code}") %></p>
  <% end %>

  <% if @directa_session_configured && @pending_login.blank? && !@login_in_progress %>
    <% if @directa_syncable %>
      <div class="flex justify-end">
        <%= render DS::Button.new(
              text: t(".sync_now"),
              icon: "refresh-cw",
              variant: :secondary,
              href: sync_directa_item_path(@directa_item),
              disabled: @directa_syncing
            ) %>
      </div>
    <% end %>

    <%= render DS::Disclosure.new(variant: :inline, open: @login_error_key.present?) do |disclosure| %>
      <% disclosure.with_summary_content do %>
        <span class="flex items-center gap-2 py-2 text-sm text-secondary hover:text-primary">
          <%= icon "chevron-right", size: "sm", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>
          <%= t(".reconnect_disclosure_title") %>
        </span>
      <% end %>

      <div class="space-y-4">
        <p class="text-sm text-secondary"><%= t(".reconnect_disclosure_description") %></p>
        <%= render "directa_logins/credentials_form",
                   title: t(".reconnect_title"),
                   submit_label: t(".reconnect"),
                   broker_account: @directa_item.broker_account,
                   encryption_ready: @encryption_ready %>
      </div>
    <% end %>
  <% end %>

  <% if @pending_login&.fetch(:stage, nil) == "otp_required" %>
    <section class="space-y-4 rounded-xl border border-primary bg-container p-4">
      <h2 class="text-lg font-semibold text-primary"><%= t(".otp_title") %></h2>
      <p class="text-sm text-secondary"><%= t(".otp_description", attempts: @pending_login.fetch(:attempts_remaining)) %></p>

      <%= styled_form_with url: complete_directa_login_path,
                           method: :post,
                           scope: :directa_login,
                           class: "space-y-3" do |form| %>
        <%= form.text_field :otp_code,
                            id: "directa-otp-code",
                            label: t(".otp_label"),
                            autocomplete: "one-time-code",
                            inputmode: "numeric",
                            enterkeyhint: "done",
                            autocorrect: "off",
                            autocapitalize: "off",
                            spellcheck: false,
                            maxlength: 12,
                            pattern: "[0-9]{1,12}",
                            required: true,
                            value: nil %>
        <%= form.hidden_field :attempt_id, value: @pending_login.fetch(:attempt_id) %>
        <div class="flex flex-wrap gap-2">
          <%= form.submit t(".verify_otp"), disabled: !@encryption_ready %>
        </div>
      <% end %>

      <%= styled_form_with url: cancel_directa_login_path,
                           method: :delete,
                           scope: :directa_login do |form| %>
        <%= form.hidden_field :attempt_id, value: @pending_login.fetch(:attempt_id) %>
        <%= form.submit t(".cancel_login"), class: "text-sm text-secondary" %>
      <% end %>
    </section>
  <% elsif @pending_login&.fetch(:stage, nil) == "otp_submitting" %>
    <p class="text-sm text-secondary" role="status" aria-live="polite"><%= t(".status_checking_code") %></p>
  <% elsif @login_in_progress %>
    <p class="text-sm text-secondary" role="status" aria-live="polite"><%= t(".status_other_session") %></p>
  <% elsif !@directa_session_configured %>
    <% login_title = @directa_requires_update ? ".reconnect_title" : ".connect_title" %>
    <% login_action = @directa_requires_update ? ".reconnect" : ".connect" %>
    <%= render "directa_logins/credentials_form",
               title: t(login_title),
               submit_label: t(login_action),
               broker_account: @directa_item&.broker_account,
               encryption_ready: @encryption_ready %>
  <% end %>

  <%= render DS::Link.new(text: t(".back_to_providers"), href: settings_providers_path, variant: :secondary) %>
</main>
