<%# locals: (lot:, account:, submit_label:) %>
<% form_url = lot.persisted? ? physical_gold_lot_path(lot) : physical_gold_lots_path %>
<% form_method = lot.persisted? ? :patch : :post %>
<%= styled_form_with model: lot, url: form_url, method: form_method, class: "space-y-4", data: { turbo_frame: :_top } do |form| %>
  <%= hidden_field_tag :account_id, account.id if lot.new_record? %>
  <%= form.text_field :description, label: t("physical_gold_lots.form.description"), required: true %>
  <%= form.date_field :acquired_on, label: t("physical_gold_lots.form.acquired_on"), required: true, max: Date.current %>
  <%= form.number_field :weight, label: t("physical_gold_lots.form.weight"), min: 0.001, step: 0.001, required: true %>
  <%= form.select :weight_unit, [[t("physical_gold_lots.form.grams"), "gram"], [t("physical_gold_lots.form.troy_ounces"), "troy_ounce"], [t("physical_gold_lots.form.kilograms"), "kilogram"]], { label: t("physical_gold_lots.form.weight_unit"), include_blank: true }, required: true %>
  <%= form.number_field :karat, label: t("physical_gold_lots.form.karat"), min: 0.1, max: 24, step: 0.1, required: true %>
  <%= render DS::MerchantSelect.new(form: form, method: :merchant_id, merchants: account.family.merchants.alphabetically.to_a, selected_id: lot.merchant_id, include_blank: t("physical_gold_lots.form.no_merchant"), label: t("physical_gold_lots.form.merchant")) %>
  <%= form.money_field :cost_amount, label: t("physical_gold_lots.form.cost_amount"), default_currency: account.currency, required: true %>
  <%= form.money_field :making_charge, label: t("physical_gold_lots.form.making_charge"), default_currency: account.currency %>
  <%= form.money_field :manual_value, label: t("physical_gold_lots.form.manual_value"), default_currency: account.currency %>
  <p class="text-xs text-secondary"><%= t("physical_gold_lots.form.manual_value_hint") %></p>
  <%= form.text_area :notes, label: t("physical_gold_lots.form.notes") %>
  <% if lot.invoice.attached? %>
    <div class="rounded-xl bg-container-inset p-1">
      <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
        <p><%= t("physical_gold_lots.form.invoice") %></p>
        <span class="text-subdued">&middot;</span>
        <p>1</p>
      </div>
      <div class="flex items-center justify-between gap-3 rounded-lg bg-container px-3 py-3 shadow-border-xs">
        <%= link_to physical_gold_lot_invoice_path(lot), target: "_blank", data: { turbo_frame: :_top }, class: "flex min-w-0 items-center gap-2 text-sm font-medium text-primary hover:underline" do %>
          <%= icon(lot.invoice.image? ? "image" : "file-text", size: "sm") %>
          <span class="truncate"><%= lot.invoice.filename %></span>
        <% end %>
        <div class="flex shrink-0 items-center gap-1">
          <%= render DS::Link.new(variant: :icon, icon: "eye", aria_label: t("physical_gold_lots.form.view_invoice"), title: t("physical_gold_lots.form.view_invoice"), href: physical_gold_lot_invoice_path(lot), target: "_blank") %>
          <%= render DS::Button.new(variant: :icon, icon: "trash-2", aria_label: t("physical_gold_lots.form.remove_invoice"), title: t("physical_gold_lots.form.remove_invoice"), href: physical_gold_lot_invoice_path(lot), method: :delete, data: { turbo_confirm: t("physical_gold_lots.form.remove_invoice_confirm"), turbo_frame: :_top }) %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="rounded-xl bg-container-inset p-4">
      <%= form.label :invoice, t("physical_gold_lots.form.invoice"), class: "form-field__label" %>
      <%= form.file_field :invoice, accept: PhysicalGoldLot::ALLOWED_INVOICE_CONTENT_TYPES.join(","), class: "form-field__input" %>
      <p class="mt-2 text-xs text-secondary"><%= t("physical_gold_lots.form.invoice_hint", max_size: PhysicalGoldLot::INVOICE_MAX_SIZE / 1.megabyte) %></p>
    </div>
  <% end %>
  <%= form.submit submit_label %>
<% end %>
