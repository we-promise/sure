<%# locals: (overview:) %>

<div class="space-y-3" id="liquidity-release-timeline">
  <h3 class="text-sm font-medium text-primary"><%= t(".title") %></h3>

  <% if overview.bound? %>
    <% buckets = overview.release_buckets.select { |bucket| bucket.releases.any? } %>
    <% max = buckets.map { |bucket| bucket.total.amount }.max %>

    <div class="bg-container-inset rounded-xl p-1">
      <div class="rounded-lg bg-container text-sm font-medium">
        <% buckets.each_with_index do |bucket, idx| %>
          <%= render DS::Disclosure.new(summary_class: "cursor-pointer p-4 rounded-lg flex items-center gap-3 focus-ring", body_class: nil, data: { liquidity_bucket: bucket.key }) do |disclosure| %>
            <% disclosure.with_summary_content do %>
              <%= icon "chevron-right", size: "sm", class: "motion-safe:transition-transform group-open:rotate-90 shrink-0" %>
              <p class="w-36 shrink-0"><%= liquidity_bucket_label(bucket.key) %></p>
              <div class="flex-1 h-1.5 bg-container-inset rounded-full overflow-hidden" aria-hidden="true">
                <div class="h-full rounded-full <%= bucket.key == "long_term" ? liquidity_level_bar_class("long_term") : liquidity_level_bar_class("locked") %>" style="inline-size: <%= liquidity_bar_width(bucket.total.amount, max) %>%;"></div>
              </div>
              <p class="w-24 shrink-0 text-right privacy-sensitive"><%= format_money(bucket.total, precision: 0) %></p>
            <% end %>

            <ul>
              <% bucket.releases.each do |release| %>
                <li class="pl-10 pr-4 py-3 flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <%= link_to release.account.name, account_path(release.account), class: "truncate block" %>
                    <p class="text-xs text-secondary font-normal">
                      <% if release.date %>
                        <%= l(release.date, format: :long) %> · <%= liquidity_release_remaining(release) %>
                        <%= "· #{t(".renews")}" if release.auto_renew %>
                      <% else %>
                        <%= bucket.key == "long_term" ? t("accounts.liquidity.levels.long_term") : t(".no_date") %>
                      <% end %>
                    </p>
                  </div>
                  <p class="w-24 shrink-0 text-right privacy-sensitive"><%= format_money(release.amount, precision: 0) %></p>
                </li>
              <% end %>
            </ul>
          <% end %>

          <% if idx < buckets.size - 1 %>
            <%= render "shared/ruler", classes: "mx-4" %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="text-sm text-secondary"><%= t(".empty") %></p>
  <% end %>
</div>
