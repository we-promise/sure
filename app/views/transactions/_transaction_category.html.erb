<%# locals: (transaction:, variant:, in_split_group: false) %>

<div id="<%= dom_id(transaction, "category_menu_#{variant}") %>" class="min-w-0 overflow-hidden">
  <% if transaction.category_editable? %>
    <%= render "categories/menu", transaction: transaction, in_split_group: in_split_group %>
  <% else %>
    <% category = read_only_category(transaction) %>
    <% set_on_counterpart = transaction.category_set_on_transfer_counterpart? %>
    <div class="hidden lg:flex items-center gap-1 min-w-0">
      <div class="<%= "opacity-60 cursor-not-allowed" if set_on_counterpart %>">
        <%= render "categories/badge", category: category %>
      </div>
      <% if set_on_counterpart %>
        <%= render DS::Tooltip.new(text: t("transactions.transaction_category.set_on_counterpart")) %>
      <% end %>
    </div>
    <div class="flex lg:hidden">
      <%= render "categories/badge_mobile", category: category %>
    </div>
  <% end %>
</div>
