<%# locals: (form:) %>

<div class="space-y-2">
  <div class="form-field">
    <%= form.select :amount_operator, options_for_select([
      [t(".equal_to"), "equal"],
      [t(".greater_than"), "greater"],
      [t(".less_than"), "less"]
    ], @q[:amount_operator] || "equal"), {}, class: "form-field__input" %>
  </div>

  <%# Compared with amounts in every account currency, so decimals stay allowed. %>
  <% amount, precision = money_field_value(@q[:amount], min_precision: 2) %>
  <%= fields :q, builder: StyledFormBuilder do |amount_form| %>
    <%= amount_form.money_field :amount,
          value: amount,
          label: t(".placeholder"),
          label_class: "sr-only",
          precision: precision,
          placeholder: t(".placeholder"),
          hide_currency: true,
          currency_value_override: Current.family.currency %>
  <% end %>
</div>
