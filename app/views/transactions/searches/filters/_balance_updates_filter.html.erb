<%# locals: (form:) %>
<%# Shows a linked account's synced balance updates for this view only. Settings > Preferences keeps them shown for good, %>
<%# and then there is nothing left to switch here. %>
<% always_shown = Current.user.show_balance_updates? %>

<div class="p-2 space-y-3">
  <div class="flex items-center gap-3" data-filter-name="balance_updates">
    <%= form.check_box :balance_updates,
                       {
                         checked: always_shown || @q[:balance_updates] == "show",
                         disabled: always_shown,
                         class: "checkbox checkbox--light"
                       },
                       "show",
                       nil %>
    <%= form.label :balance_updates, t(".show"), class: "text-sm text-primary" %>
  </div>
  <p class="text-secondary text-sm">
    <%= t(always_shown ? ".always_shown" : ".hint") %>
    <%= link_to t(".preferences_link"), settings_preferences_path, class: "text-link underline underline-offset-2 hover:no-underline", data: { turbo_frame: "_top" } %>
  </p>
</div>
