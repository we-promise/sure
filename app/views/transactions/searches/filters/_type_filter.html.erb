<%# locals: (form:) %>

<div class="p-2 space-y-3">
  <% %w[income expense refund transfer].each do |type| %>
    <div class="flex items-center gap-3" data-filter-name="<%= type %>">
      <%= form.check_box :types,
            { multiple: true, checked: @q[:types]&.include?(type), class: "checkbox checkbox--light" },
            type, nil %>
      <%= form.label :types, t(".#{type}"), value: type, class: "text-sm text-primary" %>
    </div>
  <% end %>
</div>
