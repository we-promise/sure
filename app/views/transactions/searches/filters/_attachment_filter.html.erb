<%# locals: (form:) %>

<div class="p-2 space-y-3">
  <div class="flex items-center gap-3" data-filter-name="with">
    <%= form.check_box :attachment_status,
                           {
                             multiple: true,
                             checked: @q[:attachment_status]&.include?("with"),
                             class: "checkbox checkbox--light"
                           },
                           "with",
                           nil %>
    <%= form.label :attachment_status, t(".with"), value: "with", class: "text-sm text-primary" %>
  </div>
  <div class="flex items-center gap-3" data-filter-name="without">
    <%= form.check_box :attachment_status,
                           {
                             multiple: true,
                             checked: @q[:attachment_status]&.include?("without"),
                             class: "checkbox checkbox--light"
                           },
                           "without",
                           nil %>
    <%= form.label :attachment_status, t(".without"), value: "without", class: "text-sm text-primary" %>
  </div>
</div>
