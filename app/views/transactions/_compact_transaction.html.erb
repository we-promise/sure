<%# locals: (entry:, balance_trend: nil, view_ctx: "global", is_filtered: false, in_split_group: false, running_balance: nil, hide_balance: false) %>
<% transaction = entry.entryable %>
<% has_running_balance = defined?(running_balance) && running_balance.present? %>
<% drawer_params = { view_ctx: view_ctx, is_filtered: is_filtered } %>

<%= turbo_frame_tag dom_id(entry) do %>
  <%= turbo_frame_tag dom_id(transaction) do %>
    <div class="group flex items-center gap-2 lg:gap-3 text-primary text-sm font-medium py-2 px-3 <%= "pl-6 lg:pl-8" if in_split_group %>">
      <%# ☐ mint %>
      <div class="hidden lg:flex w-8 shrink-0 justify-center">
        <%= check_box_tag dom_id(entry, "selection"),
            disabled: transaction.transfer.present?,
            class: "checkbox checkbox--light",
            data: {
              id: entry.id,
              entry_type: entry.entryable_type,
              "bulk-select-target": "row",
              action: "bulk-select#toggleRowSelection",
              checkbox_toggle_target: "selectionEntry"
            } %>
      </div>

      <%# DATE mint — respects Settings date_format via format_date %>
      <% if has_running_balance %>
        <div class="hidden lg:flex w-[110px] shrink-0 text-secondary text-sm truncate pr-2"><%= format_date(entry.date) %></div>
      <% end %>

      <%# TRANSACTION flex 2 — account/transfer same as normal, both global and account, mobile same as normal %>
      <div class="flex items-center gap-2 lg:gap-3 flex-[2] min-w-0 pr-2">
        <div class="min-w-0 flex-1 <%= "opacity-50 text-secondary" if entry.excluded %>">
          <div class="flex items-center gap-1 min-w-0">
            <div class="truncate">
              <% if transaction.transfer? %>
                <%= link_to(
                      entry.name,
                      transaction.transfer.present? ? transfer_path(transaction.transfer) : entry_path(entry, drawer_params),
                      data: { turbo_frame: "drawer", turbo_prefetch: false },
                      class: "hover:underline truncate"
                    ) %>
              <% else %>
                <%= link_to(
                      entry.name,
                      in_split_group ? entry_path(entry, drawer_params.merge(grouped: true)) : entry_path(entry, drawer_params),
                      data: { turbo_frame: "drawer", turbo_prefetch: false },
                      class: "hover:underline truncate"
                    ) %>
              <% end %>
            </div>

            <div class="flex items-center gap-1 shrink-0">
              <% if transaction.pending? %>
                <%= render DS::Pill.new(label: t("transactions.transaction.pending"), tone: :neutral, marker: false, icon: "clock", title: t("transactions.transaction.pending_tooltip")) %>
              <% end %>
              <% if transaction.has_potential_duplicate? %>
                <%= render DS::Pill.new(label: transaction.low_confidence_duplicate? ? t("transactions.transaction.review_recommended") : t("transactions.transaction.possible_duplicate"), tone: transaction.low_confidence_duplicate? ? :neutral : :warning, marker: false, icon: transaction.low_confidence_duplicate? ? "help-circle" : "alert-triangle") %>
              <% end %>
              <% if @split_parent_entry_ids ? @split_parent_entry_ids.include?(entry.id) : entry.split_parent? %>
                <%= render DS::Pill.new(label: t("transactions.transaction.split"), tone: :neutral, marker: false, icon: "split") %>
              <% end %>
              <% if entry.split_child? && !in_split_group %>
                <%= render DS::Tooltip.new(text: t("transactions.transaction.split_child_tooltip"), icon: "corner-down-right", size: "sm") %>
              <% end %>
              <% if transaction.transfer.present? %>
                <%= render "transactions/transfer_match", transaction: transaction %>
              <% end %>
            </div>
          </div>

          <div class="text-secondary text-xs font-normal">
            <% if transaction.transfer? %>
              <span class="text-secondary">
                <%= transaction.loan_payment? ? t("transactions.show.loan_payment") : t("transactions.show.transfer") %> •
                <% if transaction.transfer.present? %>
                  <% counterpart = transaction.transfer_as_outflow.present? ? transaction.transfer.to_account : transaction.transfer.from_account %>
                  <% if counterpart.present? && @accessible_account_ids&.include?(counterpart.id) %>
                    <% if transaction.transfer_as_outflow.present? %>
                      <%= link_to entry.account.name, account_path(entry.account, tab: "transactions"), data: { turbo_frame: "_top" }, class: "hover:underline" %> → <%= link_to counterpart.name, account_path(counterpart, tab: "transactions"), data: { turbo_frame: "_top" }, class: "hover:underline" %>
                    <% else %>
                      <%= link_to entry.account.name, account_path(entry.account, tab: "transactions"), data: { turbo_frame: "_top" }, class: "hover:underline" %> ← <%= link_to counterpart.name, account_path(counterpart, tab: "transactions"), data: { turbo_frame: "_top" }, class: "hover:underline" %>
                    <% end %>
                  <% else %>
                    <%= link_to entry.account.name, account_path(entry.account, tab: "transactions"), data: { turbo_frame: "_top" }, class: "hover:underline" %>
                  <% end %>
                <% else %>
                  <%= link_to entry.account.name, account_path(entry.account, tab: "transactions"), data: { turbo_frame: "_top" }, class: "hover:underline" %>
                <% end %>
              </span>
            <% else %>
              <% if transaction.merchant&.present? %>
                <span class="hidden lg:inline truncate"><%= transaction.merchant.name %> • </span>
              <% end %>
              <span class="text-secondary hidden lg:inline">
                <%= link_to entry.account.name,
                    account_path(entry.account, tab: "transactions"),
                    data: { turbo_frame: "_top" },
                    class: "hover:underline" %>
              </span>
              <div class="flex min-w-0 items-center gap-1">
                <%= render "categories/category_name_mobile", transaction: transaction %>
                <% if transaction.merchant&.present? %>
                  <span class="lg:hidden min-w-0 truncate">• <%= transaction.merchant.name %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# NOTES flex 2 — single line truncate %>
      <div class="hidden lg:flex min-w-0 flex-[2] px-2">
        <% if entry.notes.present? %>
          <span class="truncate block text-sm text-secondary privacy-sensitive" title="<%= entry.notes %>"><%= entry.notes %></span>
        <% else %>
          <span class="text-secondary/40 text-sm">—</span>
        <% end %>
      </div>

      <%# CATEGORY flex 1 %>
      <div class="hidden md:flex min-w-0 items-center gap-1 flex-[1]">
        <% if entry.account.supports_trades? && !transaction.transfer? %>
          <%= render "investment_activity/quick_edit_badge", entry: entry, entryable: transaction, view_ctx: view_ctx, is_filtered: is_filtered %>
        <% else %>
          <%= render "transactions/transaction_category", transaction: transaction, variant: "desktop", in_split_group: in_split_group %>
        <% end %>
      </div>

      <%# AMOUNT mint %>
      <div class="w-[120px] shrink-0 flex items-center justify-end gap-2 <%= "opacity-50" if entry.excluded %>">
        <% if entry.protected_from_sync? && !entry.excluded? %>
          <%= link_to entry_path(entry, drawer_params), data: { turbo_frame: "drawer", turbo_prefetch: false }, class: "invisible group-hover:visible transition-opacity" do %>
            <%= render DS::Tooltip.new(text: t("entries.protection.tooltip"), icon: "lock", size: "sm", as: :span) %>
          <% end %>
        <% end %>
        <%= content_tag :p,
            transaction.transfer? && view_ctx == "global" ? "+/- #{format_money(entry.amount_money.abs)}" : format_money(-entry.amount_money),
            class: ["privacy-sensitive text-sm font-medium truncate", "text-green-600": entry.amount.negative?] %>
      </div>

      <%# BALANCE mint — global never, account filtered hides (partial table) %>
      <% if has_running_balance && view_ctx == "account" && !hide_balance %>
        <div class="hidden lg:flex w-[120px] shrink-0 justify-end px-2">
          <span class="privacy-sensitive text-sm font-medium text-primary truncate" title="<%= format_money(running_balance) %>"><%= format_money(running_balance) %></span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
