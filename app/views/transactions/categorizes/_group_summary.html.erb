<%= turbo_frame_tag "categorize_group_summary" do %>
  <p class="text-sm text-secondary">
    <%= t("transactions.categorizes.show.transaction_count", count: entries.size) %>
    &middot;
    <% if (total = Transaction::Grouper.total_in(entries, currency: Current.family.currency)) %>
      <span class="privacy-sensitive"><%= format_money(total) %></span>
    <% else %>
      <%= t(".missing_rate") %>
    <% end %>
  </p>
<% end %>
