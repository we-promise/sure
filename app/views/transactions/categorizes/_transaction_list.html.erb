<%= turbo_frame_tag "categorize_transaction_list" do %>
  <%# White rows inside the caller's inset well (entries/_entry_group idiom).
      Scroll-capped only from lg: — on touch, an inner scroller in the drag
      path traps the page scroll. %>
  <div class="shadow-border-xs rounded-lg overflow-hidden bg-container">
    <div class="lg:max-h-[24rem] lg:overflow-y-auto scrollbar divide-y divide-alpha-black-200 theme-dark:divide-alpha-white-200">
      <% entries.each do |entry| %>
        <%= render partial: "transactions/categorizes/entry_row", locals: { entry: entry, categories: categories } %>
      <% end %>
    </div>
  </div>
<% end %>
