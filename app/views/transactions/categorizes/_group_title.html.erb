<%= turbo_frame_tag "categorize_group_title" do %>
  <div class="flex items-center gap-2">
    <h2 class="text-lg font-semibold text-primary"><%= display_name %></h2>
    <% if transaction_type == "income" %>
      <%= render DS::Pill.new(label: t("transactions.categorizes.show.type_income"), tone: :success, marker: false) %>
    <% elsif transaction_type == "expense" %>
      <%= render DS::Pill.new(label: t("transactions.categorizes.show.type_expense"), tone: :neutral, marker: false) %>
    <% end %>
  </div>
<% end %>
