<%# locals: (entry:) %>
<% merchant = entry.transaction.merchant %>
<% category = entry.transaction.category %>
<% rule_href = new_rule_path({
  resource_type: "transaction",
  name: merchant&.name || entry.name,
  merchant_id: merchant&.id,
  action_type: ("set_transaction_category" if category),
  action_value: category&.id
}.compact) %>
<div class="flex items-center justify-between gap-2 p-3" id="<%= dom_id(entry, :create_rule) %>">
  <div class="text-sm space-y-1">
    <h4 class="text-primary"><%= t("transactions.show.create_rule_title") %></h4>
    <p class="text-secondary"><%= t("transactions.show.create_rule_subtitle") %></p>
  </div>
  <%= render DS::Link.new(
    text: t("transactions.show.create_rule"),
    icon: "git-branch",
    variant: "outline",
    href: rule_href,
    frame: :modal
  ) %>
</div>
