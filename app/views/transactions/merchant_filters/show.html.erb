<%= turbo_frame_tag "merchant_filter_options" do %>
  <%= fields :q do |form| %>
    <% @merchants.each do |merchant| %>
      <div class="filterable-item flex items-center gap-2 p-2" data-filter-name="<%= merchant.name %>">
        <%= form.check_box :merchants,
                           {
                             multiple: true,
                             checked: @selected.include?(merchant.filter_value),
                             class: "checkbox checkbox--light"
                           },
                           merchant.filter_value,
                           nil %>
        <%= form.label :merchants, value: merchant.filter_value, class: "text-sm text-primary flex items-center gap-2" do %>
          <div class="hidden lg:flex">
            <% if merchant.logo_url.present? %>
              <%= image_tag Setting.transform_brand_fetch_url(merchant.logo_url),
                  class: "w-6 h-6 rounded-full border border-secondary",
                  loading: "lazy" %>
            <% else %>
              <%= render DS::FilledIcon.new(
                variant: :text,
                hex_color: merchant.color,
                text: merchant.name,
                size: "sm",
                rounded: true
              ) %>
            <% end %>
          </div>
          <%= merchant.name %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
