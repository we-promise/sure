<%# locals: (entry:) %>
<%# Manual reconciliation status — only meaningful for manual (unsynced) accounts.
    Synced accounts already have duplicate-matching + statement-level reconciliation
    (see Entry#reconciled_status for the full rationale). %>
<% if entry.account.manual? %>
  <%= link_to reconcile_transaction_path(entry.transaction),
      data: { turbo_method: :patch, turbo_frame: "_top" },
      class: "hover:opacity-80 transition-opacity" do %>
    <%= render DS::Pill.new(
      label: t("transactions.reconcile.statuses.#{entry.reconciled_status}"),
      tone: reconcile_status_tone(entry.reconciled_status),
      marker: false,
      icon: reconcile_status_icon(entry.reconciled_status),
      title: t("transactions.reconcile.badge.#{entry.reconciled_status}_tooltip")
    ) %>
  <% end %>
<% end %>
