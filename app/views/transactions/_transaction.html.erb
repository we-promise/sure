<%# locals: (entry:, balance_trend: nil, view_ctx: "global", is_filtered: false, in_split_group: false) %>

<% transaction = entry.entryable %>

<%# Cached per row; see TransactionsHelper#transaction_row_cache_key for what
    busts it; list any new partial or component in TRANSACTION_ROW_SOURCES.
    A pending transfer match is never cached: its confirm and reject forms
    embed the session's CSRF token, and the session may not be loaded yet. %>
<% cache_unless transaction.transfer&.pending?, transaction_row_cache_key(entry, view_ctx: view_ctx, in_split_group: in_split_group, is_filtered: is_filtered), expires_in: 12.hours, skip_digest: true do %>
<% transaction_security_logo_url = transaction.activity_security&.display_logo_url %>
<% drawer_params = { view_ctx: view_ctx, is_filtered: is_filtered } %>
<% open_path = if transaction.transfer?
     transaction.transfer.present? ? transfer_path(transaction.transfer, drawer_params) : entry_path(entry, drawer_params)
   else
     in_split_group ? entry_path(entry, drawer_params.merge(grouped: true)) : entry_path(entry, drawer_params)
   end %>
<%= turbo_frame_tag dom_id(entry) do %>
  <%= turbo_frame_tag dom_id(transaction) do %>
    <div class="group group/transaction flex lg:grid lg:grid-cols-12 items-center text-primary text-sm font-medium p-3 lg:p-4 [html[data-layout-animating]_&:not(:has([aria-expanded=true])):not(:has([role=tooltip]:not(.hidden)))]:[content-visibility:auto] [contain-intrinsic-size:auto_--spacing(18)] <%= "pl-8 lg:pl-12" if in_split_group %>"
         data-controller="clickable-row"
         data-action="click->clickable-row#open">

      <div class="pr-4 lg:pr-10 flex items-center gap-3 lg:gap-4 col-span-5 min-w-0 max-md:flex-1">
        <%= check_box_tag dom_id(entry, "selection"),
            disabled: transaction.transfer.present?,
            class: "checkbox checkbox--light hidden lg:block",
            data: {
              id: entry.id,
              entry_type: entry.entryable_type,
              "bulk-select-target": "row",
              action: "bulk-select#toggleRowSelection",
              checkbox_toggle_target: "selectionEntry"
            } %>

        <div class="flex md:hidden items-center gap-1 col-span-2 relative shrink-0">
          <%= render "transactions/transaction_category", transaction: transaction, variant: "mobile", in_split_group: in_split_group %>
          <% if transaction_security_logo_url.present? %>
            <%= image_tag Setting.transform_brand_fetch_url(transaction_security_logo_url),
                class: "w-5 h-5 rounded-full absolute -bottom-1 -right-1 border border-secondary pointer-events-none",
                loading: "lazy" %>
          <% elsif transaction.merchant&.logo_url.present? %>
            <%= image_tag Setting.transform_brand_fetch_url(transaction.merchant.logo_url),
                class: "w-5 h-5 rounded-full absolute -bottom-1 -right-1 border border-secondary pointer-events-none",
                loading: "lazy" %>
          <% end %>
        </div>

        <div class="flex-1 max-w-full min-w-0 <%= "opacity-50 text-secondary" if entry.excluded %>">
          <%= content_tag :div, class: ["flex items-center gap-3 lg:gap-4"] do %>
            <div class="hidden lg:flex shrink-0">
              <% if transaction.transfer? %>
                <%= render DS::FilledIcon.new(
                  icon: "arrow-right-left",
                  hex_color: Category::TRANSFER_COLOR,
                  size: "lg",
                  rounded: true
                ) %>
              <% elsif transaction_security_logo_url.present? %>
                <%= image_tag Setting.transform_brand_fetch_url(transaction_security_logo_url),
                    class: "w-9 h-9 rounded-full border border-secondary",
                    loading: "lazy" %>
              <% elsif transaction.merchant&.logo_url.present? %>
                <%= image_tag Setting.transform_brand_fetch_url(transaction.merchant.logo_url),
                    class: "w-9 h-9 rounded-full border border-secondary",
                    loading: "lazy" %>
              <% else %>
                <div class="hidden lg:flex">
                  <%= render DS::FilledIcon.new(
                    variant: :text,
                    text: entry.name,
                    size: "lg",
                    rounded: true
                  ) %>
                </div>
              <% end %>
            </div>

            <div class="truncate flex-1 min-w-0">
              <div class="space-y-0.5">
                <div class="flex items-center gap-1 min-w-0" data-tag-fit-bounds="0.5">
                  <div class="truncate flex-shrink">
                    <%= link_to(
                          entry.name,
                          open_path,
                          data: {
                            turbo_frame: "drawer",
                            turbo_prefetch: false,
                            clickable_row_target: "link"
                          },
                          class: "hover:underline"
                        ) %>
                  </div>

                  <div class="flex items-center gap-1 flex-shrink-0">
                    <%= render "transactions/badges", entry: entry, transaction: transaction, in_split_group: in_split_group, drawer_params: drawer_params, compact: true, show_pending: false %>
                  </div>

                  <div class="md:hidden flex shrink-0 min-w-0 max-w-1/2 has-[[data-tag-empty]]:hidden">
                    <%= render "tags/menu", entry: entry, transaction: transaction, variant: :mobile %>
                  </div>
                </div>

                <%= render "transactions/subtitle", entry: entry, transaction: transaction, view_ctx: view_ctx %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="hidden md:flex md:shrink-0 min-w-0 items-center gap-1 col-span-3 pr-2">
        <% if entry.account.supports_trades? && !transaction.transfer? %>
          <%# For investment/crypto accounts, show activity label instead of category %>
          <%= render "investment_activity/quick_edit_badge", entry: entry, entryable: transaction, view_ctx: view_ctx, is_filtered: is_filtered %>
        <% else %>
          <%= render "transactions/transaction_category", transaction: transaction, variant: "desktop", in_split_group: in_split_group %>
        <% end %>
      </div>

      <div class="col-span-4 ml-auto lg:ml-0 md:flex-none flex lg:flex-wrap items-center justify-end gap-2 lg:gap-4 min-w-0">
        <div class="<%= class_names("hidden md:flex md:w-40 lg:w-auto lg:flex-1 min-w-7 items-center", "lg:hidden": transaction.transfer? && transaction.tags.empty?) %>" data-tag-fit-bounds="1">
          <%= render "tags/menu", entry: entry, transaction: transaction, variant: :desktop %>
        </div>

        <div class="<%= class_names("flex justify-end min-w-0", transaction.transfer&.pending? ? "flex-col-reverse items-end gap-1 lg:flex-row lg:flex-wrap lg:items-center lg:gap-2" : "items-center gap-2 lg:gap-4") %>">
          <% if transaction.transfer.present? %>
            <%= render "transactions/transfer_match", transaction: transaction %>
          <% elsif @transfer_hint_transaction_ids&.include?(transaction.id) %>
            <span id="<%= dom_id(transaction, :transfer_hint) %>" class="flex shrink-0 items-center gap-1">
              <%= link_to new_transaction_transfer_match_path(entry),
                    class: "hover:opacity-80",
                    data: { turbo_frame: "modal" } do %>
                <%= render DS::Pill.new(
                  label: t("transactions.transaction.transfer_hint"),
                  tone: :info,
                  marker: false,
                  icon: "refresh-cw",
                  title: t("transactions.transaction.transfer_hint_tooltip")
                ) %>
              <% end %>
              <%= button_to transaction_transfer_match_path(entry),
                    method: :delete,
                    class: "text-subdued hover:text-primary flex items-center justify-center cursor-pointer",
                    title: t("transactions.transaction.transfer_hint_dismiss") do %>
                <%= icon "x", size: "sm", color: "current" %>
              <% end %>
            </span>
          <% end %>

          <div class="ml-auto flex min-w-0 max-w-full flex-col-reverse items-end justify-end gap-1 lg:flex-row lg:flex-wrap-reverse lg:items-center lg:gap-2 <%= "opacity-50" if entry.excluded %>">
            <% if transaction.pending? %>
              <%= render DS::Pill.new(label: t("transactions.transaction.pending"), tone: :neutral, marker: false, icon: "clock", title: t("transactions.transaction.pending_tooltip")) %>
            <% end %>

            <div class="shrink-0 flex items-center justify-end gap-2">
              <%# Protection indicator - shows on hover when entry is protected from sync %>
              <% if entry.protected_from_sync? && !entry.excluded? %>
                <%= link_to entry_path(entry, drawer_params),
                      data: { turbo_frame: "drawer", turbo_prefetch: false },
                      class: "invisible group-hover:visible transition-opacity",
                      title: t("entries.protection.tooltip") do %>
                  <%= icon "lock", size: "sm", class: "text-secondary" %>
                <% end %>
              <% end %>
              <%= content_tag :p,
                  transaction.transfer? && view_ctx == "global" ? "+/- #{format_money(entry.amount_money.abs)}" : format_money(-entry.amount_money),
                  class: ["privacy-sensitive shrink-0", "text-green-600": entry.amount.negative?] %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
<% end %>
