<%# locals: (entry:, view_ctx: "global", is_filtered: false, running_balance: nil, hide_balance: false, flat: false) %>
<% transaction = entry.entryable %>
<% show_date = flat %>
<% show_balance = flat && view_ctx == "account" && !hide_balance %>

<div data-controller="clickable-row" data-action="click->clickable-row#open">
  <%= render DS::CompactRow.new(show_date: show_date, show_balance: show_balance, muted: true) do |row| %>
    <% if show_date %>
      <% row.with_date { format_date(entry.date) } %>
    <% end %>

    <% row.with_primary do %>
      <div class="max-w-full min-w-0">
        <div class="space-y-0.5">
          <div class="flex items-center gap-1 min-w-0">
            <% if show_date %>
              <span class="lg:hidden shrink-0 text-secondary text-xs"><%= format_date(entry.date) %> • </span>
            <% end %>
            <div class="truncate flex-shrink">
              <%= link_to entry.name,
                  entry_path(entry, view_ctx: view_ctx, is_filtered: is_filtered),
                  data: { turbo_frame: "drawer", turbo_prefetch: false, clickable_row_target: "link" },
                  class: "hover:underline" %>
            </div>

            <div class="flex items-center gap-1 flex-shrink-0">
              <%= render DS::Pill.new(
                label: t("transactions.split_parent_row.split_label"),
                tone: :neutral,
                marker: false,
                icon: "split"
              ) %>
            </div>
          </div>

          <div class="text-secondary text-xs font-normal truncate">
            <% if transaction.merchant&.present? %>
              <span class="hidden lg:inline truncate"><%= transaction.merchant.name %> • </span>
            <% end %>
            <% if view_ctx != "account" %>
              <span class="text-secondary hidden lg:inline">
                <%= link_to entry.account.name,
                    account_path(entry.account, tab: "transactions"),
                    data: { turbo_frame: "_top" },
                    class: "hover:underline" %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% row.with_amount do %>
      <%= content_tag :p, format_money(-entry.amount_money), class: "privacy-sensitive text-sm font-medium truncate" %>
    <% end %>

    <% if show_balance %>
      <% row.with_balance do %>
        <% if running_balance.present? %>
          <span class="privacy-sensitive text-sm font-medium text-primary truncate" title="<%= format_money(running_balance) %>"><%= format_money(running_balance) %></span>
        <% else %>
          <span class="text-secondary/40 text-sm" title="<%= t("transactions.show.balance_unavailable") %>">—</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
