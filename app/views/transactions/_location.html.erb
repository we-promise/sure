<%# locals: (entry:, can_annotate:) %>
<% if preview_features_enabled? %>
  <%= turbo_frame_tag dom_id(entry, :location) do %>
    <%= styled_form_with model: entry, url: transaction_path(entry), data: { controller: "auto-submit-form" } do |f| %>
      <%= hidden_field_tag :grouped, "true" if params[:grouped] == "true" %>
      <%= render DS::LocationPicker.new(form: f, entry: entry, can_annotate: can_annotate) %>
    <% end %>
  <% end %>
<% end %>
