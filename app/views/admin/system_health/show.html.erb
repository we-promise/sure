<%= content_for :page_title, t(".title") %>

<%= render DS::Tabs.new(
  active_tab: @active_tab,
  url_param_key: "tab",
  navigate_on_change: true,
  testid: "system-health-tabs"
) do |tabs| %>
  <% tabs.with_nav do |nav| %>
    <% nav.with_btn(id: "background_jobs", label: t(".tabs.background_jobs")) %>
    <% nav.with_btn(id: "ai", label: t(".tabs.ai")) %>
  <% end %>

  <% tabs.with_panel(tab_id: "background_jobs") do %>
    <%= render "background_jobs", health: @health, push_notification_test: @push_notification_test,
      push_disabled_reason: @push_disabled_reason, latest_push_test: @latest_push_test,
      push_test_results: @push_test_results %>
  <% end %>

  <% tabs.with_panel(tab_id: "ai") do %>
    <%= render "ai_status", ai_health: @ai_health, worker_ai_health_results: @worker_ai_health_results %>
  <% end %>
<% end %>
