<%# locals: (src:) %>
<%# Loads when the tab is first shown, and again when Ai::ProbeJob replaces it.
    The buttons inside navigate the page, so their flash shows. A redirect back
    to this URL is a morphing refresh, and `refresh: :morph` makes it reload the
    frame instead of morphing the status back into the placeholder. %>
<%= turbo_frame_tag "ai_status", src: src, loading: :lazy, target: "_top", refresh: :morph do %>
  <%= render "entries/loading", message: t("admin.system_health.show.ai.loading_results") %>
<% end %>
