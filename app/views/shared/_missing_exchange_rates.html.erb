<%# locals: (family:, classes: nil) %>
<% missing = family.currencies_without_exchange_rate %>
<% if missing.any? %>
  <div class="<%= classes %>" data-testid="missing-exchange-rates">
    <%= render DS::Alert.new(
      variant: :warning,
      message: t("shared.missing_exchange_rates.message",
                 count: missing.size,
                 currencies: missing.sort.to_sentence,
                 currency: family.currency)
    ) %>
  </div>
<% end %>
