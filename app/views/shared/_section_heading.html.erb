<%# locals: (title:, count:, chevron: false, aside: nil) %>
<%# The heading row every stacked surface on the bills overview opens with:
    the notices, both review queues and the bill sections. An uppercase title
    and "· N", padded to line up with the rows in the card below it. `chevron`
    is for a heading that is a disclosure's summary, and `aside` holds
    whatever sits on the right, such as a section's total. Shared because
    Settings › Recurring renders the suggestion strip too. %>
<div class="flex items-center justify-between gap-3 px-4 py-2">
  <div class="flex items-center gap-1.5 text-xs font-medium uppercase text-secondary">
    <% if chevron %>
      <%= icon "chevron-right", size: "sm", class: "motion-safe:transition-transform group-open:rotate-90" %>
    <% end %>
    <h2><%= title %></h2>
    <span class="text-subdued" aria-hidden="true">&middot;</span>
    <p><%= count %></p>
  </div>
  <%= aside %>
</div>
