<%= render "shared/posthog_bootstrap" %>
<script nonce="<%= content_security_policy_nonce %>">
    posthog.init('<%= posthog_api_key %>', {
        api_host: '<%= posthog_host %>',
        defaults: '2025-11-30',
        person_profiles: 'always', // or 'identified_only'
        loaded: function(client) {
            client.register({ sure_version: <%= raw json_escape(Sure.version.to_s.to_json) %> });
            document.dispatchEvent(new Event('posthog:ready'));
        },
    })
</script>
