<%# locals: (form:, item:, editing:) %>
<%= form.text_field :token,
                    label: t("mercury_items.provider_panel.token_label"),
                    placeholder: t(editing ? "mercury_items.provider_panel.keep_token_placeholder" : "mercury_items.provider_panel.token_placeholder"),
                    type: :password,
                    value: nil %>

<% if editing %>
  <%= form.text_field :base_url,
                      label: t("mercury_items.provider_panel.base_url_label"),
                      placeholder: t("mercury_items.provider_panel.base_url_placeholder"),
                      value: item.base_url %>
<% else %>
  <%= form.text_field :base_url,
                      label: t("mercury_items.provider_panel.base_url_label"),
                      placeholder: t("mercury_items.provider_panel.base_url_placeholder") %>
  <p class="text-xs text-secondary px-1 -mt-1"><%= t("mercury_items.provider_panel.sandbox_note_html") %></p>
<% end %>
