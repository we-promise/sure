<% content_for :title, "Set Up Mercury Accounts" %>

<%= render ProviderItem::AccountSetupComponent.new(
      item: @mercury_item,
      provider_accounts: @mercury_accounts,
      api_error: @api_error,
      account_type_options: @account_type_options,
      displayable_account_type_options: @account_type_options.reject { |_, type| type == "skip" },
      subtype_options: @subtype_options,
      defaults: mercury_account_setup_defaults(@mercury_accounts),
      variant: :classic
    ) %>
