<%# locals: (split_group:, view_ctx: "global", is_filtered: false) %>
<div class="split-group">
  <%= render "transactions/split_parent_row", entry: split_group.parent, view_ctx: view_ctx, is_filtered: is_filtered %>
  <% split_group.children.each do |child_entry| %>
    <% if child_entry.entryable.present? %>
      <%= render partial: child_entry.entryable.to_partial_path,
                locals: { entry: child_entry, in_split_group: true, view_ctx: view_ctx, is_filtered: is_filtered } %>
    <% end %>
  <% end %>
</div>
