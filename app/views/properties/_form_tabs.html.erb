<%# locals: (account:, active_tab:) %>

<%# A row of tabs above the form on small screens, a sidebar from md up.
    The form column needs the full dialog width on a phone. %>
<div class="flex flex-wrap md:flex-col gap-0.5 md:w-[156px] shrink-0">
  <%= render "properties/form_tab", label: t(".overview"), href: account.new_record? ? nil : edit_property_path(@account), active: active_tab == "overview" %>
  <%= render "properties/form_tab", label: t(".value"), href: account.new_record? ? nil : balances_property_path(@account), active: active_tab == "value" %>
  <%= render "properties/form_tab", label: t(".address"), href: account.new_record? ? nil : address_property_path(@account), active: active_tab == "address" %>
</div>
