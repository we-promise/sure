<%# locals: (account:, provider_key:) %>

<% provider_name = t("properties.avm_providers.#{provider_key}") %>
<% provider = avm_provider_class(provider_key) %>
<% uk = provider&.supported_country == "GB" %>

<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t("properties.new.avm_title", provider: provider_name)) %>
  <% dialog.with_body do %>
    <%= styled_form_with model: account, url: properties_path do |form| %>
      <div class="flex flex-col gap-2 min-h-80">
        <%= render "properties/form_alert", notice: nil, error: @error_message %>

        <p class="text-sm text-secondary"><%= t("properties.new.avm_description", provider: provider_name) %></p>

        <%= hidden_field_tag :avm_provider, provider_key %>
        <%= form.hidden_field :accountable_type, value: "Property" %>

        <%= form.text_field :name,
                        label: t("properties.overview_fields.name_label"),
                        placeholder: t("properties.overview_fields.name_placeholder"),
                        required: true %>

        <%= form.fields_for :address, (@avm_address || Address.new) do |address_form| %>
          <%= address_form.text_field :line1,
                                      label: t("properties.form.address_line1"),
                                      placeholder: t("properties.form.address_line1_placeholder"),
                                      required: true %>
          <div class="flex items-center gap-2">
            <%= address_form.text_field :locality,
                                      label: uk ? t("properties.new.avm_town_label") : t("properties.form.locality"),
                                      placeholder: uk ? nil : t("properties.form.locality_placeholder"),
                                      required: provider.nil? || provider.required_address_fields.include?(:locality) %>
            <%= address_form.text_field :region,
                                      label: uk ? t("properties.new.avm_county_label") : t("properties.form.region"),
                                      placeholder: uk ? nil : t("properties.form.region_placeholder"),
                                      required: provider.nil? || provider.required_address_fields.include?(:region) %>
          </div>
          <div class="flex items-center gap-2">
            <%= address_form.text_field :postal_code,
                                        label: uk ? t("properties.new.avm_postcode_label") : t("properties.form.postal_code"),
                                        placeholder: uk ? nil : t("properties.form.postal_code_placeholder"),
                                        required: true %>
          </div>
        <% end %>

        <% if provider&.requires_external_id? %>
          <%= form.fields_for :property, Property.new(avm_external_id: @avm_external_id) do |property_form| %>
            <%= property_form.text_field :avm_external_id,
                                         label: t("properties.new.avm_uprn_label"),
                                         placeholder: t("properties.new.avm_uprn_placeholder"),
                                         help_text: t("properties.new.avm_uprn_help", provider: provider_name),
                                         inputmode: "numeric",
                                         autocomplete: "off",
                                         required: true %>
          <% end %>
        <% end %>

        <p class="text-sm text-secondary"><%= uk ? t("properties.new.avm_uk_only", provider: provider_name) : t("properties.new.avm_us_only", provider: provider_name) %></p>
      </div>

      <div class="flex justify-end mt-4">
        <%= render DS::Button.new(
          text: t("properties.new.avm_submit"),
          variant: "primary",
          type: :submit,
        ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
