<%= render DS::Dialog.new(frame: "drawer", responsive: true) do |dialog| %>
  <% dialog.with_header(title: t(".title", ticker: @entry.trade.security.ticker)) %>
  <% dialog.with_body do %>
    <% dialog.with_section(title: t(".details"), open: true) do %>
      <div class="pb-4">
        <%= render "vests/form", form_model: @form %>
      </div>
    <% end %>
    <% dialog.with_section(title: t(".settings")) do %>
      <div class="flex items-center justify-between gap-2 p-3">
        <div class="text-sm space-y-1">
          <h4 class="text-primary"><%= t(".delete_title") %></h4>
          <p class="text-secondary"><%= t(".delete_subtitle") %></p>
        </div>
        <%= render DS::Button.new(
              text: t(".delete"),
              variant: :outline_destructive,
              href: vest_path(@entry),
              method: :delete,
              data: { turbo_frame: :_top },
              confirm: CustomConfirm.for_resource_deletion(t(".delete_resource"))
            ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
