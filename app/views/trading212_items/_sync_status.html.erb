<%# locals: (trading212_item:) %>
<%# Viewer-independent: re-broadcast by Trading212Item::SyncCompleteEvent from SyncJob (no Current.user). %>
<%= tag.div id: dom_id(trading212_item, :sync_status) do %>
  <% if trading212_item.syncing? %>
    <div class="text-secondary flex items-center gap-1">
      <%= icon "loader", size: "sm", class: "animate-spin" %>
      <%= tag.span t("trading212_items.trading212_item.syncing") %>
    </div>
  <% elsif trading212_item.requires_update? %>
    <div class="text-warning flex items-center gap-1">
      <%= icon "alert-triangle", size: "sm", color: "warning" %>
      <%= tag.span t("trading212_items.trading212_item.requires_update") %>
    </div>
  <% elsif trading212_item.sync_error.present? %>
    <div class="text-secondary flex items-center gap-1">
      <%= render DS::Tooltip.new(text: trading212_item.sync_error, icon: "alert-circle", size: "sm", color: "destructive", as: :span) %>
      <%= tag.span t("trading212_items.trading212_item.error"), class: "text-destructive" %>
    </div>
  <% else %>
    <p class="text-secondary">
      <% if trading212_item.last_synced_at %>
        <%= t("trading212_items.trading212_item.synced", time: time_ago_in_words(trading212_item.last_synced_at), summary: trading212_item.sync_status_summary) %>
      <% else %>
        <%= t("trading212_items.trading212_item.never_synced") %>
      <% end %>
    </p>
  <% end %>
<% end %>
