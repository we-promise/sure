<%= content_for :header_nav do %>
  <%= render "imports/nav", import: @import %>
<% end %>

<% previous_path = case @import
  when PdfImport then imports_path
  when MonarchImport then import_configuration_path(@import)
  else import_confirm_path(@import)
end %>
<%= content_for :previous_path, previous_path %>

<% if @import.is_a?(PdfImport) %>
  <%= render "imports/pdf_import", import: @import %>
<% elsif @import.importing? %>
  <%= render "imports/importing", import: @import %>
<% elsif @import.complete? %>
  <%= render "imports/success", import: @import %>
<% elsif @import.failed? %>
  <%= render "imports/failure", import: @import %>
<% elsif @import.revert_failed? %>
  <%= render "imports/revert_failure", import: @import %>
<% else %>
  <%= render "imports/ready", import: @import %>
<% end %>
