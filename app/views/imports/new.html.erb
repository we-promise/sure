<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title"), subtitle: t(".description")) %>

  <% dialog.with_body do %>
    <% has_accounts = accessible_accounts.any? %>
    <% default_import_kind = has_accounts ? "TransactionImport" : "AccountImport" %>
    <% import_type_options = [
      [ t(".import_transactions"), "TransactionImport", { disabled: !has_accounts } ],
      [ t(".import_portfolio"), "TradeImport", { disabled: !has_accounts } ],
      [ t(".import_accounts"), "AccountImport" ],
      [ t(".import_categories"), "CategoryImport" ],
      [ t(".import_merchants"), "MerchantImport" ],
      [ t(".import_rules"), "RuleImport" ]
    ] %>
    <% file_format_options = [ [ t(".format_csv"), "csv" ] ] %>
    <% file_format_options << [ t(".format_document"), "document" ] if @document_upload_extensions.any? %>
    <% file_format_options.concat([
      [ t(".format_qif"), "qif" ],
      [ t(".format_sure"), "sure" ]
    ]) %>

    <% if @pending_import.present? %>
      <div class="rounded-xl bg-container-inset p-1 mb-4">
        <ul class="bg-container shadow-border-xs rounded-lg">
          <li>
            <%= link_to import_path(@pending_import), class: "flex items-center justify-between p-4 group cursor-pointer", data: { turbo: false } do %>
              <div class="flex items-center gap-2">
                <div class="bg-orange-500/5 rounded-md w-8 h-8 flex items-center justify-center">
                  <span class="text-orange-500"><%= icon("loader", color: "current") %></span>
                </div>
                <span class="text-sm text-primary group-hover:text-secondary">
                  <%= t(".resume", type: @pending_import.type.titleize) %>
                </span>
              </div>
              <%= icon("chevron-right") %>
            <% end %>
          </li>
        </ul>
      </div>
    <% end %>

    <%= styled_form_with url: imports_path,
          scope: :import,
          multipart: true,
          class: "space-y-4",
          data: {
            controller: "import-flow",
            action: "change->import-flow#update"
          } do |form| %>
      <%= form.select :file_format,
            options_for_select(file_format_options, "csv"),
            { label: t(".format_label") },
            { data: { import_flow_target: "format" } } %>
      <section data-import-flow-target="panel" data-import-flow-panel="csv" class="space-y-4">
        <%= form.select :import_kind,
              options_for_select(import_type_options, default_import_kind),
              { label: t(".csv_import_kind_label") },
              { data: { import_flow_target: "kind" } } %>

        <% unless has_accounts %>
          <%= render DS::Alert.new(message: t(".requires_account"), variant: :info) %>
        <% end %>

        <div data-import-flow-target="transactionFormat" class="space-y-2">
          <%= form.select :csv_format,
                options_for_select(Import::CsvFormat.options.map { |key, label| [ t(".csv_formats.#{key}"), key ] }, "auto"),
                { label: t(".csv_format_label") } %>
          <p class="text-xs text-secondary"><%= t(".csv_format_description") %></p>
        </div>

        <%= form.submit t(".continue_to_upload") %>
      </section>

      <section data-import-flow-target="panel" data-import-flow-panel="document" class="space-y-4" hidden>
        <p class="text-sm text-secondary"><%= t(".document_description") %></p>
        <%= form.label :import_file, t(".choose_document"), for: "document_import_file", class: "text-sm font-medium text-primary" %>
        <%= form.file_field :import_file,
              id: "document_import_file",
              accept: @document_upload_extensions.join(","),
              disabled: true,
              data: { import_flow_target: "fileInput", import_flow_file_format: "document" } %>
        <%= form.submit t(".upload_document") %>
      </section>

      <section data-import-flow-target="panel" data-import-flow-panel="qif" class="space-y-4" hidden>
        <p class="text-sm text-secondary"><%= t(".qif_description") %></p>
        <%= form.submit t(".continue_to_upload") %>
      </section>

      <section data-import-flow-target="panel" data-import-flow-panel="sure" class="space-y-4" hidden>
        <p class="text-sm text-secondary"><%= t(".sure_description") %></p>
        <%= form.label :import_file, t(".choose_sure_export"), for: "sure_import_file", class: "text-sm font-medium text-primary" %>
        <%= form.file_field :import_file,
              id: "sure_import_file",
              accept: ".ndjson,.json",
              disabled: true,
              data: { import_flow_target: "fileInput", import_flow_file_format: "sure" } %>
        <%= form.submit t(".upload_sure_export") %>
      </section>
    <% end %>
  <% end %>
<% end %>
