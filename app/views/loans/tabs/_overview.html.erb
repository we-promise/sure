<%# locals: (account:) %>

<%# FR-404. Read from the schedule, not from loan.amortizations: the persisted
    rows may legitimately be absent or stale on a read, because the Schedule tab
    no longer rebuilds them inside the request (#39). Sourcing a display figure
    from persisted rows is the same defect that silently removed the payoff
    projection card -- see Loan::PayoffProjection#original_schedule_rows. %>
<% payoff_date = account.loan.amortization_schedule.payoff_date %>

<div class="grid grid-cols-2 gap-2 md:grid-cols-4">
  <%= summary_card title: t(".original_principal") do %>
    <%= format_money account.loan.original_balance %>
  <% end %>

  <%= summary_card title: t(".remaining_principal") do %>
    <%= format_money account.balance_money %>
  <% end %>

  <%= summary_card title: t(".interest_rate") do %>
    <% if account.loan.interest_rate.present? %>
      <%= number_to_percentage(account.loan.interest_rate, precision: 3) %>
    <% else %>
      <%= t(".unknown") %>
    <% end %>
  <% end %>

  <%# FR-204: a variable loan printed "N/A" here, because the contracted
      monthly_payment is sized from the ORIGINAL balance at the FIRST payment
      date and describes a loan that no longer exists. current_minimum_payment
      re-amortises today's balance at today's rate over the payments left to
      the original maturity -- the figure a lender quotes. The Schedule tab
      shows the same value from the same method, so the two cannot disagree. %>
  <%= summary_card title: t(".monthly_payment") do %>
    <% current_payment = account.loan.current_minimum_payment %>
    <% if current_payment.present? %>
      <%= format_money(current_payment) %>
      <% if account.loan.rate_type != 'fixed' %>
        <p class="text-xs text-subdued mt-1">
          <%= t(".minimum_payment_rate", rate: number_to_percentage(account.loan.current_variable_rate, precision: 3, strip_insignificant_zeros: true)) %>
        </p>
      <% end %>
    <% else %>
      <%= t(".unknown") %>
    <% end %>
  <% end %>

  <%= summary_card title: t(".term") do %>
    <% if account.loan.term_months.present? %>
      <% if account.loan.term_months < 12 %>
        <%= pluralize(account.loan.term_months, "month") %>
      <% else %>
        <%= pluralize(account.loan.term_months / 12, "year") %>
      <% end %>
    <% else %>
      <%= t(".unknown") %>
    <% end %>
  <% end %>

  <%= summary_card title: t(".original_payoff_date") do %>
    <% if payoff_date.present? %>
      <%= l payoff_date, format: :long %>
    <% else %>
      <%= t(".unknown") %>
    <% end %>
  <% end %>

  <%= summary_card title: t(".type") do %>
    <% type = account.loan.rate_type&.titleize || t(".unknown") %>
    <% type = t(".variable_with_offset") if account.loan.rate_type == "variable" && account.loan.offset_accounts.any? %>
    <%= type %>
  <% end %>
</div>

<div class="flex justify-center py-8">
  <%= render DS::Link.new(
    text: t(".edit_loan_details"),
    variant: "ghost",
    href: edit_loan_path(account),
    frame: :modal
  ) %>
</div>
