<%# locals: (account:) %>

<% loan = account.loan %>
<% schedule = loan.amortization_schedule %>
<% payments = schedule.display_rows %>
<% today = Date.current %>
<%# FR-205: the payments whose ACCRUAL period opens a new rate (C7). Derived on
    the model, because "which row does the borrower start being charged the new
    rate on" is a question about the two rate clocks, not about this table. %>
<% rate_change_markers = schedule.accrual_rate_change_markers(payments) %>
<% extra_payment_params = @extra_payment_params || {} %>
<% extra_payment_active = extra_payment_params.present? %>
<%# Hypothetical "what if I paid extra" params (see
    AccountsController#extra_payment_params) swap the accelerated line/cards
    for one modeling that extra payment on top of the real current balance --
    purely a simulation, never persisted. No what-if active falls back to the
    plain actual-balance projection, unchanged from before this feature. %>
<% projection = extra_payment_active ?
     loan.payoff_projection_with_extra(amount: extra_payment_params["amount"], frequency: extra_payment_params["frequency"]) :
     loan.payoff_projection %>
<%# A one-payment cleanup difference is the expected artifact of two
    independently-terminated simulations, not a meaningful "ahead/behind
    schedule" signal -- only show the projection once it diverges by more
    than that. The rule lives on the projection so these cards and
    Loan#payoff_chart_payload's chart appear and disappear together. %>
<% show_comparison = projection.diverges_from_schedule? %>
<% show_projection = show_comparison %>

<div class="space-y-4">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
    <%# The same method the Overview card uses: the acceptance criterion for
        #15 is that the two tabs never show different figures for one loan. %>
    <%= summary_card title: t(".monthly_payment") do %>
      <% current_payment = loan.current_minimum_payment %>
      <%= current_payment ? format_money(current_payment) : format_money(schedule.monthly_payment) %>
      <% if loan.rate_type != "fixed" && current_payment %>
        <p class="text-xs text-subdued mt-1">
          <%= t(".minimum_payment_rate", rate: number_to_percentage(loan.current_variable_rate, precision: 3, strip_insignificant_zeros: true)) %>
        </p>
      <% end %>
    <% end %>

    <%= summary_card title: t(".total_interest") do %>
      <%= format_money schedule.total_interest %>
    <% end %>

    <%= summary_card title: t(".total_cost") do %>
      <%= format_money schedule.total_cost %>
    <% end %>

    <%= summary_card title: t(".payoff_date") do %>
      <%= l schedule.payoff_date, format: :long %>
    <% end %>
  </div>

  <% if Loan::PayoffProjection.eligible_for_extra_payment?(loan) %>
    <%= form_with url: account_path(account, tab: "schedule"), scope: :extra_payment, method: :get,
                  data: { controller: "auto-submit-form" } do |f| %>
      <div class="flex flex-wrap items-end gap-2">
        <div class="form-field">
          <%= f.label :amount, t(".extra_payment.amount_label"), class: "text-xs text-secondary" %>
          <%= f.number_field :amount, value: extra_payment_params["amount"], min: 0, step: "0.01",
                placeholder: t(".extra_payment.amount_placeholder"),
                "data-auto-submit-form-target": "auto" %>
        </div>
        <div class="form-field">
          <%= f.label :frequency, t(".extra_payment.frequency_label"), class: "text-xs text-secondary" %>
          <%= f.select :frequency,
                [ [ t(".extra_payment.weekly"), "weekly" ], [ t(".extra_payment.monthly"), "monthly" ], [ t(".extra_payment.yearly"), "yearly" ] ],
                { selected: extra_payment_params["frequency"] || "monthly" },
                "data-auto-submit-form-target": "auto" %>
        </div>
        <%# Auto-submit (JS) fires on change; this button is the real,
            always-working submit control -- required for JS-disabled
            clients and as a visible affordance rather than relying
            entirely on auto-submit behavior. %>
        <%= render DS::Button.new(text: t(".extra_payment.apply"), type: "submit", variant: "outline", size: "sm") %>
        <% if extra_payment_active %>
          <%= link_to t(".extra_payment.clear"), account_path(account, tab: "schedule"),
                class: "text-sm text-secondary underline" %>
        <% end %>
      </div>
      <p class="text-xs text-subdued mt-1"><%= t(".extra_payment.approximation_notice") %></p>
      <%# What the projection actually does for a variable-rate loan:
          PayoffProjection#generate_schedule passes RateResolver's accrual_rate_for
          and re_amortisation_events to the simulator, so rate changes ALREADY
          RECORDED on the loan are applied. payment_strategy is :hold, so the
          repayment itself stays put. What it cannot know is a change nobody has
          recorded yet -- which is what this notice discloses (#54). %>
      <% if loan.rate_type == "variable" %>
        <p class="text-xs text-subdued mt-1"><%= t(".extra_payment.variable_rate_notice") %></p>
      <% end %>
    <% end %>
  <% end %>

  <% if show_projection %>
    <% chart_payload = loan.payoff_chart_payload(
         projection: projection,
         extra_payment_amount: extra_payment_params["amount"],
         extra_payment_frequency: extra_payment_params["frequency"]
       ) %>

    <% if chart_payload && chart_payload[:extra_payment_label].present? %>
      <p class="text-xs text-secondary"><%= chart_payload[:extra_payment_label] %></p>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
      <%= summary_card title: t(".projected_payoff_date") do %>
        <%= l projection.payoff_date, format: :long %>
        <% if show_comparison && projection.months_saved.nonzero? %>
          <p class="text-xs text-secondary mt-1">
            <% if projection.months_saved.positive? %>
              <%= t(".months_saved", count: projection.months_saved) %>
            <% else %>
              <%= t(".months_behind", count: projection.months_saved.abs) %>
            <% end %>
          </p>
        <% end %>
      <% end %>

      <% if show_comparison %>
        <%= summary_card title: projection.interest_saved.positive? ? t(".interest_saved") : t(".interest_added") do %>
          <%= format_money Money.new(projection.interest_saved.abs, account.currency) %>
        <% end %>
      <% end %>
    </div>

    <% if chart_payload %>
      <div data-controller="loan-payoff-chart"
           data-loan-payoff-chart-data-value="<%= chart_payload.to_json %>"
           class="h-64">
      </div>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-secondary">
        <li class="flex items-center gap-1.5">
          <span class="inline-block w-3 h-0.5 bg-primary" aria-hidden="true"></span>
          <%= chart_payload[:labels][:scheduled] %>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="inline-block w-3 h-0.5 bg-secondary" style="border-top: 1px dashed currentColor; background: none;" aria-hidden="true"></span>
          <%= chart_payload[:labels][:original] %>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="inline-block w-3 h-0.5" style="border-top: 2px dashed <%= chart_payload[:ahead] ? "var(--color-green-600)" : "var(--color-yellow-600)" %>;" aria-hidden="true"></span>
          <%= chart_payload[:labels][:accelerated] %>
        </li>
      </ul>
      <%# Text summary of the chart's key figures -- real DOM text (not just
          an SVG aria-label), so it's available to screen readers the same
          way the sighted summary cards above already are, and doesn't rely
          on any keyboard/focus interaction with the SVG itself. %>
      <p class="sr-only"><%= chart_payload[:aria_description] %></p>
    <% end %>
  <% elsif loan.amortization_schedule.amortizable? && projection.current_balance.amount.positive? &&
      projection.monthly_payment.present? && !projection.converged? %>
    <p class="text-sm text-secondary"><%= t(".projection_not_converged") %></p>
  <% end %>

  <% if schedule.stale? %>
    <p class="text-sm text-secondary" role="status">
      <%= t(".recalculating") %>
    </p>
  <% end %>

  <% if loan.rate_type == "variable" %>
    <p class="text-sm text-secondary">
      <%= t(".variable_rate_notice") %>
    </p>
  <% end %>

  <%# FR-405. Renders nothing when there are no FUTURE changes -- a change
      already in effect is the current rate, not news. %>
  <%= render UI::Loan::RateChangeTable.new(loan: loan) %>

  <% if loan.offset_accounts.any? %>
    <p class="text-sm text-secondary">
      <%= t(".offset_notice") %>
    </p>
  <% end %>

  <%# #11 requires the basis to be stated rather than the constant quietly tuned
      to fit one lender: reconciliation showed a fixed 365 is an approximation
      for at least one real lender (#65). %>
  <p class="text-sm text-secondary">
    <%= t(".day_count_notice", basis: t("loans.form.day_count_convention_#{loan.day_count_convention}")) %>
  </p>

  <div class="rounded-lg bg-container shadow-xs border border-alpha-black-25 overflow-hidden">
    <div class="max-h-128 overflow-y-auto overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="sticky top-0 bg-container border-b border-alpha-black-25">
          <tr class="text-secondary text-left">
            <th scope="col" class="font-medium px-4 py-3"><%= t(".number") %></th>
            <th scope="col" class="font-medium px-4 py-3"><%= t(".date") %></th>
            <th scope="col" class="font-medium px-4 py-3 text-right"><%= t(".payment") %></th>
            <th scope="col" class="font-medium px-4 py-3 text-right"><%= t(".principal") %></th>
            <th scope="col" class="font-medium px-4 py-3 text-right"><%= t(".interest") %></th>
            <th scope="col" class="font-medium px-4 py-3 text-right"><%= t(".remaining_balance") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-alpha-black-25">
          <% payments.each do |payment| %>
            <% accrual_rate = rate_change_markers[payment.payment_number] %>
            <tr class="<%= "text-secondary bg-surface-hover" if payment.payment_date <= today %>">
              <td class="px-4 py-2">
                <%= payment.payment_number %>
                <% if accrual_rate %>
                  <%# The rate is repeated as visually hidden text rather than
                      left only in `title`: a non-focusable span's title is
                      unreachable by keyboard and unreliably announced, and the
                      rate is the whole point of the marker (G6). %>
                  <span class="ml-1 text-xs text-secondary" data-rate-change-marker
                        title="<%= t(".rate_change_marker_title", rate: accrual_rate) %>">
                    <%= t(".rate_change_marker") %>
                    <span class="sr-only">: <%= t(".rate_change_marker_title", rate: accrual_rate) %></span>
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-2"><%= l payment.payment_date, format: :long %></td>
              <td class="px-4 py-2 text-right"><%= format_money Money.new(payment.payment_amount, account.currency) %></td>
              <td class="px-4 py-2 text-right"><%= format_money Money.new(payment.principal_payment, account.currency) %></td>
              <td class="px-4 py-2 text-right"><%= format_money Money.new(payment.interest_payment, account.currency) %></td>
              <td class="px-4 py-2 text-right"><%= format_money Money.new(payment.ending_balance, account.currency) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
