<%# locals: (account:, url:) %>

<%= render "accounts/form", account: account, url: url do |form| %>
  <%= render "shared/ruler", classes: "my-4" %>

  <%# The rate types that reveal the offset and rate-change editors come from
      Loan::VARIABLE_RATE_TYPES rather than being repeated in JavaScript, so
      adding or removing one is a single change (#14). %>
  <div class="space-y-2" data-controller="loan-offset"
       data-loan-offset-variable-rate-types-value="<%= Loan::VARIABLE_RATE_TYPES.to_json %>">
    <%= form.fields_for :accountable do |loan_form| %>
      <div class="flex items-center gap-2">
        <%= loan_form.money_field :initial_balance,
                                 label: t("loans.form.initial_balance"),
                                 default_currency: Current.family.currency,
                                 required: true %>
      </div>

      <div class="flex items-center gap-2">
        <%= loan_form.number_field :interest_rate,
                                 label: t("loans.form.interest_rate"),
                                 placeholder: t("loans.form.interest_rate_placeholder"),
                                 min: 0,
                                 step: 0.005 %>
        <%= loan_form.select :rate_type,
                           [[t("loans.form.rate_type_fixed"), "fixed"], [t("loans.form.rate_type_variable"), "variable"], [t("loans.form.rate_type_adjustable"), "adjustable"]],
                           { label: t("loans.form.rate_type") },
                           { data: { loan_offset_target: "rateType", action: "change->loan-offset#update" } } %>
      </div>

      <div class="flex items-center gap-2">
        <%= loan_form.number_field :term_months,
                                 label: t("loans.form.term_months"),
                                 placeholder: t("loans.form.term_months_placeholder") %>
      </div>

      <div class="space-y-2">
        <%= loan_form.date_field :start_date, label: t("loans.form.start_date") %>
        <p class="text-sm text-secondary"><%= t("loans.form.start_date_hint") %></p>
      </div>

      <div class="space-y-2">
        <%= loan_form.select :day_count_convention,
                  Loan::DAY_COUNT_CONVENTIONS.map { |convention| [ t("loans.form.day_count_convention_#{convention}"), convention ] },
                  { label: t("loans.form.day_count_convention") } %>
        <p class="text-sm text-secondary"><%= t("loans.form.day_count_convention_hint") %></p>
      </div>

      <div>
        <%= loan_form.select :subtype,
                  Loan.subtype_options_for_select,
                  { label: true, prompt: t("loans.form.subtype_prompt"), include_blank: t("loans.form.none") } %>
      </div>

      <%# Repeatable {effective date, rate} rows. The names are written out
          rather than built with fields_for because rate_changes is an
          attr_accessor carrying plain rows, not an association -- the jsonb
          column it feeds is deliberately not mass-assignable (#14, R13). %>
      <div class="space-y-2 hidden" data-loan-offset-target="rateChanges"
           data-controller="loan-rate-changes">
        <h3 class="text-sm font-medium text-primary"><%= t("loans.form.rate_changes") %></h3>
        <p class="text-sm text-secondary"><%= t("loans.form.rate_changes_hint") %></p>

        <% if loan_form.object.errors[:variable_rate_schedule].any? %>
          <p class="text-sm text-destructive" role="alert">
            <%= loan_form.object.errors[:variable_rate_schedule].to_sentence %>
          </p>
        <% end %>

        <div class="space-y-2" data-loan-rate-changes-target="rows">
          <% loan_form.object.rate_change_rows.each_with_index do |(effective_date, rate), index| %>
            <%# A date input sanitises a value it cannot parse to the empty
                string (WHATWG value sanitization algorithm). So when a bad date
                is what failed validation, rendering it back into type="date"
                shows the user an empty box beside an error about a value they
                can no longer see. Only the invalid case falls back to a text
                input; valid dates keep the native picker. The same holds for
                a non-numeric rate in type="number". %>
            <% date_valid = Loan.renderable_effective_date?(effective_date) %>
            <% rate_valid = Loan.renderable_rate?(rate) %>
            <div class="flex items-end gap-2" data-loan-rate-changes-target="row">
              <label class="sr-only" for="loan_rate_change_date_<%= index %>"><%= t("loans.form.rate_change_effective_date") %></label>
              <input type="<%= date_valid ? "date" : "text" %>" id="loan_rate_change_date_<%= index %>"
                     name="<%= loan_form.object_name %>[rate_changes][][effective_date]"
                     value="<%= effective_date %>" class="form-field__input"
                     aria-invalid="<%= !date_valid %>">
              <label class="sr-only" for="loan_rate_change_rate_<%= index %>"><%= t("loans.form.rate_change_rate") %></label>
              <input type="<%= rate_valid ? "number" : "text" %>" step="0.005" min="0" max="100" id="loan_rate_change_rate_<%= index %>"
                     name="<%= loan_form.object_name %>[rate_changes][][rate]"
                     value="<%= rate %>" class="form-field__input"
                     aria-invalid="<%= !rate_valid %>">
              <input type="hidden" name="<%= loan_form.object_name %>[rate_changes][][_destroy]" value="0">
              <button type="button" class="text-sm text-secondary underline"
                      data-action="loan-rate-changes#remove">
                <%= t("loans.form.rate_change_remove") %>
              </button>
            </div>
          <% end %>
        </div>

        <template data-loan-rate-changes-target="template">
          <div class="flex items-end gap-2" data-loan-rate-changes-target="row">
            <label class="sr-only" for="loan_rate_change_date_NEW_RECORD"><%= t("loans.form.rate_change_effective_date") %></label>
            <input type="date" id="loan_rate_change_date_NEW_RECORD"
                   name="<%= loan_form.object_name %>[rate_changes][][effective_date]"
                   class="form-field__input">
            <label class="sr-only" for="loan_rate_change_rate_NEW_RECORD"><%= t("loans.form.rate_change_rate") %></label>
            <input type="number" step="0.005" min="0" max="100" id="loan_rate_change_rate_NEW_RECORD"
                   name="<%= loan_form.object_name %>[rate_changes][][rate]"
                   class="form-field__input">
            <input type="hidden" name="<%= loan_form.object_name %>[rate_changes][][_destroy]" value="0">
            <button type="button" class="text-sm text-secondary underline"
                    data-action="loan-rate-changes#remove">
              <%= t("loans.form.rate_change_remove") %>
            </button>
          </div>
        </template>

        <%= render DS::Button.new(text: t("loans.form.rate_change_add"), variant: "outline", size: "sm",
                                  type: "button",
                                  data: { action: "loan-rate-changes#add" }) %>
      </div>

      <div class="space-y-2 hidden" data-loan-offset-target="offsetAccounts">
        <%= loan_form.select :offset_account_ids,
                  @offset_accounts.map { |account| [ account.name, account.id ] },
                  { label: t("loans.form.offset_accounts"), include_hidden: false },
                  { multiple: true, size: [ @offset_accounts.size, 4 ].min.clamp(1, 4) } %>
        <p class="text-sm text-secondary"><%= t("loans.form.offset_accounts_hint") %></p>
      </div>
    <% end %>
  </div>
<% end %>
