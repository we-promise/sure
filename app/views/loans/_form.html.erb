<%# locals: (account:, url:) %>

<%= render "accounts/form", account: account, url: url do |form| %>
  <%= render "shared/ruler", classes: "my-4" %>

  <div class="space-y-2">
    <%= form.fields_for :accountable do |loan_form| %>
      <div class="flex items-center gap-2">
        <%= loan_form.money_field :initial_balance,
                                 label: t("loans.form.initial_balance"),
                                 default_currency: Current.family.currency,
                                 required: true %>
      </div>

      <div class="flex items-center gap-2">
        <%= loan_form.number_field :interest_rate,
                                 label: t("loans.form.interest_rate"),
                                 placeholder: t("loans.form.interest_rate_placeholder"),
                                 min: 0,
                                 step: 0.005 %>
        <%= loan_form.select :rate_type,
                           [["Fixed", "fixed"], ["Variable", "variable"], ["Adjustable", "adjustable"]],
                           { label: t("loans.form.rate_type") } %>
      </div>

      <div class="flex items-center gap-2">
        <%= loan_form.number_field :term_months,
                                 label: t("loans.form.term_months"),
                                 placeholder: t("loans.form.term_months_placeholder") %>
      </div>

      <div>
        <%= loan_form.select :subtype,
                  Loan.subtype_options_for_select,
                  { label: true, prompt: t("loans.form.subtype_prompt"), include_blank: t("loans.form.none") } %>
      </div>

      <%# Accrual replays the ledger from origination, which only holds for manual
          loans — a linked account is anchored to the balance its provider reports. %>
      <% if account.unlinked? %>
        <%= render "shared/ruler", classes: "my-4" %>

        <div class="flex items-center justify-between gap-3 py-2">
          <div class="space-y-1">
            <p class="text-sm text-primary"><%= t("loans.form.accrue_interest_label") %></p>
            <p class="text-secondary text-sm"><%= t("loans.form.accrue_interest_hint") %></p>
          </div>
          <%= loan_form.toggle :accrue_interest %>
        </div>

        <div>
          <%= loan_form.date_field :interest_accrual_start_date,
                                   label: t("loans.form.interest_accrual_start_date") %>
        </div>

        <div>
          <%= loan_form.number_field :interest_accrual_day,
                                   label: t("loans.form.interest_accrual_day"),
                                   placeholder: t("loans.form.interest_accrual_day_placeholder"),
                                   min: 1,
                                   max: 31 %>
        </div>

        <div class="space-y-2" data-controller="loan--rate-changes">
          <div class="space-y-1">
            <p class="text-sm text-primary"><%= t("loans.form.rate_changes_label") %></p>
            <p class="text-secondary text-sm"><%= t("loans.form.rate_changes_hint") %></p>
          </div>

          <div class="space-y-2" data-loan--rate-changes-target="list">
            <%= loan_form.fields_for :rate_changes do |rate_change_form| %>
              <%= render "loans/rate_change_fields", f: rate_change_form %>
            <% end %>
          </div>

          <%# Template cloned by the Stimulus controller for each new row. The
              child_index placeholder is swapped for a unique key so Rails builds
              a distinct nested record per added row. %>
          <template data-loan--rate-changes-target="template">
            <%= loan_form.fields_for :rate_changes, Loan::RateChange.new, child_index: "IDX_PLACEHOLDER" do |rate_change_form| %>
              <%= render "loans/rate_change_fields", f: rate_change_form %>
            <% end %>
          </template>

          <%= render DS::Button.new(
                text: t("loans.form.add_rate_change"),
                icon: "plus",
                variant: "ghost",
                type: "button",
                data: { action: "loan--rate-changes#add" }
              ) %>
        </div>

        <%= render DS::Alert.new(
              variant: :warning,
              message: t("loans.form.accrue_interest_backfill_warning")
            ) %>
      <% end %>
    <% end %>
  </div>
<% end %>
