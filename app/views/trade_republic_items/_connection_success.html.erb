<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: t("settings.providers.trade_republic_panel.connection_success.title")) %>

    <% dialog.with_body do %>
      <div class="space-y-5">
        <div class="rounded-lg border border-success/20 bg-success/5 p-4">
          <div class="flex items-start gap-3">
            <%= icon "check-circle", size: "lg", color: "success", class: "mt-0.5 shrink-0" %>
            <div class="space-y-1">
              <p class="font-medium text-primary">
                <%= t("settings.providers.trade_republic_panel.connection_success.message") %>
              </p>
              <p class="text-sm text-secondary">
                <%= t("settings.providers.trade_republic_panel.connection_success.description") %>
              </p>
            </div>
          </div>
        </div>

        <div class="flex justify-end">
          <%= render DS::Button.new(
                text: t("settings.providers.trade_republic_panel.connection_success.close"),
                variant: :primary,
                type: "button",
                data: { action: "DS--dialog#close" }
              ) %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
