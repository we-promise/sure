<%# locals: (item:) %>

<% sync_status = BankSyncStatusPresenter.new(item: item, provider_key: :ca_auto_bank) %>

<div class="space-y-2 text-sm">
  <%= render BankSyncStatusComponent.new(presenter: sync_status) %>
  <% if item.session_configured? %>
    <p class="text-xs text-secondary">
      <%= t("ca_auto_bank.session_expires", time: "#{l(item.session_expires_at, format: :short)} (#{Time.zone.name})") %>
    </p>
  <% end %>
</div>
