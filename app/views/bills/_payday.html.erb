<%# locals: (occurrence:) %>
<%# A payday in the month's date order, drawn like a bill row so it reads as
    what arrives between the bills, not as a separate list. Its state is the
    model's call (RecurringOccurrence#payday_state), so a passed payday is shown
    as matched, received, or not matched yet rather than dropped. %>
<% series = occurrence.recurring_transaction %>
<% state = occurrence.payday_state %>

<div class="flex items-center gap-3 @lg:gap-4 p-3 @lg:p-4">
  <div class="hidden @lg:block w-14 shrink-0 text-xs text-secondary">
    <%= bills_rail_date(occurrence) %>
  </div>

  <div class="size-8 shrink-0 rounded-full bg-success/10 flex items-center justify-center">
    <%= icon "arrow-down-circle", size: "sm", color: "success" %>
  </div>

  <div class="min-w-0 flex-1">
    <p class="text-sm font-medium text-primary truncate">
      <%= t("bills.payday.title", source: series.display_name) %>
    </p>
    <p class="text-xs text-secondary truncate">
      <span class="@lg:hidden"><%= bills_row_date(occurrence) %> &middot;</span>
      <%= t("bills.payday.#{state}") %>
    </p>
  </div>

  <div class="shrink-0 text-right">
    <p class="text-sm font-medium text-success privacy-sensitive whitespace-nowrap">
      +<%= format_money(occurrence.resolved_expected_amount_money.abs) %>
    </p>
  </div>

  <%# The verb slot every bill row reserves from @lg, so the amounts share one
      right edge. A payday has no verb, but it keeps the slot empty. %>
  <div class="hidden @lg:flex shrink-0 min-w-36"></div>
</div>
