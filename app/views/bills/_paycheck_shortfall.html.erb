<%# The gap between today and the next payday, when what is owed in it exceeds
    what is on hand. Reports the shortfall, how it splits between due and
    reserved, and the largest obligation behind it. %>

<% largest = period.largest_obligation %>

<div class="rounded-lg bg-destructive/5 px-4 py-3 space-y-1" role="status">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="text-sm text-primary tabular-nums privacy-sensitive">
      <span class="font-medium text-destructive"><%= t("bills.paycheck.shortfall_label") %></span>
      <%= t("bills.paycheck.shortfall_amount", amount: format_money(Money.new(period.shortfall, currency))) %>
    </p>
    <%= link_to t("bills.paycheck.review_plan"), bills_path,
          class: "text-xs text-secondary hover:text-primary shrink-0" %>
  </div>

  <p class="text-xs text-secondary">
    <%= t("bills.paycheck.shortfall_split", date: l(period.ends_on + 1, format: :short)) %>
  </p>

  <% if largest.present? %>
    <p class="text-xs text-secondary">
      <%= t("bills.paycheck.shortfall_largest") %>
      <%= link_to bill_path(largest.occurrence.recurring_transaction), class: "text-primary hover:underline" do %>
        <%= largest.occurrence.recurring_transaction.display_name %>
        &middot; <span class="tabular-nums privacy-sensitive"><%= format_money(Money.new(largest.remaining_total, currency)) %></span>
      <% end %>
    </p>
  <% end %>
</div>
