<%# locals: (bill:, duplicate: false) %>

<%# An autopaying bill is still worth seeing and still counts toward the total, but it
    recedes so the rows that want something from you carry the visual weight. %>
<div class="flex items-center gap-3 lg:gap-4 p-3 lg:p-4 <%= "opacity-70" if bill.autopay? %>">
  <div class="flex items-center gap-3 lg:gap-4 min-w-0 flex-1">
    <% if bill.merchant&.logo_url.present? %>
      <%= image_tag Setting.transform_brand_fetch_url(bill.merchant.logo_url),
            class: "w-9 h-9 rounded-full shrink-0",
            loading: "lazy" %>
    <% else %>
      <%= render DS::FilledIcon.new(
            variant: :text,
            text: bill.display_name,
            size: "lg",
            rounded: true
          ) %>
    <% end %>

    <div class="min-w-0">
      <p class="text-primary text-sm font-medium truncate"><%= bill.display_name %></p>
      <p class="text-xs <%= bill.overdue? ? "text-destructive" : "text-secondary" %>">
        <%= bills_due_label(bill) %><%= bills_paid_from_label(bill) %>
      </p>
      <% if bill.notes.present? %>
        <p class="text-xs text-subdued truncate"><%= bill.notes %></p>
      <% end %>
    </div>
  </div>

  <div class="shrink-0 text-right">
    <p class="text-sm font-medium text-primary privacy-sensitive">
      <%# Variance is only ever computed for manually created bills, so most rows show a
          flat amount. Where it exists the average is the honest headline and the range
          belongs underneath it. %>
      <% if bill.has_amount_variance? %>
        ~<%= format_money(bill.expected_amount_avg_money || bill.amount_money) %>
      <% else %>
        <%= format_money(bill.amount_money) %>
      <% end %>
    </p>
    <% if bill.has_amount_variance? %>
      <p class="text-xs text-secondary privacy-sensitive">
        <%= t("bills.amount_range",
              min: format_money(bill.expected_amount_min_money),
              max: format_money(bill.expected_amount_max_money)) %>
      </p>
    <% end %>
  </div>

  <% if defined?(duplicate) && duplicate %>
    <span class="shrink-0 inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-warning/10 text-warning">
      <%= icon "copy", size: "sm", color: "current" %>
      <%= t("bills.possible_duplicate") %>
    </span>
  <% end %>

  <div class="shrink-0">
    <%= render "recurring_transactions/pay_action", recurring_transaction: bill %>
  </div>
</div>
