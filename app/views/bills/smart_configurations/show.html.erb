<%= turbo_frame_tag @suggestion, target: "_top" do %>
  <% if @suggestion.pending? %>
    <%= render "shared/ai_suggestion_waiting", suggestion: @suggestion,
          waiting_key: "bills.smart_configurations.create.waiting",
          worker_key: "bills.smart_configurations.create.worker_unhealthy",
          stop_key: "bills.smart_configurations.show.stop" %>
  <% else %>
    <%= render "bills/smart_configurations/result", suggestion: @suggestion, series: @series, detection: @detection %>
  <% end %>
<% end %>
