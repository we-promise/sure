<%= content_for :page_title, t(".title") %>

<div class="space-y-4 pb-6 lg:pb-12">
  <%= render "bills/view_switcher", active: "overview" %>

  <div class="2xl:grid 2xl:grid-cols-[minmax(0,1fr)_360px] 2xl:gap-4 2xl:items-start space-y-4 2xl:space-y-0">
  <div class="space-y-4 min-w-0">
  <%# The month at a glance: what is left, how far along, what is done. %>
  <% paid_amount = @paid_this_month_total ? @paid_this_month_total.amount.to_f : 0.0 %>
  <% remaining_amount = @remaining_this_month ? @remaining_this_month.amount.to_f : 0.0 %>
  <% month_total = paid_amount + remaining_amount %>
  <% hero_percent = month_total.positive? ? (paid_amount / month_total * 100).round : 0 %>
  <div class="bg-container rounded-xl shadow-border-xs p-5">
    <div class="flex items-center justify-center gap-10 lg:gap-14">
      <div class="text-right space-y-0.5">
        <p class="text-2xl font-medium text-primary privacy-sensitive"><%= @remaining_this_month ? format_money(@remaining_this_month) : "–" %></p>
        <p class="text-sm text-secondary"><%= t(".left_to_pay") %></p>
        <% if @past_due_total %>
          <p class="text-xs text-destructive privacy-sensitive"><%= t(".hero_past_due", amount: format_money(@past_due_total)) %></p>
        <% end %>
      </div>
      <%= render DS::ProgressRing.new(percent: hero_percent, size: 72, stroke_width: 7) %>
      <div class="space-y-0.5">
        <p class="text-2xl font-medium text-primary privacy-sensitive"><%= @paid_this_month_total ? format_money(@paid_this_month_total) : "–" %></p>
        <p class="text-sm text-secondary"><%= t(".paid_so_far") %></p>
        <% if @due_next_seven %>
          <p class="text-xs text-secondary privacy-sensitive"><%= t(".hero_next_seven", amount: format_money(@due_next_seven)) %></p>
        <% end %>
      </div>
    </div>
    <% if @unconvertible_count.positive? %>
      <p class="text-xs text-warning text-center mt-2"><%= t(".unconvertible", count: @unconvertible_count) %></p>
    <% end %>
  </div>


  <% if @notices.any? %>
    <div class="bg-container rounded-xl shadow-border-xs divide-y divide-divider">
      <% @notices.each do |notice| %>
        <div class="flex items-center justify-between gap-3 px-4 py-2">
          <p class="text-sm text-primary">
            <% case notice.kind %>
            <% when :trial %>
              <%= t(".notice_trial", name: notice.series.display_name, date: l(notice.date, format: :long)) %>
            <% when :renewal %>
              <%= t(".notice_renewal", name: notice.series.display_name, date: l(notice.date, format: :long)) %>
            <% when :price %>
              <span class="privacy-sensitive">
                <%= t(".notice_price",
                      name: notice.series.display_name,
                      from: format_money(notice.detail.previous_amount_money),
                      to: format_money(notice.detail.new_amount_money)) %>
              </span>
            <% end %>
          </p>
          <%= link_to t("bills.details"), bill_path(notice.series),
                data: { turbo_frame: "drawer" }, class: "text-xs text-link hover:underline shrink-0" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @suggested_allocations.any? %>
    <div class="rounded-xl bg-container-inset space-y-1 p-1">
      <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
        <p><%= t(".needs_review") %></p>
        <span class="text-subdued">&middot;</span>
        <p><%= @suggested_allocations.size %></p>
      </div>

      <div class="bg-container rounded-lg shadow-border-xs divide-y divide-divider">
        <% @suggested_allocations.each do |suggestion| %>
          <% series = suggestion.recurring_occurrence.recurring_transaction %>
          <div class="flex items-center justify-between gap-4 px-4 py-3">
            <div class="min-w-0">
              <p class="text-sm text-primary truncate">
                <%= t(".suggestion_line",
                      entry: suggestion.entry&.name.presence || t(".suggestion_unknown_entry"),
                      bill: series.display_name) %>
              </p>
              <p class="text-xs text-secondary privacy-sensitive">
                <%= format_money(suggestion.allocated_amount_money) %>
                &middot; <%= l(suggestion.paid_on, format: :short) %>
                <% if suggestion.match_confidence.present? %>
                  &middot; <%= t(".confidence", percent: (suggestion.match_confidence * 100).round) %>
                <% end %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= render DS::Link.new(
                    text: t(".accept"),
                    variant: "primary",
                    href: confirm_recurring_allocation_path(suggestion),
                    method: :post
                  ) %>
              <%= render DS::Link.new(
                    text: t(".reject"),
                    variant: "ghost",
                    href: reject_recurring_allocation_path(suggestion),
                    method: :post
                  ) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if [ @month_rows, @later, @dormant ].all?(&:empty?) %>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <%= render DS::EmptyState.new(
            icon: "receipt",
            title: t(".empty.title"),
            description: t(".empty.description")
          ) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(
                text: t(".add_bill"),
                icon: "plus",
                variant: "primary",
                href: new_recurring_transaction_path,
                frame: :modal
              ) %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl bg-container-inset space-y-1 p-1">
      <%= render "bills/occurrence_section", title: t(".this_month"), occurrences: @month_rows, date_labels: true %>
      <%= render "bills/occurrence_section", title: t(".later"), occurrences: @later %>
      <%= render "bills/occurrence_section", title: t(".dormant"), occurrences: @dormant %>
    </div>
  <% end %>
  </div>

  <%# Wide-screen detail pane: the selected bill's full story, drawer-free.
      Gated at 2xl because the app shell's two sidebars leave narrower
      viewports without room for a fixed column next to the dense rows. %>
  <div class="hidden 2xl:block sticky top-4">
    <% if @default_pane_series %>
      <%= turbo_frame_tag "bill_detail", src: bill_path(@default_pane_series, display: "pane") %>
    <% else %>
      <%= turbo_frame_tag "bill_detail" %>
    <% end %>
  </div>
  </div>
</div>
