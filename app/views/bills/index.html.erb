<%= content_for :page_title, t(".title") %>

<div class="space-y-4 pb-6 lg:pb-12">
  <%= render "bills/view_switcher", active: "overview" %>

  <%# One card divided into cells, per the app's KPI convention. %>
  <div class="grid grid-cols-2 md:grid-cols-4 bg-container rounded-xl shadow-border-xs md:divide-x divide-y md:divide-y-0 divide-alpha-black-100 theme-dark:divide-alpha-white-200">
    <div class="p-4 space-y-1">
      <p class="text-sm text-secondary"><%= t(".kpi_remaining") %></p>
      <p class="text-primary font-medium text-xl privacy-sensitive"><%= @remaining_this_month ? format_money(@remaining_this_month) : "–" %></p>
      <p class="text-xs text-secondary">
        <%= t(".summary_count", count: @owed_count) %>
        <% if @needs_action_count < @owed_count %>
          &middot; <%= t(".needs_action_count", count: @needs_action_count) %>
        <% end %>
      </p>
      <% if @unconvertible_count.positive? %>
        <p class="text-xs text-warning"><%= t(".unconvertible", count: @unconvertible_count) %></p>
      <% end %>
    </div>
    <div class="p-4 space-y-1">
      <p class="text-sm text-secondary"><%= t(".kpi_paid") %></p>
      <p class="text-primary font-medium text-xl privacy-sensitive"><%= @paid_this_month_total ? format_money(@paid_this_month_total) : "–" %></p>
      <p class="text-xs text-secondary"><%= t(".paid_count", count: @paid_this_month.size) %></p>
    </div>
    <div class="p-4 space-y-1">
      <p class="text-sm text-secondary"><%= t(".kpi_next_seven") %></p>
      <p class="text-primary font-medium text-xl privacy-sensitive"><%= @due_next_seven ? format_money(@due_next_seven) : "–" %></p>
    </div>
    <div class="p-4 space-y-1">
      <p class="text-sm text-secondary"><%= t(".kpi_past_due") %></p>
      <p class="font-medium text-xl privacy-sensitive <%= @past_due_total ? "text-destructive" : "text-primary" %>">
        <%= @past_due_total ? format_money(@past_due_total) : "–" %>
      </p>
    </div>
  </div>

  <% if @suggested_allocations.any? %>
    <div class="rounded-xl bg-container-inset space-y-1 p-1">
      <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
        <p><%= t(".needs_review") %></p>
        <span class="text-subdued">&middot;</span>
        <p><%= @suggested_allocations.size %></p>
      </div>

      <div class="bg-container rounded-lg shadow-border-xs divide-y divide-divider">
        <% @suggested_allocations.each do |suggestion| %>
          <% series = suggestion.recurring_occurrence.recurring_transaction %>
          <div class="flex items-center justify-between gap-4 px-4 py-3">
            <div class="min-w-0">
              <p class="text-sm text-primary truncate">
                <%= t(".suggestion_line",
                      entry: suggestion.entry&.name.presence || t(".suggestion_unknown_entry"),
                      bill: series.display_name) %>
              </p>
              <p class="text-xs text-secondary privacy-sensitive">
                <%= format_money(suggestion.allocated_amount_money) %>
                &middot; <%= l(suggestion.paid_on, format: :short) %>
                <% if suggestion.match_confidence.present? %>
                  &middot; <%= t(".confidence", percent: (suggestion.match_confidence * 100).round) %>
                <% end %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= render DS::Link.new(
                    text: t(".accept"),
                    variant: "primary",
                    href: confirm_recurring_allocation_path(suggestion),
                    method: :post
                  ) %>
              <%= render DS::Link.new(
                    text: t(".reject"),
                    variant: "ghost",
                    href: reject_recurring_allocation_path(suggestion),
                    method: :post
                  ) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if [ @overdue, @this_month, @later, @paid_this_month, @dormant ].all?(&:empty?) %>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <%= render DS::EmptyState.new(
            icon: "receipt",
            title: t(".empty.title"),
            description: t(".empty.description")
          ) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(
                text: t(".add_bill"),
                icon: "plus",
                variant: "primary",
                href: new_recurring_transaction_path,
                frame: :modal
              ) %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl bg-container-inset space-y-1 p-1">
      <%= render "bills/occurrence_section", title: t(".overdue"), occurrences: @overdue, tone: :destructive %>
      <%= render "bills/occurrence_section", title: t(".this_month"), occurrences: @this_month %>
      <%= render "bills/occurrence_section", title: t(".later"), occurrences: @later %>
      <%= render "bills/occurrence_section", title: t(".paid_this_month"), occurrences: @paid_this_month %>
      <%= render "bills/occurrence_section", title: t(".dormant"), occurrences: @dormant %>
    </div>
  <% end %>
</div>
