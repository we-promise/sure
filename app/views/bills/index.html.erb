<%= content_for :page_title, t(".title") %>

<div class="space-y-4 pb-6 lg:pb-12">
  <div class="flex justify-end">
    <%= render DS::Link.new(
          text: t(".add_bill"),
          icon: "plus",
          variant: "primary",
          href: new_recurring_transaction_path,
          frame: :modal
        ) %>
  </div>

  <% if @suggested_allocations.any? %>
    <div class="rounded-xl bg-container-inset space-y-1 p-1">
      <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
        <p><%= t(".needs_review") %></p>
        <span class="text-subdued">&middot;</span>
        <p><%= @suggested_allocations.size %></p>
      </div>

      <div class="bg-container rounded-lg shadow-border-xs divide-y divide-divider">
        <% @suggested_allocations.each do |suggestion| %>
          <% series = suggestion.recurring_occurrence.recurring_transaction %>
          <div class="flex items-center justify-between gap-4 px-4 py-3">
            <div class="min-w-0">
              <p class="text-sm text-primary truncate">
                <%= t(".suggestion_line",
                      entry: suggestion.entry&.name.presence || t(".suggestion_unknown_entry"),
                      bill: series.display_name) %>
              </p>
              <p class="text-xs text-secondary privacy-sensitive">
                <%= format_money(suggestion.allocated_amount_money) %>
                &middot; <%= l(suggestion.paid_on, format: :short) %>
                <% if suggestion.match_confidence.present? %>
                  &middot; <%= t(".confidence", percent: (suggestion.match_confidence * 100).round) %>
                <% end %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= render DS::Link.new(
                    text: t(".accept"),
                    variant: "primary",
                    href: confirm_recurring_allocation_path(suggestion),
                    method: :post
                  ) %>
              <%= render DS::Link.new(
                    text: t(".reject"),
                    variant: "ghost",
                    href: reject_recurring_allocation_path(suggestion),
                    method: :post
                  ) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @overdue.empty? && @this_month.empty? && @later.empty? %>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <%= render DS::EmptyState.new(
            icon: "receipt",
            title: t(".empty.title"),
            description: t(".empty.description")
          ) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(
                text: t(".empty.action"),
                icon: "search",
                variant: "primary",
                href: recurring_transactions_path
              ) %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <% if @total_due %>
      <div class="bg-container rounded-xl shadow-border-xs p-4">
        <p class="text-xs uppercase font-medium text-secondary"><%= t(".summary_label") %></p>
        <p class="text-2xl font-medium text-primary privacy-sensitive mt-1">
          <%= format_money(@total_due) %>
        </p>
        <p class="text-xs text-secondary mt-1">
          <%= t(".summary_count", count: @due_count) %>
          <span class="text-subdued">&middot;</span>
          <% if @needs_action_count.zero? %>
            <%= t(".all_automatic") %>
          <% else %>
            <%= t(".summary_needs_action", count: @needs_action_count) %>
          <% end %>
        </p>
        <% if @unconvertible_count.to_i.positive? %>
          <p class="text-xs text-warning mt-1">
            <%= t(".unconvertible", count: @unconvertible_count) %>
          </p>
        <% end %>
      </div>
    <% end %>

    <% if @monthly_total %>
      <div class="bg-container rounded-xl shadow-border-xs p-4">
        <p class="text-xs uppercase font-medium text-secondary"><%= t(".recurring_label") %></p>
        <p class="text-sm text-primary privacy-sensitive mt-1">
          <%= t(".recurring_monthly", amount: format_money(@monthly_total)) %>
          <span class="text-subdued">&middot;</span>
          <%= t(".recurring_annual", amount: format_money(@monthly_total * 12)) %>
        </p>
      </div>
    <% end %>

    <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-4">
      <%= render "bills/section", title: t(".overdue"), bills: @overdue, tone: :destructive %>
      <%= render "bills/section", title: t(".this_month"), bills: @this_month %>
      <%= render "bills/section", title: t(".later"), bills: @later %>
    </div>
  <% end %>
</div>
