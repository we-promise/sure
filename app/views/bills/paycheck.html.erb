<%= content_for :page_title, t("bills.index.title") %>

<div class="space-y-4 pb-6 lg:pb-12">
  <%= render "bills/view_switcher", active: "paycheck" %>

  <% if @plan.nil? %>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <%= render DS::EmptyState.new(
            icon: "calendar-clock",
            title: t(".empty.title"),
            description: t(".empty.description")
          ) do |empty| %>
        <% empty.with_action do %>
          <%= render DS::Link.new(
                text: t(".empty.action"),
                icon: "plus",
                variant: "primary",
                href: new_recurring_transaction_path,
                frame: :modal
              ) %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# The headline: the next paycheck and what is safe after bills. %>
    <% headline = @plan.find { |period| period.income.positive? } %>
    <% currency = Current.family.currency %>
    <% if headline %>
      <div class="grid grid-cols-3 bg-container rounded-xl shadow-border-xs divide-x divide-alpha-black-100 theme-dark:divide-alpha-white-200">
        <div class="p-4 space-y-1">
          <p class="text-sm text-secondary"><%= t(".next_paycheck") %></p>
          <p class="text-primary font-medium text-xl"><%= l(headline.starts_on, format: :long) %></p>
          <p class="text-xs text-success privacy-sensitive">+<%= format_money(Money.new(headline.income, currency)) %></p>
        </div>
        <div class="p-4 space-y-1">
          <p class="text-sm text-secondary"><%= t(".bills_that_period") %></p>
          <p class="text-primary font-medium text-xl privacy-sensitive"><%= format_money(Money.new(headline.obligation_total, currency)) %></p>
        </div>
        <div class="p-4 space-y-1">
          <p class="text-sm text-secondary"><%= t(".safe_after_bills") %></p>
          <p class="font-medium text-xl privacy-sensitive <%= headline.remaining.negative? ? "text-destructive" : "text-success" %>">
            <%= format_money(Money.new(headline.remaining, currency)) %>
          </p>
        </div>
      </div>
    <% end %>

    <div class="space-y-3">
      <% @plan.each_with_index do |period, index| %>
        <% due_items = period.items.select(&:due_in_period) %>
        <% set_aside_items = period.items.reject(&:due_in_period) %>
        <% set_aside_total = set_aside_items.sum(&:share) %>
        <% load_pct = period.income.positive? ? [ (period.obligation_total / period.income * 100).round, 100 ].min : (period.obligation_total.positive? ? 100 : 0) %>

        <div class="bg-container rounded-xl shadow-border-xs overflow-hidden">
          <div class="px-4 py-3 space-y-2">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="text-sm font-medium text-primary">
                  <% if index.zero? && !period.income.positive? %>
                    <%= t(".before_next_paycheck") %>
                  <% else %>
                    <%= t(".paycheck_of", date: l(period.starts_on, format: :long)) %>
                  <% end %>
                </p>
                <p class="text-xs text-secondary">
                  <%= t(".period_range", from: l(period.starts_on, format: :short), to: l(period.ends_on, format: :short)) %>
                  <% if period.final %>&middot; <%= t(".and_beyond") %><% end %>
                </p>
              </div>
              <div class="text-right">
                <p class="text-sm font-medium privacy-sensitive <%= period.remaining.negative? ? "text-destructive" : "text-primary" %>">
                  <%= format_money(Money.new(period.remaining, currency)) %>
                </p>
                <p class="text-xs text-secondary"><%= t(".remaining_after_bills") %></p>
              </div>
            </div>

            <%# How much of this paycheck the bills consume. %>
            <div class="h-1.5 rounded-full bg-surface-inset overflow-hidden"
                 role="progressbar" aria-valuenow="<%= load_pct %>" aria-valuemin="0" aria-valuemax="100"
                 aria-label="<%= t(".load_aria", percent: load_pct) %>">
              <div class="h-full rounded-full <%= period.remaining.negative? ? "bg-destructive" : (load_pct > 75 ? "bg-warning" : "bg-success") %>"
                   style="width: <%= load_pct %>%"></div>
            </div>
            <div class="flex items-center justify-between text-xs text-secondary privacy-sensitive">
              <span><%= t(".income_line", amount: format_money(Money.new(period.income, currency))) %></span>
              <span><%= t(".obligations_line", amount: format_money(Money.new(period.obligation_total, currency))) %></span>
            </div>
          </div>

          <% if due_items.any? %>
            <div class="border-t border-divider divide-y divide-divider">
              <% due_items.each do |item| %>
                <% series = item.occurrence.recurring_transaction %>
                <div class="flex items-center justify-between gap-3 px-4 py-2">
                  <div class="min-w-0 flex items-center gap-2">
                    <%= icon "calendar-check", size: "sm", class: "text-secondary shrink-0" %>
                    <div class="min-w-0">
                      <p class="text-sm text-primary truncate">
                        <%= link_to series.display_name, recurring_occurrence_path(item.occurrence),
                              data: { turbo_frame: :modal }, class: "hover:underline" %>
                      </p>
                      <p class="text-xs text-secondary"><%= t(".due_here", date: l(item.occurrence.due_on, format: :short)) %></p>
                    </div>
                  </div>
                  <p class="text-sm text-primary privacy-sensitive shrink-0">
                    <%= format_money(Money.new(item.share, currency)) %>
                  </p>
                </div>
              <% end %>
            </div>
          <% elsif period.items.empty? %>
            <p class="px-4 py-3 border-t border-divider text-sm text-secondary"><%= t(".nothing_due") %></p>
          <% end %>

          <% if set_aside_items.any? %>
            <div class="border-t border-divider px-4 py-2">
              <%= render DS::Disclosure.new(title: t(".set_aside_disclosure", amount: format_money(Money.new(set_aside_total, currency)))) do %>
                <div class="divide-y divide-divider">
                  <% set_aside_items.each do |item| %>
                    <% series = item.occurrence.recurring_transaction %>
                    <div class="flex items-center justify-between gap-3 py-2">
                      <div class="min-w-0 flex items-center gap-2">
                        <%= icon "piggy-bank", size: "sm", class: "text-secondary shrink-0" %>
                        <div class="min-w-0">
                          <p class="text-sm text-primary truncate">
                            <%= link_to series.display_name, recurring_occurrence_path(item.occurrence),
                                  data: { turbo_frame: :modal }, class: "hover:underline" %>
                          </p>
                          <p class="text-xs text-secondary"><%= t(".set_aside_for", date: l(item.occurrence.due_on, format: :short)) %></p>
                        </div>
                      </div>
                      <p class="text-sm text-primary privacy-sensitive shrink-0">
                        <%= format_money(Money.new(item.share, currency)) %>
                      </p>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if period.remaining.negative? && period.items.any? %>
            <p class="px-4 py-2 border-t border-divider text-xs text-destructive">
              <%= t(".trough_warning", bill: period.items.first.occurrence.recurring_transaction.display_name) %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
