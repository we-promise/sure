<%# locals: (title:, occurrences:, suggestions: {}, meta: nil) %>
<% return if occurrences.empty? %>

<%# No shell by default: bills/index stacks the month sections in one. %>
<%= render DS::Section.new(title: title, count: occurrences.size, inset: false, divided: false) do |section| %>
  <% section.with_aside { tag.p(meta, class: "text-xs text-secondary privacy-sensitive shrink-0") } if meta %>
  <% occurrences.each do |occurrence| %>
    <% if occurrence.recurring_transaction.typed_income? %>
      <%= render "bills/payday", occurrence: occurrence %>
    <% else %>
      <%= render "bills/occurrence", occurrence: occurrence, suggestion: suggestions[occurrence.id] %>
    <% end %>
  <% end %>
<% end %>