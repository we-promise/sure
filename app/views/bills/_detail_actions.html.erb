<%# locals: (series:, frame: nil) %>

<%# The same three verbs sat in both detail surfaces, duplicated line for line.
    Edit, pause and delete stay uniformly quiet: one outline button among three
    reads as inconsistency rather than hierarchy, and delete should not shout. %>
<div class="flex items-center justify-between gap-2">
  <div class="flex items-center gap-1">
    <%= render DS::Link.new(
          text: t("bills.show.edit"),
          icon: "pencil",
          variant: "ghost",
          href: edit_recurring_transaction_path(series),
          frame: :modal
        ) %>
    <%= render DS::Link.new(
          text: series.active? ? t("recurring_transactions.actions.pause") : t("recurring_transactions.actions.resume"),
          icon: series.active? ? "pause" : "play",
          variant: "ghost",
          href: toggle_status_recurring_transaction_path(series),
          method: :post,
          data: frame ? { turbo_frame: frame } : {}
        ) %>
    <%= render DS::Link.new(
          text: t("recurring_transactions.actions.delete"),
          icon: "trash-2",
          variant: "ghost",
          class: "text-destructive",
          href: recurring_transaction_path(series),
          method: :delete,
          data: {
            turbo_frame: frame,
            turbo_confirm: t(series.typed_income? ? "recurring_transactions.confirm_delete_income" : "recurring_transactions.confirm_delete", name: series.display_name)
          }.compact
        ) %>
  </div>
  <%= render "recurring_transactions/pay_action", recurring_transaction: series, show_add: false %>
</div>
