<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t("bitcoin_wallets.title"), subtitle: @account.name) %>
  <% dialog.with_body do %>
    <div class="space-y-4">
      <%= render DS::Pill.new(label: t("bitcoin_wallets.preview")) %>
      <%= render DS::Alert.new(message: @error_message, variant: :error) if @error_message.present? %>
      <%# Polling replaces only this frame, so the source form keeps its input. %>
      <%= turbo_frame_tag dom_id(@wallet, :status), class: "block space-y-4",
            data: (@wallet.status_discovering? || @wallet.syncing? ? { controller: "polling", polling_url_value: account_bitcoin_wallet_path(@account) } : {}) do %>
        <%= render "onchain_wallet_items/price_provider_warning", currency: @account.currency, retains_valuation: true %>
        <% if @wallet.status_failed? || @wallet.last_error.present? %>
          <%= render DS::Alert.new(message: t("bitcoin_wallets.#{@wallet_error_key}"), variant: :warning) %>
        <% elsif @wallet.status_discovering? %>
          <%= render DS::Alert.new(message: t("bitcoin_wallets.discovering"), variant: :info) %>
          <% if @sources.any? { |source| source.kind == "bip84" } %>
            <p class="text-sm text-secondary"><%= t("bitcoin_wallets.discovery_progress", count: @discovery_checked) %></p>
          <% end %>
        <% end %>
        <%= render DS::Alert.new(message: t("bitcoin_wallets.stale"), variant: :warning) if @wallet.read_outdated? && @wallet.last_synced_at %>
        <% if @wallet.last_synced_at %>
          <div>
            <p class="text-lg font-medium text-primary tabular-nums privacy-sensitive"><%= t("bitcoin_wallets.quantity", quantity: format_quantity(@wallet.quantity, exact: true)) %></p>
            <% if @value %>
              <p class="text-sm text-secondary tabular-nums privacy-sensitive"><%= format_money(@value) %></p>
            <% end %>
          </div>
          <p class="text-sm text-secondary privacy-sensitive"><%= t("bitcoin_wallets.confirmation", confirmed: format_quantity(@confirmed_quantity, exact: true), pending: format_quantity(@pending_quantity, exact: true)) %></p>
          <p class="text-sm text-secondary"><%= t("bitcoin_wallets.last_synced", time: l(@wallet.last_synced_at, format: :long)) %></p>
        <% end %>
        <p class="text-sm text-secondary"><%= t("bitcoin_wallets.address_count", count: @address_count) %></p>
        <% if @wallet.status_preview? && !@wallet.stale? %>
          <%= render DS::Alert.new(message: t("bitcoin_wallets.reconcile", previous: format_quantity(@previous_quantity.to_d, exact: true), current: format_quantity(@wallet.quantity, exact: true)), variant: :info) %>
          <%= render DS::Button.new(text: t("bitcoin_wallets.connect"), href: connect_account_bitcoin_wallet_path(@account),
                                   method: :post, data: { turbo_frame: "_top" }) %>
        <% end %>
        <% if @wallet.history_truncated? %>
          <%= render DS::Alert.new(message: t("bitcoin_wallets.history_truncated"), variant: :warning) %>
        <% end %>
        <%= render DS::Disclosure.new(title: t("bitcoin_wallets.addresses")) do %>
          <ul class="space-y-2 text-xs text-secondary break-all">
            <% @addresses.each do |address| %>
              <li><%= address.address %></li>
            <% end %>
          </ul>
          <p class="text-xs text-secondary"><%= t("bitcoin_wallets.showing_addresses", shown: @addresses.size, total: @address_count) %></p>
        <% end %>
      <% end %>
      <ul class="divide-y divide-primary">
        <% @sources.each do |source| %>
          <li class="flex items-center justify-between gap-3 py-3">
            <div class="min-w-0">
              <p class="text-sm text-primary"><%= t("bitcoin_wallets.#{source.kind == 'bip84' ? 'bip84' : 'manual_address'}") %></p>
              <p class="break-all text-xs text-secondary"><%= source.receive_address %></p>
            </div>
            <% unless @sources.one? %>
              <%= render DS::Button.new(variant: :icon, icon: "unlink", title: t("bitcoin_wallets.remove_source"),
                    href: remove_source_account_bitcoin_wallet_path(@account, source_id: source.id), method: :delete,
                    confirm: t("bitcoin_wallets.remove_source_confirm"), data: { turbo_frame: "_top" }) %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= render DS::Disclosure.new(title: t("bitcoin_wallets.add_source"), open: @source.errors.any?) do %>
        <%= render "source_form", url: add_source_account_bitcoin_wallet_path(@account), source: @source %>
      <% end %>
      <div class="flex flex-wrap gap-2">
        <%= render DS::Button.new(text: t("bitcoin_wallets.sync"), href: sync_account_bitcoin_wallet_path(@account), method: :post, variant: :secondary) %>
        <% if @wallet.account_provider %>
          <%= render DS::Button.new(text: t("bitcoin_wallets.disconnect"), href: account_bitcoin_wallet_path(@account),
                                   method: :delete, variant: :outline_destructive, confirm: t("bitcoin_wallets.disconnect_confirm"), data: { turbo_frame: "_top" }) %>
        <% else %>
          <%= render DS::Button.new(text: t("bitcoin_wallets.cancel_setup"), href: account_bitcoin_wallet_path(@account),
                                   method: :delete, variant: :outline_destructive, confirm: t("bitcoin_wallets.cancel_setup_confirm"), data: { turbo_frame: "_top" }) %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
