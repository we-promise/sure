<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t("bitcoin_wallets.title"), subtitle: @account.name) %>
  <% dialog.with_body do %>
    <div class="space-y-4">
      <%= render DS::Alert.new(message: @error_message, variant: :error) if @error_message.present? %>
      <%# Polling replaces only this frame, so the source form keeps its input. %>
      <%= turbo_frame_tag dom_id(@wallet, :status), class: "block space-y-4",
            data: (@wallet.status_discovering? || @wallet.syncing? ? { controller: "polling", polling_url_value: account_bitcoin_wallet_path(@account) } : {}) do %>
        <%# Status line: one pill that names the state the wallet is in. %>
        <div class="flex items-center gap-2 text-sm text-secondary">
          <% if @wallet.account_provider %>
            <%= render DS::Pill.new(label: t("bitcoin_wallets.status.tracking"), tone: :success, marker: false) %>
          <% elsif @wallet.status_discovering? %>
            <%= render DS::Pill.new(label: t("bitcoin_wallets.status.reading"), tone: :info, marker: false) %>
          <% elsif @wallet.status_preview? && !@wallet.stale? %>
            <%= render DS::Pill.new(label: t("bitcoin_wallets.status.ready"), tone: :info, marker: false) %>
          <% elsif @wallet_error_key == "temporary_failure" %>
            <%= render DS::Pill.new(label: t("bitcoin_wallets.status.retrying"), tone: :info, marker: false) %>
          <% else %>
            <%= render DS::Pill.new(label: t("bitcoin_wallets.status.needs_attention"), tone: :warning, marker: false) %>
          <% end %>
          <% if @wallet.last_synced_at %>
            <span><%= t("bitcoin_wallets.read_ago", time: time_ago_in_words(@wallet.last_synced_at)) %></span>
          <% end %>
        </div>

        <% if @wallet.last_error.present? || @wallet.status_failed? %>
          <%= render DS::Alert.new(message: t("bitcoin_wallets.#{@wallet_error_key}"),
                                   variant: @wallet_error_key == "temporary_failure" ? :info : :warning) %>
        <% end %>
        <%= render DS::Alert.new(message: t("bitcoin_wallets.stale"), variant: :warning) if @wallet.read_outdated? && @wallet.last_synced_at %>

        <% if @wallet.status_discovering? %>
          <%= render DS::Card.new do %>
            <div class="flex items-center gap-3">
              <%= icon "loader-circle", class: "animate-spin text-secondary" %>
              <div>
                <p class="text-sm font-medium text-primary"><%= t("bitcoin_wallets.discovering_title") %></p>
                <p class="text-sm text-secondary">
                  <%= @hd_wallet ? t("bitcoin_wallets.discovery_progress", count: @discovery_checked) : t("bitcoin_wallets.discovering_address") %>
                </p>
              </div>
            </div>
          <% end %>
        <% else %>
          <%= render DS::Card.new do %>
            <p class="text-sm text-secondary"><%= t("bitcoin_wallets.wallet_value") %></p>
            <p class="text-2xl font-medium text-primary tabular-nums privacy-sensitive"><%= @value ? format_money(@value) : "—" %></p>
            <p class="text-sm text-secondary tabular-nums privacy-sensitive">
              <%= t("bitcoin_wallets.quantity", quantity: format_quantity(@wallet.quantity, exact: true)) %>
              <% if @pending_quantity.nonzero? %>
                · <%= t("bitcoin_wallets.pending_amount", amount: format_quantity(@pending_quantity, exact: true)) %>
              <% end %>
            </p>
          <% end %>
        <% end %>

        <% if @wallet.status_preview? && !@wallet.stale? && @wallet.account_provider.nil? %>
          <p class="text-sm text-secondary">
            <% if @previous_quantity.to_d.zero? %>
              <%= t("bitcoin_wallets.connect_explainer_new") %>
            <% else %>
              <%= t("bitcoin_wallets.connect_explainer_replace",
                    previous: format_quantity(@previous_quantity.to_d, exact: true),
                    difference: "#{'+' if @quantity_difference.positive?}#{format_quantity(@quantity_difference, exact: true)}") %>
            <% end %>
          </p>
        <% end %>

        <% if @wallet.history_truncated? %>
          <%= render DS::Alert.new(message: t("bitcoin_wallets.history_truncated"), variant: :info) %>
        <% end %>

        <%# Actions depend on state: a draft can only be started or cancelled. Reads reload the whole dialog so polling restarts. %>
        <div class="flex flex-wrap gap-2">
          <% if @wallet.account_provider %>
            <%= render DS::Button.new(text: t("bitcoin_wallets.sync_now"), href: sync_account_bitcoin_wallet_path(@account),
                                     method: :post, variant: :secondary, icon: "refresh-cw", data: { turbo_frame: "modal" }) %>
            <%= render DS::Button.new(text: t("bitcoin_wallets.stop_tracking"), href: account_bitcoin_wallet_path(@account),
                                     method: :delete, variant: :ghost, confirm: t("bitcoin_wallets.disconnect_confirm"),
                                     data: { turbo_frame: "_top" }) %>
          <% else %>
            <% if @wallet.status_preview? && !@wallet.stale? %>
              <%= render DS::Button.new(text: t("bitcoin_wallets.start_tracking"), href: connect_account_bitcoin_wallet_path(@account),
                                       method: :post, data: { turbo_frame: "_top" }) %>
            <% elsif !@wallet.status_discovering? %>
              <%= render DS::Button.new(text: t("bitcoin_wallets.read_again"), href: sync_account_bitcoin_wallet_path(@account),
                                       method: :post, variant: :secondary, icon: "refresh-cw", data: { turbo_frame: "modal" }) %>
            <% end %>
            <%= render DS::Button.new(text: t("bitcoin_wallets.cancel"), href: account_bitcoin_wallet_path(@account),
                                     method: :delete, variant: :ghost, data: { turbo_frame: "_top" }) %>
          <% end %>
        </div>
      <% end %>

      <%# Everything about addresses and sources is secondary: keep it folded. %>
      <%= render DS::Disclosure.new(title: t("bitcoin_wallets.details"), open: @field_errors.present? || @error_message.present?) do %>
        <div class="space-y-4 pt-2">
          <ul class="divide-y divide-primary">
            <% @sources.each do |source| %>
              <li class="flex items-center justify-between gap-3 py-3">
                <div class="min-w-0">
                  <p class="text-sm text-primary"><%= t("bitcoin_wallets.#{source.kind == 'bip84' ? 'bip84' : 'manual_address'}") %></p>
                  <p class="break-all text-xs text-secondary font-mono"><%= source.receive_address %></p>
                </div>
                <% unless @sources.one? %>
                  <%= render DS::Button.new(variant: :ghost, size: :sm, text: t("bitcoin_wallets.remove_source"),
                        href: remove_source_account_bitcoin_wallet_path(@account, source_id: source.id), method: :delete,
                        confirm: t("bitcoin_wallets.remove_source_confirm"), data: { turbo_frame: "_top" }) %>
                <% end %>
              </li>
            <% end %>
          </ul>
          <p class="text-xs text-secondary"><%= t("bitcoin_wallets.address_count", count: @address_count) %></p>
          <% if @addresses.any? %>
            <ul class="space-y-1 text-xs text-secondary break-all font-mono">
              <% @addresses.each do |address| %>
                <li><%= address.address %></li>
              <% end %>
            </ul>
          <% end %>
          <div class="space-y-2">
            <p class="text-sm font-medium text-primary"><%= t("bitcoin_wallets.add_source") %></p>
            <%= render "source_form", url: add_source_account_bitcoin_wallet_path(@account),
                                      values: @form_values, errors: @field_errors, submit_label: t("bitcoin_wallets.add_source_submit") %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
