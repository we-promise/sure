<%# locals: (url:, source:, securities: []) %>
<%= styled_form_with model: source, url: url, scope: :source, method: :post,
                     data: { turbo_frame: "modal", controller: "bitcoin-wallet-source" }, class: "space-y-4" do |form| %>
  <% if securities.present? %>
    <%= form.collection_select :security_id, securities, :id, :ticker,
                               { label: t("bitcoin_wallets.security"), selected: params.dig(:source, :security_id) || securities.first.id } %>
  <% end %>
  <%= form.select :kind, [[t("bitcoin_wallets.manual_address"), "address"], [t("bitcoin_wallets.bip84"), "bip84"]],
                  { label: t("bitcoin_wallets.source_kind") },
                  { data: { bitcoin_wallet_source_target: "kind", action: "change->bitcoin-wallet-source#toggle" } } %>
  <div data-bitcoin-wallet-source-target="hdFields" class="space-y-4">
    <%= form.text_field :extended_public_key, label: t("bitcoin_wallets.public_key"), autocomplete: "off", spellcheck: false,
                        help_text: t("bitcoin_wallets.source_hint") %>
    <%= render "field_errors", source: source, attribute: :extended_public_key %>
    <%= form.number_field :gap_limit, label: t("bitcoin_wallets.gap_limit"), min: 20, max: 1000 %>
    <%= render "field_errors", source: source, attribute: :gap_limit %>
  </div>
  <%= form.text_field :receive_address, label: t("bitcoin_wallets.receive_address"), required: true %>
  <%= render "field_errors", source: source, attribute: :receive_address %>
  <%= form.submit t("bitcoin_wallets.discover") %>
<% end %>
