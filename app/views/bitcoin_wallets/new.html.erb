<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t("bitcoin_wallets.title"), subtitle: @account.name) %>
  <% dialog.with_body do %>
    <div class="space-y-4">
      <%= render DS::Pill.new(label: t("bitcoin_wallets.preview")) %>
      <%= render ProviderLogo.new(provider_key: :onchain_wallet) %>
      <%= render "onchain_wallet_items/price_provider_warning" %>
      <%= render DS::Alert.new(message: t("bitcoin_wallets.read_only"), variant: :info) %>
      <%= render DS::Alert.new(message: @error_message, variant: :error) if @error_message.present? %>
      <%= render "source_form", url: account_bitcoin_wallet_path(@account), securities: @securities %>
    </div>
  <% end %>
<% end %>
