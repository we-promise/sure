<%# locals: (tag:, entry:, selected:, autofocus: false) %>

<%= content_tag :div,
      id: "#{dom_id(entry, :tag_option)}_#{tag.id}",
      role: "option",
      aria: { selected: selected.to_s },
      class: ["filterable-item flex items-center border-none rounded-lg px-2 py-1 w-full hover:bg-container-inset-hover",
              { "bg-container-inset": selected }],
      data: { filter_name: tag.name } do %>
  <%= button_to tags_transaction_path(entry),
        method: :patch,
        params: { toggle_tag_id: tag.id },
        autofocus: autofocus,
        class: "flex w-full items-center gap-1.5 cursor-pointer" do %>
    <span class="flex items-center justify-center w-5 h-5 shrink-0">
      <% if selected %><%= icon("check") %><% end %>
    </span>

    <%= render DS::Pill.new(label: tag.name, marker: false, size: :md, custom_color: tag.color, truncate: true) %>
  <% end %>
<% end %>
