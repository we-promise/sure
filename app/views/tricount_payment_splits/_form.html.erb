<%# locals: (payment_split:, parts:, editing:) %>

<%# The transaction split dialog (splits/new and splits/edit) for a Tricount
    payment: the same header, rows, remaining balance and buttons. The parts
    are amounts only; each becomes a "(you paid, part n of m)" row. %>
<% step = (BigDecimal(1) / (10**payment_split.scale)).to_s("F") %>
<%= render DS::Dialog.new(variant: "modal") do |dialog| %>
  <% dialog.with_header do %>
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-primary"><%= payment_split.name %></h2>
        <p class="text-sm text-secondary"><%= payment_split.date.strftime("%b %d, %Y") %></p>
      </div>
      <div class="text-right shrink-0">
        <p class="text-xs font-medium text-secondary uppercase tracking-wide"><%= t("splits.new.original_amount") %></p>
        <p class="text-lg font-semibold text-primary privacy-sensitive"><%= format_money(payment_split.display_total) %></p>
      </div>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <%= form_with(
          url: tricount_payment_split_path(payment_split.entry),
          method: :patch,
          scope: :split,
          class: "space-y-3",
          data: {
            controller: "split-transaction",
            split_transaction_total_value: payment_split.total.amount.to_f,
            split_transaction_currency_value: payment_split.currency,
            turbo_frame: :_top
          }
        ) do %>
      <p class="text-sm text-secondary"><%= t("tricount_items.payment_split.description") %></p>

      <div data-split-transaction-target="rowsContainer" class="space-y-3">
        <% parts.each_with_index do |amount, index| %>
          <%= render "tricount_payment_splits/row", index: index, step: step, amount: amount, removable: editing || index.positive? %>
        <% end %>
      </div>

      <template data-split-transaction-target="rowTemplate">
        <%= render "tricount_payment_splits/row", index: "ROW_IDX_PLACEHOLDER", step: step %>
      </template>

      <button type="button"
              class="flex items-center justify-center gap-1.5 w-full py-2 text-sm font-medium text-secondary hover:text-primary border border-dashed border-secondary hover:border-primary rounded-lg transition-colors"
              data-action="click->split-transaction#addRow">
        <%= icon "plus", size: "sm" %>
        <%= t("splits.new.add_row") %>
      </button>

      <div data-split-transaction-target="remainingContainer" class="p-3 rounded-lg border <%= editing ? "border-secondary bg-container" : "border-destructive bg-red-tint-10" %> text-sm">
        <div class="flex items-center justify-between">
          <span class="text-secondary font-medium"><%= t("splits.new.remaining") %></span>
          <span data-split-transaction-target="remaining" class="font-semibold <%= editing ? "text-primary" : "text-destructive" %>">
            <%= payment_split.total.amount.to_f %>
          </span>
        </div>
        <p data-split-transaction-target="error" class="text-destructive text-xs mt-1.5 <%= "hidden" if editing %>">
          <%= t("splits.new.amounts_must_match") %>
        </p>
      </div>

      <p class="text-xs text-secondary"><%= t("tricount_items.payment_split.help") %></p>

      <div class="flex justify-end gap-3 pt-4 border-t border-primary">
        <%= render DS::Button.new(
          text: t("splits.new.cancel"),
          variant: "outline",
          type: "button",
          data: { action: "click->DS--dialog#close" }
        ) %>
        <%= render DS::Button.new(
          text: editing ? t("splits.edit.submit") : t("splits.new.submit"),
          variant: "primary",
          type: "submit",
          data: { split_transaction_target: "submitButton" }
        ) %>
      </div>
    <% end %>
  <% end %>
<% end %>
