<%# locals: (statement:, period:, as_of:, series:) %>

<div id="portfolio-value-chart">
  <%# Without a figure there is nothing to date; the chart area below says why. %>
  <% if series&.trend.present? %>
    <div class="space-y-2 px-4">
      <p class="text-primary -space-x-0.5 text-3xl font-medium privacy-sensitive">
        <%= format_money(series.trend.current) %>
      </p>
      <%= render partial: "shared/trend_change", locals: { trend: series.trend, comparison_label: period.comparison_label } %>
      <%# Dated by the point the figure above is read from: the end of a past period, not today. %>
      <p class="text-xs text-secondary"><%= t("portfolios.value_chart.as_of", date: l(series.values.last&.date || as_of, format: :long)) %></p>
    </div>
  <% end %>

  <% if series && series.values.size >= 2 %>
    <div
      id="portfolioValueChart"
      class="w-full h-52 privacy-sensitive"
      data-controller="time-series-chart"
      data-time-series-chart-data-value="<%= series.to_json %>"></div>
  <% else %>
    <div class="w-full flex items-center justify-center py-10">
      <p class="text-secondary text-sm"><%= t("portfolios.value_chart.no_data") %></p>
    </div>
  <% end %>
</div>
