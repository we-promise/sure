<%
  percentage = total.zero? ? 0 : (item[:total].to_f / total * 100).round(1)
  is_sub = level == :subcategory
  show_border = local_assigns.fetch(:show_border, false)
  row_start_date = local_assigns[:start_date]
  row_end_date = local_assigns[:end_date]
  # /transactions only lists Transaction rows. Skip trade-only buckets (e.g. Other
  # Investments) so the destination is not empty relative to the report row.
  clickable = item[:has_transactions] && row_start_date.present? && row_end_date.present?
  transactions_href = clickable ? transactions_path(q: { categories: [ item[:category_name] ], start_date: row_start_date, end_date: row_end_date }) : nil
%>

<tr data-category="category-<%= item[:category_id] %>"
    class="text-secondary text-sm <%= show_border ? "table-divider" : "" %>">
  <td colspan="2" class="py-3 px-4 lg:px-6 <%= is_sub ? "pl-7 lg:pl-9" : "" %>">
    <%
      row_content = capture do
        if is_sub
          concat tag.div(icon("corner-down-right"), class: "text-subdued")
        end
        if item[:category_icon]
          concat tag.div(
            icon(item[:category_icon], color: "current", size: "sm"),
            class: "h-7 w-7 flex-shrink-0 rounded-full flex justify-center items-center #{"group-hover/category-row:scale-105 transition-all duration-300" if clickable}",
            style: "background-color: color-mix(in oklab, #{item[:category_color]} 10%, transparent); border-color: color-mix(in oklab, #{item[:category_color]} 10%, transparent); color: #{item[:category_color]};"
          )
        else
          concat render(DS::FilledIcon.new(
            variant: :text,
            hex_color: item[:category_color],
            text: item[:category_name],
            size: "md",
            rounded: true
          ))
        end
        concat tag.span(item[:category_name], class: "font-medium text-primary #{"hover:underline" if clickable}")
        concat tag.span("(#{t("reports.transactions_breakdown.table.entries", count: item[:count])})", class: "text-xs text-subdued whitespace-nowrap")
      end
    %>
    <%# The clickable variant wraps the whole cluster (icon, name, count) in a
        single <a> using normal flex flow — deliberately NOT the `position:
        relative`/`absolute` stretched-link trick, which inside a <table> row
        is a known source of WebKit table-layout scrollHeight miscalculation
        (see #3093 investigation). %>
    <% if clickable %>
      <%= link_to row_content, transactions_href,
            class: "flex items-center gap-2 group/category-row",
            data: { turbo_frame: "_top", turbo_prefetch: false } %>
    <% else %>
      <%= tag.div row_content, class: "flex items-center gap-2" %>
    <% end %>
  </td>

  <td class="py-3 px-4 lg:px-6 text-right">
    <%
      amount_content = tag.span(
        Money.new(item[:total], Current.family.currency).format,
        class: "text-sm #{color_class} privacy-sensitive"
      )
    %>
    <% if clickable %>
      <%= link_to amount_content, transactions_href,
            class: "block", data: { turbo_frame: "_top", turbo_prefetch: false } %>
    <% else %>
      <%= amount_content %>
    <% end %>
  </td>

  <td class="py-3 px-4 lg:px-6 text-right">
    <%
      percentage_content = tag.span("#{percentage}%", class: "text-sm text-secondary")
    %>
    <% if clickable %>
      <%= link_to percentage_content, transactions_href,
            class: "block", data: { turbo_frame: "_top", turbo_prefetch: false } %>
    <% else %>
      <%= percentage_content %>
    <% end %>
  </td>
</tr>
