<%# locals: (rows:, start_date:, end_date:, filter_tags:) %>
<%= render DS::Table.new(rows: rows, inset: true, label: t("reports.spending_by_merchant.title")) do |table| %>
  <% table.with_column(t("reports.spending_by_merchant.table.merchant")) do |row| %>
    <%= link_to row.name || Merchant.no_merchant_name,
          transactions_path(q: { merchants: [ row.name || Merchant::NO_MERCHANT_FILTER_VALUE ], start_date: start_date, end_date: end_date, tags: filter_tags.map(&:filter_value).presence }.compact),
          class: class_names("font-medium hover:underline", row.name ? "text-primary" : "text-secondary"),
          data: { turbo_frame: "_top", turbo_prefetch: false } %>
  <% end %>
  <% table.with_column(t("reports.spending_by_merchant.table.spent"), numeric: true, class: "privacy-sensitive") do |row| %>
    <%= Money.new(row.net, Current.family.currency).format %>
  <% end %>
  <% table.with_column(t("reports.spending_by_merchant.table.purchases"), numeric: true) do |row| %>
    <%= row.purchases_count.to_s %>
  <% end %>
  <% table.with_column(t("reports.spending_by_merchant.table.average"), numeric: true, class: "privacy-sensitive") do |row| %>
    <%= Money.new(row.average, Current.family.currency).format %>
  <% end %>
<% end %>
