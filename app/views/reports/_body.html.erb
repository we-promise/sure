<div class="w-full space-y-6 lg:pb-6">
  <%= render "shared/exchange_rate_notes", family: Current.family %>

  <% if Current.family.transactions.any? %>
    <%# Summary Dashboard - Always visible, not collapsible %>
    <section class="@container">
      <%= render partial: "reports/summary_dashboard", locals: {
        metrics: @summary_metrics,
        period_type: @period_type
      } %>
    </section>

    <%# Collapsible & Reorderable Sections %>
    <%= render "shared/reorderable_sections",
          sections: @reports_sections,
          namespace: "reports",
          url: update_preferences_reports_path,
          i18n_scope: "reports.index" %>
  <% else %>
    <%# Empty State %>
    <section>
      <%= render partial: "reports/empty_state" %>
    </section>
  <% end %>
</div>
