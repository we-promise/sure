<%# locals: (entry:) %>

<% trade = entry.trade %>
<% reward = trade.non_cash_reward? %>

<div id="<%= dom_id(entry, :header) %>">
  <%= tag.header class: "mb-4 space-y-1" do %>
    <% label = trade.investment_activity_label %>
    <% income_trade = %w[Dividend Interest].include?(label) %>
    <%# The label is what the importer actually recorded, so it wins over the
        amount's sign: a transfer between two accounts you own is neither a
        purchase nor a sale, and calling it one misreads the event. The sign is
        still the fallback for trades that carry no label at all, and for a
        label this view has no wording for. %>
    <% activity_key = label.presence&.parameterize(separator: "_") %>
    <% named_activity = activity_key.present? && I18n.exists?("trades.header.#{activity_key}") %>
    <span class="text-secondary text-sm">
      <% if named_activity %>
        <%= t(".#{activity_key}") %>
      <% else %>
        <%= entry.amount.positive? ? t(".buy") : t(".sell") %>
      <% end %>
    </span>

    <div class="flex items-center gap-4">
      <h3 class="font-medium">
        <% if reward %>
          <span class="text-2xl text-primary"><%= render "trades/reward_value", value: trade.reward_value %></span>
        <% else %>
          <span class="text-2xl text-primary privacy-sensitive">
            <%= format_money(income_trade ? entry.amount_money.abs : entry.amount_money) %>
          </span>
          <span class="text-lg text-secondary"><%= entry.currency %></span>
        <% end %>
      </h3>

      <% if entry.linked? %>
        <span title="<%= t("transactions.transaction.linked_with_provider", provider: entry.account.provider_name&.titleize) %>">
          <%= icon("refresh-ccw", size: "sm") %>
        </span>
      <% end %>
    </div>

    <span class="text-sm text-secondary">
      <%= entry.date ? I18n.l(entry.date, format: :long) : "—" %>
    </span>
  <% end %>

  <% unless trade.security.cash? %>
    <div class="mb-2">
      <%= render DS::Disclosure.new(title: t(".overview"), open: true) do %>
        <dl class="space-y-3 px-3 pt-2 pb-6">
          <%= render DS::DetailRow.new(label: t(".symbol_label"), value: trade.security.ticker) %>

          <% if reward %>
            <%= render DS::DetailRow.new(label: t(".quantity_received"), value: format_quantity(trade.qty, exact: true), value_class: "privacy-sensitive") %>
            <%= render DS::DetailRow.new(label: t(".price_at_receipt"), value: format_reward_value(trade.reward_unit_price), value_class: "privacy-sensitive") %>
            <%= render DS::DetailRow.new(label: t(".cash_movement"), value: format_money(entry.amount_money), value_class: "privacy-sensitive") %>
          <% elsif trade.buy? %>
            <%= render DS::DetailRow.new(label: t(".purchase_qty_label"), value: trade.qty) %>
            <%= render DS::DetailRow.new(label: t(".purchase_price_label"), value: format_money(trade.price_money), value_class: "privacy-sensitive") %>
          <% end %>

          <% if trade.buy? && (current_price = trade.security.current_price) %>
            <%= render DS::DetailRow.new(label: t(".current_market_price_label"), value: format_money(current_price), value_class: "privacy-sensitive") %>
            <% if (gain_loss = trade.unrealized_gain_loss) %>
              <%= render DS::DetailRow.new(label: t(".total_return_label")) do |row| %>
                <% row.with_value { render "shared/trend_change", trend: gain_loss } %>
              <% end %>
            <% end %>
          <% end %>
        </dl>
      <% end %>
    </div>
  <% end %>
</div>
