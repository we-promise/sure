<%# locals: (category:) %>

<span
      data-color-icon-picker-target="avatar"
      class="w-14 h-14 flex items-center justify-center rounded-full"
      style="--avatar-color: <%= category.color %>; background-color: color-mix(in oklab, var(--avatar-color) 10%, transparent); color: var(--avatar-color)">
  <%= category_icon(category, size: "2xl") %>
</span>
