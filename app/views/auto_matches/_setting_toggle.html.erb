<%# locals: (id:, param:, label:, description:, checked:, submit_value:) %>
<%= render DS::Card.new do %>
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm font-medium text-primary"><%= label %></p>
      <p class="text-xs text-secondary"><%= description %></p>
      <% unless Current.user.admin? %>
        <p class="text-xs text-subdued"><%= t("auto_matches.settings.admin_only") %></p>
      <% end %>
    </div>
    <% toggle = render DS::Toggle.new(
      id: id,
      name: "toggle_display",
      checked: checked,
      disabled: !Current.user.admin?,
      data: { auto_submit_form_target: "auto" }
    ) %>
    <% if Current.user.admin? %>
      <%= form_with url: update_settings_auto_matches_path, method: :patch, data: { turbo_frame: "_top", controller: "auto-submit-form" } do |f| %>
        <%= f.hidden_field param, value: submit_value %>
        <%= toggle %>
      <% end %>
    <% else %>
      <%= toggle %>
    <% end %>
  </div>
<% end %>
