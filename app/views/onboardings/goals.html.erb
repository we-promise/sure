<%= content_for :previous_path, preferences_onboarding_path %>

<%= content_for :header_nav do %>
  <%= render "onboardings/onboarding_nav", user: @user %>
<% end %>

<%= content_for :cancel_action do %>
  <%= render "onboardings/logout" %>
<% end %>

<%= content_for :footer do %>
  <%= render "layouts/shared/footer" %>
<% end %>

<div class="grow max-w-lg w-full mx-auto bg-surface flex flex-col justify-center md:py-0 py-6 px-4 md:px-0">
  <div>
    <div class="space-y-1 mb-6 text-center">
      <h1 class="text-2xl font-medium md:text-2xl"><%= t("onboardings.goals.welcome_title") %></h1>
      <p class="text-secondary text-sm"><%= t("onboardings.goals.welcome_subtitle", product_name: product_name) %></p>
    </div>

    <%= styled_form_with model: @user, data: { controller: "onboarding-choices" } do |form| %>
      <%= form.hidden_field :redirect_to, value: self_hosted? ? "home" : "trial" %>
      <%= form.hidden_field :set_onboarding_goals_at, value: Time.current %>
      <%= form.hidden_field :onboarded_at, value: Time.current %>

      <% if @user.errors.any? %>
        <div class="mb-6">
          <%= render DS::Alert.new(title: t(".errors_title"), variant: :error, live: :alert) do %>
            <ul class="list-disc pl-4">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>

      <div class="space-y-8">
        <section aria-labelledby="starting-point-title" class="space-y-3">
          <h2 id="starting-point-title" class="text-sm font-medium text-secondary"><%= t(".starting_point") %></h2>
          <p class="text-primary font-medium"><%= t(".tools_question") %></p>
          <p class="text-sm text-secondary"><%= t(".tools_description") %></p>
          <%= form.hidden_field :starting_tools, multiple: true, value: "" %>
          <%= render DS::Disclosure.new(title: t(".select_tools"), data: { onboarding_choices_target: "picker" }) do |disclosure| %>
            <% disclosure.with_summary_content do %>
              <span class="text-sm text-primary" data-onboarding-choices-target="summary" data-placeholder="<%= t(".select_tools") %>"><%= t(".select_tools") %></span>
              <%= icon "chevron-down" %>
            <% end %>
            <div class="space-y-3">
              <%= render DS::SearchInput.new(placeholder: t(".search_placeholder"), aria_label: t(".search_label"), data: { action: "input->onboarding-choices#filter" }) %>
              <div class="max-h-64 overflow-y-auto space-y-1">
                <% onboarding_starting_tools.each do |value, label| %>
                  <label class="block rounded-lg p-2 hover:bg-container cursor-pointer" data-onboarding-choices-target="tool" data-label="<%= label %>">
                    <%= form.check_box :starting_tools, { multiple: true, class: "checkbox checkbox--light", data: { action: "change->onboarding-choices#selectTool" }, aria: { controls: value == "other" ? "other-tool-field" : nil } }, value, nil %>
                    <span class="text-sm text-primary"><%= label %></span>
                  </label>
                <% end %>
              </div>
              <p class="text-sm text-secondary" role="status" data-onboarding-choices-target="empty" hidden><%= t(".no_results") %></p>
              <%= render DS::Button.new(text: t(".done"), variant: :secondary, full_width: true, data: { action: "onboarding-choices#closePicker" }) %>
            </div>
          <% end %>
          <%= tag.div id: "other-tool-field", data: { onboarding_choices_target: "other" }, hidden: !Array(@user.starting_tools).include?("other") do %>
            <%= form.text_field :starting_tool_other, label: t(".other_label"), placeholder: t(".other_placeholder"), maxlength: 60 %>
          <% end %>
          <p class="text-xs text-secondary"><%= t(".tools_help") %></p>
        </section>

        <section aria-labelledby="ai-preference-title" class="space-y-3">
          <h2 id="ai-preference-title" class="text-sm font-medium text-secondary"><%= t(".ai_preference") %></h2>
          <fieldset class="space-y-3">
            <legend class="text-primary font-medium"><%= t(".ai_question", product_name: product_name) %></legend>
            <p class="text-sm text-secondary"><%= t(".ai_description") %></p>
            <% onboarding_ai_modes.each do |mode| %>
              <label class="flex items-start gap-3 p-4 rounded-lg border border-primary cursor-pointer hover:bg-container has-[:checked]:bg-container">
                <%= form.radio_button :onboarding_ai_mode, mode, checked: (@user.onboarding_ai_mode.presence || "none") == mode, aria: { expanded: (@user.onboarding_ai_mode.presence || "none") == mode, controls: "ai-panel-#{mode}", describedby: "ai-description-#{mode}" }, data: { action: "change->onboarding-choices#selectMode" } %>
                <span>
                  <span class="block text-sm font-medium text-primary"><%= t(".ai_modes.#{mode}.label") %></span>
                  <span id="ai-description-<%= mode %>" class="block text-sm text-secondary"><%= t(".ai_modes.#{mode}.description") %></span>
                </span>
              </label>
            <% end %>
          </fieldset>
          <% onboarding_ai_modes.each do |mode| %>
            <%= tag.div id: "ai-panel-#{mode}", hidden: (@user.onboarding_ai_mode.presence || "none") != mode, data: { onboarding_choices_target: "panel", mode: mode }, class: "bg-container rounded-lg p-4 space-y-3" do %>
              <h3 class="text-sm font-medium text-primary"><%= t(".ai_modes.#{mode}.title") %></h3>
              <p class="text-sm text-secondary"><%= t(".ai_modes.#{mode}.help") %></p>
              <% if mode == "external" %>
                <div data-controller="onboarding-handoff" data-onboarding-handoff-copied-value="<%= t(".copied") %>" data-onboarding-handoff-fallback-value="<%= t(".copy_fallback") %>" class="space-y-3">
                  <%= label_tag :agent_instructions, t(".agent_instructions_label"), class: "sr-only" %>
                  <%= text_area_tag :agent_instructions, t(".agent_instructions", product_name: product_name), readonly: true, name: nil, rows: 7, class: "form-field__input w-full text-sm focus-ring rounded-md", data: { onboarding_handoff_target: "source" } %>
                  <%= render DS::Button.new(text: t(".copy"), variant: :secondary, data: { action: "onboarding-handoff#copy" }) %>
                  <p role="status" class="text-xs text-secondary" data-onboarding-handoff-target="status"></p>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </section>
      </div>

      <div class="mt-6">
        <%= form.submit t("onboardings.goals.submit") %>
      </div>
    <% end %>
  </div>
</div>
