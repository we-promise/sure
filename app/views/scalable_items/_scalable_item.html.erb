<%# locals: (scalable_item:, visible_accounts:) %>

<% sync_status = BankSyncStatusPresenter.new(item: scalable_item, provider_key: :scalable) %>

<%= tag.div id: dom_id(scalable_item) do %>
  <% can_manage_scalable = Current.user&.admin? && scalable_item.owned_by?(Current.user) &&
    Current.user.preview_features_enabled? && Rails.application.config.app_mode.self_hosted? &&
    !Current.session&.active_impersonator_session_id.present? %>

  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>
          <%= render ProviderLogo.new(provider_key: :scalable) %>
          <div class="min-w-0 pl-1 text-sm">
            <p class="font-medium text-primary"><%= Provider::Metadata.for(:scalable)[:name] %></p>
            <%= render BankSyncStatusComponent.new(presenter: sync_status) %>
          </div>
        </div>

        <% if can_manage_scalable %>
          <div class="flex items-center gap-2">
            <% if scalable_item.ready_for_sync? %>
              <%= render DS::Button.new(
                    text: t("scalable_items.card.sync"),
                    icon: "refresh-cw",
                    variant: :secondary,
                    size: :sm,
                    href: sync_scalable_item_path(scalable_item),
                    disabled: scalable_item.syncing? || !scalable_item.sync_due?
                  ) %>
            <% end %>
            <%= render DS::Menu.new do |menu| %>
              <% menu.with_item(
                variant: "link",
                text: t("scalable_items.card.reconnect"),
                icon: "refresh-cw",
                href: scalable_login_path
              ) %>
              <% if scalable_item.session_configured? %>
                <% menu.with_item(
                  variant: "button",
                  text: t("scalable_items.card.stop_syncing"),
                  icon: "pause",
                  href: scalable_item_path(scalable_item),
                  method: :delete,
                  confirm: t("scalable_items.card.stop_syncing_confirmation")
                ) %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 space-y-3">
      <% if visible_accounts.any? %>
        <%= render "accounts/index/account_groups", accounts: visible_accounts %>
      <% end %>
      <p class="text-xs text-secondary"><%= t("scalable_items.card.snapshot_scope") %></p>
    </div>
  <% end %>
<% end %>
