<%# locals: (purchase:, entry:) %>
<%= button_to purchase_link_path(purchase), params: { entry_id: entry.id }, method: :post, form: { data: { turbo_frame: "_top" } },
      class: "w-full flex items-center justify-between gap-3 px-3 py-3 text-left hover:bg-surface-inset" do %>
  <span class="min-w-0">
    <span class="block text-sm text-primary truncate"><%= entry.name %></span>
    <span class="block text-xs text-secondary truncate"><%= l(entry.date, format: :short_with_year) %> &middot; <%= entry.account.name %></span>
  </span>
  <span class="text-sm text-primary privacy-sensitive shrink-0"><%= format_money(entry.amount_money.abs) %></span>
<% end %>
