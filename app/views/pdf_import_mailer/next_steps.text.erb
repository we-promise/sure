<%= t(".greeting", name: @user.display_name) %>

<%= t(".intro", product: product_name) %>

<%= t(".document_type_label") %>
<%= @document_type ? t("imports.document_types.#{@document_type}") : t("imports.document_types.unknown") %>

<%= t(".summary_label") %>
<%= @summary %>

<% if @document_type.in?(%w[bank_statement credit_card_statement investment_statement]) %>
<%= t(".transactions_note") %>
<% if @failed_checks == %w[balances] %>

<%= t(".unchecked_note") %>
<% elsif @failed_checks.any? %>

<%= t(".review_flag_note") %>
<% end %>
<% else %>
<%= t(".document_stored_note") %>
<% end %>

<%= t(".next_steps_label") %>
<%= t(".next_steps_intro") %>

<% if @document_type.in?(%w[bank_statement credit_card_statement investment_statement]) %>
- <%= t(".option_extract_transactions") %>
<% end %>
- <%= t(".option_keep_reference") %>
- <%= t(".option_delete") %>

<%= t(".view_import_button") %>: <%= @import_url %>

<%= t(".footer_note") %>
