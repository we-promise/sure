<%# We render this in the empty modal frame so if Plaid flow is closed, user stays on same page they were on %>
<%= turbo_frame_tag "modal" do %>
  <%= render "plaid_items/auto_link_opener",
           link_token: @link_token,
           region: @region,
           item_id: "",
           is_update: false,
           accountable_type: params[:accountable_type],
           connected_institution_ids: @connected_institution_ids,
           connected_institution_names: @connected_institution_names %>
<% end %>
