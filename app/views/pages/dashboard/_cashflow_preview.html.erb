<%# locals: (period:) %>
<section id="cashflow-preview" class="mt-6 border-t border-primary pt-4 space-y-4"
  data-controller="sankey-preview"
  data-sankey-preview-survey-id-value="<%= Rails.configuration.x.posthog.sankey_survey_id %>"
  data-action="cash-flow:state->sankey-preview#update posthog:ready@document->sankey-preview#trackDisplay visibilitychange@document->sankey-preview#trackDisplay turbo:before-cache@document->sankey-preview#clear keydown->sankey-preview#stopKeydown">
  <header class="px-4 flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="font-medium text-primary"><%= t("pages.dashboard.cashflow_preview.title") %></h3>
      <%= render DS::Pill.new(label: t("pages.dashboard.cashflow_preview.preview")) %>
    </div>
    <%= render DS::Button.new(icon: "maximize-2", text: t("global.expand"), variant: :ghost, disabled: true,
      data: { action: "sankey-preview#expand", sankey_preview_target: "expandButton" }) %>
  </header>
  <p class="px-4 text-sm text-secondary"><%= t("pages.dashboard.cashflow_preview.description") %></p>
  <div data-controller="cash-flow" data-sankey-preview-target="display" class="ph-no-capture"
    data-action="turbo:before-cache@document->cash-flow#clear"
    data-cash-flow-url-value="<%= api_v1_cash_flow_path(view: "sankey", start_date: period.start_date.iso8601, end_date: period.end_date.iso8601) %>">
    <p data-cash-flow-target="loading" role="status" class="p-4 text-secondary"><%= t("pages.dashboard.cashflow_sankey.loading") %></p>
    <div data-cash-flow-target="error" hidden role="alert" class="p-4 space-y-3">
      <p><%= t("pages.dashboard.cashflow_sankey.load_error") %></p>
      <%= render DS::Button.new(text: t("pages.dashboard.cashflow_sankey.retry"), data: { action: "cash-flow#load" }) %>
    </div>
    <div data-cash-flow-target="content" hidden>
      <div class="w-full h-96 overflow-x-auto overscroll-x-contain" tabindex="0" role="region" aria-label="<%= t("pages.dashboard.cashflow_preview.title") %>"><%= render "pages/dashboard/cashflow_preview_chart", period: period %></div>
      <%= render DS::Dialog.new(id: "cashflow-preview-expanded-dialog", auto_open: false, width: "expanded", disable_frame: true,
        data: { sankey_preview_target: "expandedDialog", action: "close->sankey-preview#restoreDrag" }) do |dialog| %>
        <% dialog.with_header(title: t("pages.dashboard.cashflow_preview.title")) %>
        <% dialog.with_body do %>
          <div class="w-full h-[85dvh] max-h-[90dvh] overflow-auto overscroll-contain" tabindex="0" role="region" aria-label="<%= t("pages.dashboard.cashflow_preview.title") %>">
            <%= render "pages/dashboard/cashflow_preview_chart", period: period %>
          </div>
        <% end %>
      <% end %>
      <p class="px-4 text-xs text-secondary"><%= t("pages.dashboard.cashflow_sankey.basis") %></p>
    </div>
    <p data-cash-flow-target="empty" hidden class="p-4 text-secondary"><%= t("pages.dashboard.cashflow_sankey.no_data_title") %></p>
  </div>
  <div class="px-4 flex flex-wrap items-center gap-2 ph-no-capture">
    <p class="text-sm text-secondary"><%= t("pages.dashboard.cashflow_preview.feedback_prompt") %></p>
    <%= render DS::Button.new(icon: "thumbs-up", text: t("pages.dashboard.cashflow_preview.positive"), variant: :outline,
      data: { action: "sankey-preview#feedback", sankey_preview_rating_param: "positive" }) %>
    <%= render DS::Button.new(icon: "thumbs-down", text: t("pages.dashboard.cashflow_preview.negative"), variant: :outline,
      data: { action: "sankey-preview#feedback", sankey_preview_rating_param: "negative" }) %>
  </div>
  <%= render DS::Dialog.new(id: "cashflow-preview-feedback-dialog", auto_open: false, disable_frame: true,
    data: { sankey_preview_target: "feedbackDialog", action: "close->sankey-preview#dismiss" }) do |dialog| %>
    <% dialog.with_header(title: t("pages.dashboard.cashflow_preview.feedback_title")) %>
    <% dialog.with_body do %>
      <p role="status" data-sankey-preview-target="status"
        data-loading="<%= t("pages.dashboard.cashflow_preview.feedback_loading") %>"
        data-unavailable="<%= t("pages.dashboard.cashflow_preview.feedback_unavailable") %>"
        data-thanks="<%= t("pages.dashboard.cashflow_preview.feedback_thanks") %>"></p>
      <form hidden data-sankey-preview-target="form" data-action="submit->sankey-preview#submit" class="space-y-4 ph-no-capture">
        <label for="cashflow-preview-feedback" class="block text-sm font-medium" data-feedback-question></label>
        <textarea id="cashflow-preview-feedback" name="feedback" rows="4" maxlength="2000"
          aria-describedby="cashflow-preview-feedback-privacy"
          class="w-full rounded-lg border border-primary bg-container text-primary ph-no-capture"></textarea>
        <p id="cashflow-preview-feedback-privacy" class="text-xs text-secondary"><%= t("pages.dashboard.cashflow_preview.feedback_privacy") %></p>
        <%= render DS::Button.new(text: t("pages.dashboard.cashflow_preview.feedback_submit"), type: :submit) %>
      </form>
    <% end %>
  <% end %>
</section>
