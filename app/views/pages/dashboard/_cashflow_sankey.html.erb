<%# locals: (period:) %>
<div id="cashflow-sankey-chart" class="ph-no-capture" data-action="keydown->sankey-visualization#stopKeydown">
  <div data-controller="cash-flow" data-sankey-visualization-target="display" class="ph-no-capture"
    data-action="turbo:before-cache@document->cash-flow#clear"
    data-cash-flow-url-value="<%= dashboard_cash_flow_path(start_date: period.start_date.iso8601, end_date: period.end_date.iso8601) %>">
    <p data-cash-flow-target="loading" role="status" class="p-4 text-secondary"><%= t("pages.dashboard.cashflow_sankey.loading") %></p>
    <div data-cash-flow-target="error" hidden role="alert" class="p-4 space-y-3">
      <p><%= t("pages.dashboard.cashflow_sankey.load_error") %></p>
      <%= render DS::Button.new(text: t("pages.dashboard.cashflow_sankey.retry"), data: { action: "cash-flow#load" }) %>
    </div>
    <div data-cash-flow-target="content" hidden>
      <div class="w-full h-96 overflow-x-auto overscroll-x-contain" tabindex="0" role="region" aria-label="<%= t("pages.dashboard.cashflow_sankey.title") %>"><%= render "pages/dashboard/cashflow_sankey_chart", period: period %></div>
      <%= render DS::Dialog.new(id: "cashflow-sankey-expanded-dialog", auto_open: false, width: "expanded", disable_frame: true,
        data: { sankey_visualization_target: "expandedDialog", action: "close->sankey-visualization#restoreDrag" }) do |dialog| %>
        <% dialog.with_header(title: t("pages.dashboard.cashflow_sankey.title")) %>
        <% dialog.with_body do %>
          <div class="w-full h-[85dvh] max-h-[90dvh] overflow-auto overscroll-contain" tabindex="0" role="region" aria-label="<%= t("pages.dashboard.cashflow_sankey.title") %>">
            <%= render "pages/dashboard/cashflow_sankey_chart", period: period %>
          </div>
        <% end %>
      <% end %>
    </div>
    <p data-cash-flow-target="empty" hidden class="p-4 text-secondary"><%= t("pages.dashboard.cashflow_sankey.no_data_title") %></p>
  </div>
</div>
