<h2 class="mb-5 text-xl text-primary"><%= release_notes[:name] %></h2>
<%# The body is HTML built from a third-party API response. This partial is
    rendered on the changelog page and in the release highlight popup shown
    across the app, so allow-list it rather than trusting that response to be
    clean (CWE-79). %>
<%= sanitize(release_notes[:body] || t(".no_release_notes"),
             tags: %w[h1 h2 h3 h4 h5 h6 p a ul ol li code pre blockquote strong em br img hr div span table thead tbody tr th td dl dt dd sup sub],
             attributes: %w[href src alt class id title dir]) %>
